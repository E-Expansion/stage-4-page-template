{%- doc -%}
  Renders the shared product tile used in product rows and grids (curated products,
  collection grid, related products): image with a tag badge, title, colour swatches
  and/or an option summary, star rating, price, stock status and a cart button.
  Single-variant products are added through the theme's product form; others link to
  the product page to choose options. Which parts show, badges, the low stock threshold
  and status colours come from Theme settings > Product cards.

  Swatches read each colour's swatch (Content > Metaobjects > Color). Hovering, focusing
  or tapping one previews that colour's variant image and points the links at that
  variant (assets/product-tile.js).

  @param {object} [product] - The product to render. A placeholder tile is shown when blank.
  @param {string} section_id - The section ID, used for unique form IDs.
  @param {string} [sizes] - Image sizes attribute, defaults to a four-column row
  @param {boolean} [eager] - Load the image eagerly

  @example
  {% render 'product-tile', product: product, section_id: section.id %}
{%- enddoc -%}

{% liquid
  assign variant = product.selected_or_first_available_variant
  assign image = product.featured_media.preview_image

  if product != blank
    assign title = product.title | escape
  else
    assign title = 'content.product_card_placeholder' | t
  endif

  # The colour option is the first one with swatches, or one named like a colour
  assign color_option = blank
  for option in product.options_with_values
    assign option_name = option.name | downcase
    assign first_value = option.values | first
    if first_value.swatch != blank or option_name == 'color' or option_name == 'colour' or option_name == 'kleur'
      assign color_option = option
      break
    endif
  endfor

  # "Cognac · 3 colours": shown value of the colour (or first) option plus the value count
  assign option_summary = blank
  assign show_summary = false
  assign show_swatches = false
  if product.has_only_default_variant == false
    assign summary_is_color = false
    if color_option != blank
      assign summary_option = color_option
      assign summary_is_color = true
      if settings.product_tile_colors != 'swatches'
        assign show_summary = true
      endif
      if settings.product_tile_colors != 'text'
        assign show_swatches = true
      endif
    else
      assign summary_option = product.options_with_values | first
      assign show_summary = true
    endif

    assign option_summary = summary_option.selected_value | escape
    if summary_option.values.size > 1
      if summary_is_color
        assign option_count = 'content.color_count' | t: count: summary_option.values.size
      else
        assign option_count = 'content.option_count' | t: count: summary_option.values.size
      endif
      assign option_summary = option_summary | append: ' · ' | append: option_count
    endif
  endif

  # Stock status
  assign stock_state = 'in'
  if product != blank and product.available == false
    assign stock_state = 'out'
  elsif variant.inventory_management == 'shopify' and variant.inventory_policy == 'deny' and variant.inventory_quantity > 0 and variant.inventory_quantity <= settings.low_stock_threshold
    assign stock_state = 'low'
  endif

  assign can_add_directly = false
  if product.variants_count == 1 and variant.available
    assign can_add_directly = true
  endif

  assign form_id = 'ProductTileForm-' | append: section_id | append: '-' | append: product.id

  assign image_sizes = sizes | default: '(min-width: 750px) 25vw, 45vw'
  assign image_loading = 'lazy'
  if eager
    assign image_loading = 'eager'
  endif
%}

<li class="product-tile">
  {% if show_swatches %}
    <script
      src="{{ 'product-tile.js' | asset_url }}"
      type="module"
      fetchpriority="low"
    ></script>
  {% endif %}

  <product-tile-component class="product-tile__inner">
    <div class="product-tile__media">
      {% if image != blank %}
        {{
          image
          | image_url: width: 1000
          | image_tag:
            widths: '240, 360, 480, 640, 800, 1000',
            sizes: image_sizes,
            loading: image_loading,
            alt: '',
            class: 'product-tile__image',
            ref: 'image'
        }}
      {% else %}
        {{ 'product-1' | placeholder_svg_tag: 'product-tile__image product-tile__placeholder' }}
      {% endif %}

      {% if settings.product_tile_show_badge %}
        {% render 'tag-badge', tags: product.tags, rules_only: true, class: 'product-tile__badge' %}
      {% endif %}
    </div>

    <div class="product-tile__body">
      <div class="product-tile__head">
        <div class="product-tile__titles">
          <h3 class="product-tile__title">
            <a
              href="{{ product.url | default: '#' }}"
              class="product-tile__link"
              ref="link"
            >
              {{- title -}}
            </a>
          </h3>
          {% if show_summary and option_summary != blank %}
            <p class="product-tile__options">{{ option_summary }}</p>
          {% endif %}

          {% if show_swatches %}
            {% liquid
              assign color_index = color_option.position | minus: 1
              assign swatch_limit = settings.product_tile_max_swatches
              assign hidden_count = color_option.values.size | minus: swatch_limit
            %}
            <div
              class="product-tile__swatches"
              role="group"
              aria-label="{{ color_option.name | escape }}"
              on:pointerenter="/preload"
            >
              {% for value in color_option.values limit: swatch_limit %}
                {% liquid
                  # The variant for this colour and its image; any variant of the colour with an image will do
                  assign value_variant = value.variant
                  assign value_media = value_variant.featured_media
                  if value_media == blank
                    for candidate in product.variants
                      if candidate.options[color_index] == value.name and candidate.featured_media != blank
                        assign value_media = candidate.featured_media
                        break
                      endif
                    endfor
                  endif

                  assign value_srcset = ''
                  if value_media != blank
                    assign srcset_widths = '240,360,480,640,800,1000' | split: ','
                    for width in srcset_widths
                      assign width_url = value_media.preview_image | image_url: width: width
                      assign value_srcset = value_srcset | append: width_url | append: ' ' | append: width | append: 'w'
                      unless forloop.last
                        assign value_srcset = value_srcset | append: ', '
                      endunless
                    endfor
                  endif
                %}
                <button
                  type="button"
                  class="product-tile__swatch"
                  aria-label="{{ value.name | escape }}"
                  aria-pressed="{{ value.selected }}"
                  style="
                    {% if value.swatch.color %}--swatch-color: {{ value.swatch.color }};{% endif %}
                    {% if value.swatch.image %}--swatch-image: url({{ value.swatch.image | image_url: width: 64 }});{% endif %}
                  "
                  {% if value_variant %}
                    data-url="{{ value_variant.url }}"
                  {% endif %}
                  {% if value_media != blank %}
                    data-src="{{ value_media.preview_image | image_url: width: 1000 }}"
                    data-srcset="{{ value_srcset }}"
                  {% endif %}
                  ref="swatches[]"
                  on:pointerenter="/preview"
                  on:focus="/preview"
                  on:click="/preview"
                ></button>
              {% endfor %}
              {% if hidden_count > 0 %}
                <span class="product-tile__swatch-more">+{{ hidden_count }}</span>
              {% endif %}
            </div>
          {% endif %}
        </div>

        {% if product != blank and product.available and settings.product_tile_show_cart %}
          {% capture cart_icon %}
            <span
              class="svg-wrapper"
              aria-hidden="true"
            >
              {{- 'icon-cart.svg' | inline_asset_content -}}
            </span>
          {% endcapture %}

          {% if can_add_directly %}
            <product-form-component
              class="product-tile__form"
              data-section-id="{{ section_id }}"
              data-product-id="{{ product.id }}"
              on:submit="/handleSubmit"
            >
              <span
                class="visually-hidden"
                aria-live="assertive"
                role="status"
                aria-atomic="true"
                ref="liveRegion"
              ></span>
              {%- form 'product', product, id: form_id, novalidate: 'novalidate', data-type: 'add-to-cart-form' -%}
                <input
                  type="hidden"
                  name="id"
                  ref="variantId"
                  value="{{ variant.id }}"
                >
                <input
                  type="hidden"
                  name="quantity"
                  value="{{ variant.quantity_rule.min | default: 1 }}"
                >
                <button
                  type="submit"
                  name="add"
                  class="product-tile__cart button-unstyled"
                  aria-label="{{ 'actions.add_to_cart' | t }}: {{ title }}"
                >
                  {{ cart_icon }}
                </button>
              {%- endform -%}
            </product-form-component>
          {% else %}
            <a
              href="{{ product.url }}"
              class="product-tile__cart"
              aria-label="{{ 'actions.choose' | t }}: {{ title }}"
              ref="cartLink"
            >
              {{ cart_icon }}
            </a>
          {% endif %}
        {% endif %}
      </div>

      {% if settings.product_tile_show_rating %}
        {% render 'star-rating', product: product %}
      {% endif %}

      <div class="product-tile__footer">
        <p class="product-tile__price">
          {% if product.compare_at_price > product.price %}
            <span class="visually-hidden">{{ 'content.price_sale' | t }}</span>
            {{ product.price | money }}
            <s class="product-tile__compare">{{ product.compare_at_price | money }}</s>
          {% elsif product != blank %}
            {{ product.price | money }}
          {% else %}
            {{ 1999 | money }}
          {% endif %}
        </p>

        {% if product != blank and settings.product_tile_show_stock %}
          <p class="product-tile__stock product-tile__stock--{{ stock_state }}">
            {%- case stock_state -%}
              {%- when 'out' -%}
                {{ 'content.inventory_out_of_stock' | t }}
              {%- when 'low' -%}
                {{ 'content.inventory_only_count_left' | t: count: variant.inventory_quantity }}
              {%- else -%}
                {{ 'content.inventory_in_stock' | t }}
            {%- endcase -%}
          </p>
        {% endif %}
      </div>
    </div>
  </product-tile-component>
</li>

{% stylesheet %}
  .product-tile {
    min-width: 0;
  }

  .product-tile__inner {
    position: relative;
    display: flex;
    flex-direction: column;
    height: 100%;
    overflow: hidden;
    background-color: var(--color-background);
    border: var(--style-border-width) solid var(--color-border);
    border-radius: var(--style-border-radius-xs);
  }

  .product-tile__media {
    position: relative;
    aspect-ratio: 1;
    overflow: hidden;
  }

  .product-tile__image {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform var(--animation-speed-slow) var(--animation-easing);
  }

  .product-tile__placeholder {
    background-color: rgb(var(--color-foreground-rgb) / var(--opacity-5));
    fill: rgb(var(--color-foreground-rgb) / var(--opacity-30));
  }

  @media (hover: hover) {
    .product-tile__inner:hover .product-tile__image {
      transform: scale(1.03);
    }
  }

  .product-tile__badge {
    position: absolute;
    inset-block-start: var(--padding-xs);
    inset-inline-end: var(--padding-xs);
  }

  .product-tile__body {
    display: flex;
    flex-direction: column;
    flex-grow: 1;
    gap: var(--gap-xs);
    padding: var(--padding-sm) var(--padding-sm) var(--padding-md);

    @media screen and (min-width: 750px) {
      padding: var(--padding-md) var(--padding-md) var(--padding-md);
    }
  }

  .product-tile__head {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: var(--gap-xs);
  }

  .product-tile__titles {
    display: flex;
    flex-direction: column;
    gap: var(--padding-3xs);
    min-width: 0;
  }

  .product-tile__title {
    margin: 0;
    font-family: var(--font-body--family);
    font-weight: var(--font-body--weight);
    font-size: var(--font-size--sm);
    line-height: var(--line-height--body-tight);

    @media screen and (min-width: 750px) {
      font-size: var(--font-size--md);
    }
  }

  /* Stretched link makes the whole card clickable; the cart button sits above it */
  .product-tile__link {
    color: var(--color-foreground);
    text-decoration: none;
    overflow-wrap: anywhere;

    &::after {
      content: '';
      position: absolute;
      inset: 0;
    }
  }

  .product-tile__options,
  .product-tile__price,
  .product-tile__stock {
    margin: 0;
  }

  .product-tile__options {
    font-size: var(--font-size--2xs);
    color: var(--color-foreground-muted);

    @media screen and (min-width: 750px) {
      font-size: var(--font-size--xs);
    }
  }

  /* Swatches sit above the stretched title link so they stay clickable */
  .product-tile__swatches {
    position: relative;
    z-index: 1;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--gap-2xs);
    margin-block-start: var(--padding-3xs);
  }

  .product-tile__swatch {
    --product-tile-swatch-size: 0.875rem;

    width: var(--product-tile-swatch-size);
    height: var(--product-tile-swatch-size);
    padding: 0;
    background-color: var(--swatch-color, rgb(var(--color-foreground-rgb) / var(--opacity-20)));
    background-image: var(--swatch-image, none);
    background-position: center;
    background-size: cover;
    border: 1px solid rgb(var(--color-foreground-rgb) / var(--opacity-10));
    border-radius: 50%;
    cursor: pointer;
    transition: box-shadow var(--animation-speed) var(--animation-easing);

    @media screen and (min-width: 750px) {
      --product-tile-swatch-size: 1rem;
    }

    /* Ring around the colour that is shown */
    &[aria-pressed='true'] {
      box-shadow: 0 0 0 2px var(--color-background), 0 0 0 3px var(--color-foreground);
    }

    &:focus-visible {
      outline: var(--focus-outline-width) solid var(--color-foreground);
      outline-offset: 3px;
    }
  }

  .product-tile__swatch-more {
    font-size: var(--font-size--2xs);
    color: var(--color-foreground-muted);
  }

  .product-tile__form,
  .product-tile__cart {
    position: relative;
    z-index: 1;
    flex-shrink: 0;
  }

  .product-tile__cart {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2rem;
    height: 2rem;
    border-radius: 50%;
    color: var(--color-primary-button-text);
    background-color: var(--color-primary-button-background);
    transition: background-color var(--animation-speed) var(--animation-easing);

    &:hover {
      color: var(--color-primary-button-hover-text);
      background-color: var(--color-primary-button-hover-background);
    }

    .svg-wrapper,
    svg {
      width: var(--icon-size-xs);
      height: var(--icon-size-xs);
    }

    @media screen and (min-width: 750px) {
      width: 2.25rem;
      height: 2.25rem;
    }
  }

  .product-tile__footer {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--gap-xs);
    margin-block-start: auto;
    padding-block-start: var(--padding-2xs);
    font-size: var(--font-size--xs);

    @media screen and (min-width: 750px) {
      font-size: var(--font-size--sm);
    }
  }

  .product-tile__price {
    color: var(--color-foreground);
  }

  .product-tile__compare {
    margin-inline-start: var(--padding-2xs);
    color: var(--color-foreground-muted);
  }

  .product-tile__stock {
    font-size: var(--font-size--2xs);
    text-align: end;

    @media screen and (min-width: 750px) {
      font-size: var(--font-size--xs);
    }
  }

  .product-tile__stock--in {
    color: var(--color-in-stock);
  }

  .product-tile__stock--low {
    color: var(--color-low-stock);
  }

  .product-tile__stock--out {
    color: var(--color-foreground-muted);
  }

  @media (prefers-reduced-motion: reduce) {
    .product-tile__image {
      transition: none;
    }
  }
{% endstylesheet %}
