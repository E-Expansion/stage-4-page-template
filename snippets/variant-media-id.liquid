{%- doc -%}
  Outputs the ID of the media that shows a variant's colour, or nothing when there is
  none. Used wherever the theme jumps to or previews "the image of this colour".

  Only media in the product's gallery is returned. Shopify's variant image is used when it
  is in the gallery and does not name another colour. Otherwise the first gallery image
  whose alt text or file name mentions the colour wins ("AirPods Case in Cognac",
  "airpods-case-cognac.jpg"), then a gallery image with the same file name. Imports can link
  variants to copies of an image that are not in the gallery; this still finds the slide.

  The colour option is the first one with swatches, or one named like a colour. Products
  without one simply get the variant image.

  @param {object} product - The product
  @param {object} variant - The variant whose image to find

  @example
  {% capture media_id %}{% render 'variant-media-id', product: product, variant: variant %}{% endcapture %}
{%- enddoc -%}

{%- liquid
  # Always returns a media item that is in product.media, so the gallery has a slide for it
  assign variant_media = variant.featured_media
  assign variant_media_id = variant_media.id | append: ''
  assign variant_file = variant_media.preview_image.src | split: '?' | first | split: '/' | last | downcase
  assign color_value = blank

  for candidate_option in product.options_with_values
    assign option_name = candidate_option.name | downcase
    assign first_value = candidate_option.values | first
    if first_value.swatch != blank or option_name == 'color' or option_name == 'colour' or option_name == 'kleur'
      assign color_index = candidate_option.position | minus: 1
      assign color_value = variant.options[color_index] | downcase | strip
      break
    endif
  endfor
  assign color_handle = color_value | handleize

  assign same_id = blank
  assign same_file = blank
  assign color_match = blank

  for media in product.media
    assign media_id = media.id | append: ''
    assign media_alt = media.alt | downcase
    assign media_file = media.preview_image.src | split: '?' | first | split: '/' | last | downcase
    assign mentions_color = false
    if color_value != blank
      if media_alt contains color_value or media_file contains color_handle
        assign mentions_color = true
      endif
    endif

    if media_id == variant_media_id and same_id == blank
      assign same_id = media_id
    endif
    if variant_file != blank and media_file == variant_file and same_file == blank
      assign same_file = media_id
    endif
    if mentions_color and color_match == blank
      assign color_match = media_id
    endif
  endfor

  # 1. The variant's own image, as long as it does not name a different colour
  # 2. The first image that names the colour
  # 3. The same file under another media ID
  assign result_id = color_match
  if same_id != blank
    assign variant_alt = variant_media.alt | downcase
    if color_value == blank or color_match == blank or variant_alt contains color_value or variant_file contains color_handle
      assign result_id = same_id
    endif
  endif
  if result_id == blank
    assign result_id = same_file
  endif
  if result_id == blank
    assign result_id = variant_media_id
  endif

  echo result_id
-%}
