{%- doc -%}
  Renders a compact product card for the curated products section: image with an optional
  tag-driven badge, title, first option summary, review rating, price, stock status and a
  cart button. Single-variant products are added through the theme's product form; others
  link to the product page to choose options.

  Badge, rating and stock colours are read from custom properties set by the section:
  --curated-badge-1-color/-text, --curated-badge-2-color/-text, --curated-rating-color,
  --curated-in-stock-color and --curated-low-stock-color.

  @param {object} [product] - The product to render. A placeholder card is shown when blank.
  @param {string} section_id - The section ID, used for unique form IDs.
  @param {string} [badge_1_tag] - Product tag that shows the first badge
  @param {string} [badge_1_label] - Label of the first badge
  @param {string} [badge_2_tag] - Product tag that shows the second badge
  @param {string} [badge_2_label] - Label of the second badge
  @param {number} [low_stock_threshold] - Show "Only X left" at or below this quantity
  @param {boolean} [eager] - Load the image eagerly

  @example
  {% render 'curated-product-card', product: product, section_id: section.id, badge_1_tag: 'best-seller', badge_1_label: 'Best seller', low_stock_threshold: 5 %}
{%- enddoc -%}

{% liquid
  assign variant = product.selected_or_first_available_variant
  assign image = product.featured_media.preview_image

  if product != blank
    assign title = product.title | escape
  else
    assign title = 'content.product_card_placeholder' | t
  endif

  # Badge from product tags; the first matching badge wins
  assign badge_label = blank
  assign badge_modifier = blank
  if badge_1_tag != blank and product.tags contains badge_1_tag
    assign badge_label = badge_1_label
    assign badge_modifier = 'primary'
  elsif badge_2_tag != blank and product.tags contains badge_2_tag
    assign badge_label = badge_2_label
    assign badge_modifier = 'secondary'
  endif

  # "Cognac · 3 colours": first option value of the shown variant plus the value count
  assign option_summary = blank
  if product.has_only_default_variant == false
    assign first_option = product.options_with_values | first
    assign option_summary = variant.option1 | escape
    if first_option.values.size > 1
      assign option_name = first_option.name | downcase
      if option_name == 'color' or option_name == 'colour' or option_name == 'kleur'
        assign option_count = 'content.color_count' | t: count: first_option.values.size
      else
        assign option_count = 'content.option_count' | t: count: first_option.values.size
      endif
      assign option_summary = option_summary | append: ' · ' | append: option_count
    endif
  endif

  # Reviews use Shopify's standard metafields, filled by review apps
  assign rating = product.metafields.reviews.rating.value
  assign rating_count = product.metafields.reviews.rating_count.value
  if rating != blank
    assign rating_percent = rating.rating | divided_by: rating.scale_max | times: 100
  endif

  # Stock status
  assign stock_state = 'in'
  if product != blank and product.available == false
    assign stock_state = 'out'
  elsif variant.inventory_management == 'shopify' and variant.inventory_policy == 'deny' and variant.inventory_quantity > 0 and variant.inventory_quantity <= low_stock_threshold
    assign stock_state = 'low'
  endif

  assign can_add_directly = false
  if product.variants_count == 1 and variant.available
    assign can_add_directly = true
  endif

  assign form_id = 'CuratedProductForm-' | append: section_id | append: '-' | append: product.id

  assign image_loading = 'lazy'
  if eager
    assign image_loading = 'eager'
  endif
%}

<li class="curated-card">
  <div class="curated-card__inner">
    <div class="curated-card__media">
      {% if image != blank %}
        {{
          image
          | image_url: width: 1000
          | image_tag:
            widths: '240, 360, 480, 640, 800, 1000',
            sizes: '(min-width: 750px) 25vw, 45vw',
            loading: image_loading,
            alt: '',
            class: 'curated-card__image'
        }}
      {% else %}
        {{ 'product-1' | placeholder_svg_tag: 'curated-card__image curated-card__placeholder' }}
      {% endif %}

      {% if badge_label != blank %}
        <span class="curated-card__badge curated-card__badge--{{ badge_modifier }}">{{ badge_label | escape }}</span>
      {% endif %}
    </div>

    <div class="curated-card__body">
      <div class="curated-card__head">
        <div class="curated-card__titles">
          <h3 class="curated-card__title">
            <a
              href="{{ product.url | default: '#' }}"
              class="curated-card__link"
            >
              {{- title -}}
            </a>
          </h3>
          {% if option_summary != blank %}
            <p class="curated-card__options">{{ option_summary }}</p>
          {% endif %}
        </div>

        {% if product != blank and product.available %}
          {% capture cart_icon %}
            <span
              class="svg-wrapper"
              aria-hidden="true"
            >
              {{- 'icon-cart.svg' | inline_asset_content -}}
            </span>
          {% endcapture %}

          {% if can_add_directly %}
            <product-form-component
              class="curated-card__form"
              data-section-id="{{ section_id }}"
              data-product-id="{{ product.id }}"
              on:submit="/handleSubmit"
            >
              <span
                class="visually-hidden"
                aria-live="assertive"
                role="status"
                aria-atomic="true"
                ref="liveRegion"
              ></span>
              {%- form 'product', product, id: form_id, novalidate: 'novalidate', data-type: 'add-to-cart-form' -%}
                <input
                  type="hidden"
                  name="id"
                  ref="variantId"
                  value="{{ variant.id }}"
                >
                <input
                  type="hidden"
                  name="quantity"
                  value="{{ variant.quantity_rule.min | default: 1 }}"
                >
                <button
                  type="submit"
                  name="add"
                  class="curated-card__cart button-unstyled"
                  aria-label="{{ 'actions.add_to_cart' | t }}: {{ title }}"
                >
                  {{ cart_icon }}
                </button>
              {%- endform -%}
            </product-form-component>
          {% else %}
            <a
              href="{{ product.url }}"
              class="curated-card__cart"
              aria-label="{{ 'actions.choose' | t }}: {{ title }}"
            >
              {{ cart_icon }}
            </a>
          {% endif %}
        {% endif %}
      </div>

      {% if rating != blank %}
        <p class="curated-card__rating">
          <span
            class="curated-card__stars"
            style="--curated-rating-percent: {{ rating_percent }}%;"
            aria-hidden="true"
          ></span>
          <span class="visually-hidden">{{ 'accessibility.rating' | t: rating: rating.rating, scale_max: rating.scale_max }}</span>
          <span aria-hidden="true">{{ rating.rating | round: 1 }}</span>
          {% if rating_count != blank %}
            <span class="curated-card__rating-count">({{ rating_count }})</span>
          {% endif %}
        </p>
      {% endif %}

      <div class="curated-card__footer">
        <p class="curated-card__price">
          {% if product.compare_at_price > product.price %}
            <span class="visually-hidden">{{ 'content.price_sale' | t }}</span>
            {{ product.price | money }}
            <s class="curated-card__compare">{{ product.compare_at_price | money }}</s>
          {% elsif product != blank %}
            {{ product.price | money }}
          {% else %}
            {{ 1999 | money }}
          {% endif %}
        </p>

        {% if product != blank %}
          <p class="curated-card__stock curated-card__stock--{{ stock_state }}">
            {%- case stock_state -%}
              {%- when 'out' -%}
                {{ 'content.inventory_out_of_stock' | t }}
              {%- when 'low' -%}
                {{ 'content.inventory_only_count_left' | t: count: variant.inventory_quantity }}
              {%- else -%}
                {{ 'content.inventory_in_stock' | t }}
            {%- endcase -%}
          </p>
        {% endif %}
      </div>
    </div>
  </div>
</li>

{% stylesheet %}
  .curated-card {
    min-width: 0;
    scroll-snap-align: start;
  }

  .curated-card__inner {
    position: relative;
    display: flex;
    flex-direction: column;
    height: 100%;
    overflow: hidden;
    background-color: var(--color-background);
    border: var(--style-border-width) solid var(--color-border);
    border-radius: var(--style-border-radius-xs);
  }

  .curated-card__media {
    position: relative;
    aspect-ratio: 1;
    overflow: hidden;
  }

  .curated-card__image {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform var(--animation-speed-slow) var(--animation-easing);
  }

  .curated-card__placeholder {
    background-color: rgb(var(--color-foreground-rgb) / var(--opacity-5));
    fill: rgb(var(--color-foreground-rgb) / var(--opacity-30));
  }

  @media (hover: hover) {
    .curated-card__inner:hover .curated-card__image {
      transform: scale(1.03);
    }
  }

  .curated-card__badge {
    position: absolute;
    inset-block-start: var(--padding-xs);
    inset-inline-end: var(--padding-xs);
    padding: var(--padding-3xs) var(--padding-xs);
    font-size: var(--font-size--3xs);
    letter-spacing: var(--letter-spacing-sm);
    line-height: 1.4;
    text-transform: uppercase;
    border-radius: var(--style-border-radius-xs);
  }

  .curated-card__badge--primary {
    background-color: var(--curated-badge-1-color, var(--color-foreground));
    color: var(--curated-badge-1-text, var(--color-background));
  }

  .curated-card__badge--secondary {
    background-color: var(--curated-badge-2-color, var(--color-foreground));
    color: var(--curated-badge-2-text, var(--color-background));
  }

  .curated-card__body {
    display: flex;
    flex-direction: column;
    flex-grow: 1;
    gap: var(--gap-xs);
    padding: var(--padding-sm) var(--padding-sm) var(--padding-md);

    @media screen and (min-width: 750px) {
      padding: var(--padding-md) var(--padding-md) var(--padding-md);
    }
  }

  .curated-card__head {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: var(--gap-xs);
  }

  .curated-card__titles {
    display: flex;
    flex-direction: column;
    gap: var(--padding-3xs);
    min-width: 0;
  }

  .curated-card__title {
    margin: 0;
    font-family: var(--font-body--family);
    font-weight: var(--font-body--weight);
    font-size: var(--font-size--sm);
    line-height: var(--line-height--body-tight);

    @media screen and (min-width: 750px) {
      font-size: var(--font-size--md);
    }
  }

  /* Stretched link makes the whole card clickable; the cart button sits above it */
  .curated-card__link {
    color: var(--color-foreground);
    text-decoration: none;
    overflow-wrap: anywhere;

    &::after {
      content: '';
      position: absolute;
      inset: 0;
    }
  }

  .curated-card__options,
  .curated-card__rating,
  .curated-card__price,
  .curated-card__stock {
    margin: 0;
  }

  .curated-card__options {
    font-size: var(--font-size--2xs);
    color: var(--color-foreground-muted);

    @media screen and (min-width: 750px) {
      font-size: var(--font-size--xs);
    }
  }

  .curated-card__form,
  .curated-card__cart {
    position: relative;
    z-index: 1;
    flex-shrink: 0;
  }

  .curated-card__cart {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2rem;
    height: 2rem;
    border-radius: 50%;
    color: var(--color-primary-button-text);
    background-color: var(--color-primary-button-background);
    transition: background-color var(--animation-speed) var(--animation-easing);

    &:hover {
      color: var(--color-primary-button-hover-text);
      background-color: var(--color-primary-button-hover-background);
    }

    .svg-wrapper,
    svg {
      width: var(--icon-size-xs);
      height: var(--icon-size-xs);
    }

    @media screen and (min-width: 750px) {
      width: 2.25rem;
      height: 2.25rem;
    }
  }

  .curated-card__rating {
    display: flex;
    align-items: center;
    gap: var(--gap-xs);
    font-size: var(--font-size--2xs);
    color: var(--color-foreground-muted);

    @media screen and (min-width: 750px) {
      font-size: var(--font-size--xs);
    }
  }

  /* Five stars filled to the rating percentage */
  .curated-card__stars {
    --curated-star: '★★★★★';

    position: relative;
    display: inline-block;
    letter-spacing: 0.1em;
    line-height: 1;

    &::before {
      content: var(--curated-star);
      color: rgb(var(--color-foreground-rgb) / var(--opacity-20));
    }

    &::after {
      content: var(--curated-star);
      position: absolute;
      inset-block-start: 0;
      inset-inline-start: 0;
      width: var(--curated-rating-percent);
      overflow: hidden;
      white-space: nowrap;
      color: var(--curated-rating-color, var(--color-foreground));
    }
  }

  .curated-card__footer {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--gap-xs);
    margin-block-start: auto;
    padding-block-start: var(--padding-2xs);
    font-size: var(--font-size--xs);

    @media screen and (min-width: 750px) {
      font-size: var(--font-size--sm);
    }
  }

  .curated-card__price {
    color: var(--color-foreground);
  }

  .curated-card__compare {
    margin-inline-start: var(--padding-2xs);
    color: var(--color-foreground-muted);
  }

  .curated-card__stock {
    font-size: var(--font-size--2xs);
    text-align: end;

    @media screen and (min-width: 750px) {
      font-size: var(--font-size--xs);
    }
  }

  .curated-card__stock--in {
    color: var(--curated-in-stock-color, var(--color-foreground));
  }

  .curated-card__stock--low {
    color: var(--curated-low-stock-color, var(--color-foreground));
  }

  .curated-card__stock--out {
    color: var(--color-foreground-muted);
  }

  @media (prefers-reduced-motion: reduce) {
    .curated-card__image {
      transition: none;
    }
  }
{% endstylesheet %}
