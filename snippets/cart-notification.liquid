{%- doc -%}
  Renders the "Added to cart" notification that appears at the top right of every page
  when something is added to the cart, from anywhere (product tiles, search results,
  product page, quick add). Shows the item's image, title and variant, a quantity stepper
  and a remove button for that cart line, and "View cart" (opens the cart drawer when there
  is one) and "Check out". Hides after a few seconds, pauses while hovered or focused.
  Skipped when the cart drawer opens for the same add. The border uses the palette's
  border colour (color2), like the product tiles.
  Filled in by assets/cart-notification.js. Rendered once from layout/theme.liquid.

  @example
  {% render 'cart-notification' %}
{%- enddoc -%}

<script
  src="{{ 'cart-notification.js' | asset_url }}"
  type="module"
  fetchpriority="low"
></script>

<cart-notification-component class="cart-notification-host">
  <p
    class="visually-hidden"
    role="status"
    aria-live="polite"
    ref="status"
  ></p>

  <div
    class="cart-notification"
    popover="manual"
    aria-labelledby="CartNotificationHeading"
    style="--cart-notification-border: {{ settings.color_palette.color2 }};"
    ref="panel"
    on:pointerenter="/pause"
    on:pointerleave="/resume"
    on:focus="/pause"
    on:blur="/resume"
  >
    <div class="cart-notification__header">
      <p
        id="CartNotificationHeading"
        class="cart-notification__heading"
      >
        <span
          class="svg-wrapper cart-notification__check"
          aria-hidden="true"
        >
          {{- 'icon-checkmark.svg' | inline_asset_content -}}
        </span>
        {{ 'products.product.added_to_cart' | t }}
      </p>
      <button
        type="button"
        class="cart-notification__close button-unstyled"
        aria-label="{{ 'actions.close' | t }}"
        on:click="/hide"
      >
        <span
          class="svg-wrapper"
          aria-hidden="true"
        >
          {{- 'icon-close.svg' | inline_asset_content -}}
        </span>
      </button>
    </div>

    <div class="cart-notification__item">
      <img
        class="cart-notification__image"
        src="data:,"
        alt=""
        width="64"
        height="64"
        hidden
        ref="image"
      >
      <div class="cart-notification__text">
        <p
          class="cart-notification__title"
          ref="title"
        ></p>
        <p
          class="cart-notification__variant"
          ref="variant"
        ></p>

        <div class="cart-notification__controls">
          <div
            class="cart-notification__quantity"
            role="group"
            aria-label="{{ 'accessibility.quantity' | t }}"
          >
            <button
              type="button"
              class="cart-notification__step button-unstyled"
              aria-label="{{ 'accessibility.decrease_quantity' | t }}"
              ref="decrease"
              on:click="/decrease"
            >
              <span
                class="svg-wrapper"
                aria-hidden="true"
              >
                {{- 'icon-minus.svg' | inline_asset_content -}}
              </span>
            </button>
            <input
              class="cart-notification__input"
              type="number"
              inputmode="numeric"
              min="1"
              value="1"
              aria-label="{{ 'accessibility.quantity' | t }}"
              ref="quantity"
              on:change="/setQuantity"
            >
            <button
              type="button"
              class="cart-notification__step button-unstyled"
              aria-label="{{ 'accessibility.increase_quantity' | t }}"
              on:click="/increase"
            >
              <span
                class="svg-wrapper"
                aria-hidden="true"
              >
                {{- 'icon-plus.svg' | inline_asset_content -}}
              </span>
            </button>
          </div>

          <button
            type="button"
            class="cart-notification__remove button-unstyled"
            on:click="/removeLine"
          >
            <span
              class="svg-wrapper"
              aria-hidden="true"
            >
              {{- 'icon-delete.svg' | inline_asset_content -}}
            </span>
            {{ 'actions.remove' | t }}
          </button>
        </div>
      </div>
    </div>

    <div class="cart-notification__actions">
      <a
        href="{{ routes.cart_url }}"
        class="button-secondary cart-notification__button"
        on:click="/openCart"
      >
        {{- 'content.view_cart' | t -}}
      </a>
      <form
        action="{{ routes.cart_url }}"
        method="post"
        class="cart-notification__checkout"
      >
        <button
          type="submit"
          name="checkout"
          class="button cart-notification__button"
        >
          {{- 'content.checkout' | t -}}
        </button>
      </form>
    </div>
  </div>
</cart-notification-component>

{% stylesheet %}
  .cart-notification {
    position: fixed;
    inset: var(--padding-md) var(--padding-md) auto auto;
    width: min(24rem, calc(100vw - 2 * var(--padding-md)));
    margin: 0;
    padding: var(--padding-lg);
    color: var(--color-foreground);
    background-color: var(--color-background);
    border: var(--style-border-width) solid var(--cart-notification-border, var(--color-border));
    border-radius: var(--style-border-radius-xs);
    box-shadow: var(--shadow-popover);

    @media screen and (min-width: 750px) {
      inset: var(--padding-xl) var(--padding-xl) auto auto;
    }

    &:popover-open {
      display: flex;
      flex-direction: column;
      gap: var(--gap-md);
      animation: cart-notification-in var(--animation-speed-slow) var(--animation-easing);
    }

    &.cart-notification--closing {
      animation: cart-notification-out var(--animation-speed) var(--animation-easing) forwards;
    }
  }

  @keyframes cart-notification-in {
    from {
      opacity: 0;
      translate: 0 calc(var(--padding-md) * -1);
    }
  }

  @keyframes cart-notification-out {
    to {
      opacity: 0;
      translate: 0 calc(var(--padding-md) * -1);
    }
  }

  .cart-notification__header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--gap-sm);
  }

  .cart-notification__heading {
    display: flex;
    align-items: center;
    gap: var(--gap-xs);
    margin: 0;
    font-weight: 600;
  }

  .cart-notification__check {
    width: var(--icon-size-sm);
    height: var(--icon-size-sm);
    color: var(--color-in-stock);
  }

  .cart-notification__close {
    display: inline-flex;
    width: var(--icon-size-md);
    height: var(--icon-size-md);
    color: var(--color-foreground-muted);

    &:hover {
      color: var(--color-foreground);
    }
  }

  .cart-notification__item {
    display: flex;
    align-items: flex-start;
    gap: var(--gap-md);
  }

  .cart-notification__image {
    flex-shrink: 0;
    width: 4rem;
    height: 4rem;
    object-fit: cover;
    border-radius: var(--style-border-radius-xs);
  }

  .cart-notification__text {
    display: flex;
    flex-direction: column;
    gap: var(--padding-3xs);
    flex-grow: 1;
    min-width: 0;
  }

  .cart-notification__controls {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--gap-sm);
    margin-block-start: var(--padding-xs);
  }

  /* Stepper with the same border as the notification and the product tiles */
  .cart-notification__quantity {
    display: inline-flex;
    align-items: stretch;
    border: var(--style-border-width) solid var(--cart-notification-border, var(--color-border));
    border-radius: var(--style-border-radius-xs);
  }

  .cart-notification__step {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2rem;
    height: 2rem;
    color: var(--color-foreground);
    background-color: transparent;

    .svg-wrapper,
    svg {
      width: var(--icon-size-xs);
      height: var(--icon-size-xs);
    }

    &:disabled {
      opacity: 0.35;
      cursor: not-allowed;
    }
  }

  .cart-notification__input {
    width: 2.25rem;
    padding: 0;
    font-size: var(--font-size--sm);
    text-align: center;
    color: var(--color-foreground);
    background: transparent;
    border: 0;
    appearance: textfield;
    -moz-appearance: textfield;

    &::-webkit-inner-spin-button,
    &::-webkit-outer-spin-button {
      margin: 0;
      -webkit-appearance: none;
    }
  }

  .cart-notification__remove {
    display: inline-flex;
    align-items: center;
    gap: var(--gap-2xs);
    font-size: var(--font-size--xs);
    color: var(--color-foreground-muted);
    background-color: transparent;
    text-decoration: underline;
    text-underline-offset: 0.2em;

    .svg-wrapper,
    svg {
      width: var(--icon-size-xs);
      height: var(--icon-size-xs);
    }

    &:hover {
      color: var(--color-foreground);
    }
  }

  cart-notification-component[busy] :is(.cart-notification__quantity, .cart-notification__remove) {
    opacity: 0.5;
    pointer-events: none;
  }

  .cart-notification__title,
  .cart-notification__variant {
    margin: 0;
    overflow-wrap: anywhere;
  }

  .cart-notification__variant {
    font-size: var(--font-size--xs);
    color: var(--color-foreground-muted);

    &:empty {
      display: none;
    }
  }

  .cart-notification__actions {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--gap-sm);
  }

  .cart-notification__checkout {
    display: contents;
  }

  /* Compact buttons: smaller than the theme's default button size */
  .cart-notification .cart-notification__button {
    --button-padding-block: var(--padding-xs);
    --button-padding-inline: var(--padding-sm);

    justify-content: center;
    width: 100%;
    min-height: 0;
    font-size: var(--font-size--xs);
    text-align: center;
  }

  @media (prefers-reduced-motion: reduce) {
    .cart-notification:popover-open,
    .cart-notification.cart-notification--closing {
      animation: none;
    }
  }
{% endstylesheet %}
