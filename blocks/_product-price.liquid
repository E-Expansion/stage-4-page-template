{% doc %}
  Renders the selected variant's price (with compare-at and unit price) beside a short
  price description such as tax and shipping terms, and an optional lowest price guarantee
  line below it.

  @example
  {% content_for 'blocks' %}
{% enddoc %}

<div
  class="product-price"
  {{ block.shopify_attributes }}
>
  <div class="product-price__row">
    <div class="product-price__amount">
      {% render 'price', product_resource: product, show_unit_price: true %}
    </div>

    {% if block.settings.description != blank %}
      <p class="product-price__description">{{ block.settings.description }}</p>
    {% endif %}
  </div>

  {% if block.settings.show_guarantee and block.settings.guarantee_text != blank %}
    <p
      class="product-price__guarantee"
      style="--product-price-guarantee-color: {{ block.settings.guarantee_color }};"
    >
      <svg
        class="product-price__guarantee-icon"
        xmlns="http://www.w3.org/2000/svg"
        width="20"
        height="20"
        viewBox="0 0 20 20"
        aria-hidden="true"
      >
        {%- render 'icon', icon: 'shield' -%}
      </svg>
      <span>{{ block.settings.guarantee_text }}</span>
    </p>
  {% endif %}
</div>

{% stylesheet %}
  .product-price {
    display: flex;
    flex-direction: column;
    gap: var(--gap-sm);
  }

  .product-price__row {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: var(--gap-2xs) var(--gap-sm);
  }

  .product-price__amount {
    font-size: var(--font-size--xl);

    @media screen and (min-width: 750px) {
      font-size: var(--font-size--2xl);
    }

    .price-item__group + .price-item__group {
      margin-inline-start: var(--gap-xs);
    }

    .unit-price {
      margin-block-start: var(--gap-3xs);
    }
  }

  .product-price__description {
    margin: 0;
    font-size: var(--font-size--xs);
    color: var(--color-foreground-muted);
  }

  .product-price__guarantee {
    display: flex;
    align-items: flex-start;
    gap: var(--gap-xs);
    margin: 0;
    font-size: var(--font-size--sm);
    line-height: var(--line-height--body-normal);
    color: var(--product-price-guarantee-color, var(--color-foreground));
  }

  .product-price__guarantee-icon {
    flex-shrink: 0;
    width: 1.25em;
    height: 1.25em;
    margin-block-start: 0.1em;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:names.product_price",
  "tag": null,
  "settings": [
    {
      "type": "inline_richtext",
      "id": "description",
      "label": "t:settings.price_description",
      "default": "Incl. VAT · shipping calculated at checkout, free over €75"
    },
    {
      "type": "checkbox",
      "id": "show_guarantee",
      "label": "t:settings.show_lowest_price_guarantee",
      "default": true
    },
    {
      "type": "inline_richtext",
      "id": "guarantee_text",
      "label": "t:settings.lowest_price_guarantee_text",
      "default": "Lowest price guarantee: found it cheaper elsewhere within 30 days? We'll match the price.",
      "visible_if": "{{ block.settings.show_guarantee }}"
    },
    {
      "type": "color",
      "id": "guarantee_color",
      "label": "t:settings.accent_color",
      "default": "{{ settings.color_palette.color3 }}",
      "visible_if": "{{ block.settings.show_guarantee }}"
    }
  ],
  "presets": [
    {
      "name": "t:names.product_price"
    }
  ]
}
{% endschema %}
