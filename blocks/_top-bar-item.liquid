{% doc %}
  Renders a single info item (e.g. returns policy, support hours) in the top bar.
  Hidden on mobile by the parent section.

  @example
  {% content_for 'blocks' %}
{% enddoc %}

{% if block.settings.text != blank %}
  <li
    class="top-bar__item"
    {{ block.shopify_attributes }}
  >
    {% if block.settings.link != blank %}
      <a
        class="top-bar__link"
        href="{{ block.settings.link }}"
      >
        {{- block.settings.text | escape -}}
      </a>
    {% else %}
      {{- block.settings.text | escape -}}
    {% endif %}
  </li>
{% endif %}

{% stylesheet %}
  .top-bar__item {
    white-space: nowrap;
  }

  .top-bar__link {
    color: inherit;
    text-decoration: none;

    &:hover {
      text-decoration: underline;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:names.top_bar_item",
  "tag": null,
  "settings": [
    {
      "type": "text",
      "id": "text",
      "label": "t:settings.text",
      "default": "30-day free returns"
    },
    {
      "type": "url",
      "id": "link",
      "label": "t:settings.link"
    }
  ]
}
{% endschema %}
