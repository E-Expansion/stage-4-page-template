{% doc %}
  Renders the "Notify me when back in stock" card when the selected variant is sold out:
  a heading, a short text and an email field. Uses Shopify's customer form, so each request
  becomes a customer with email marketing consent, tagged "back-in-stock" plus one tag for
  the product and variant (e.g. "back-in-stock-weekday-satchel-sand-medium"). The merchant
  finds them under Customers and emails them when stock returns. After submitting, the
  thank-you message shows even if the reloaded page selects an available variant.

  @example
  {% content_for 'blocks' %}
{% enddoc %}

{% liquid
  assign variant = product.selected_or_first_available_variant
  assign form_id = 'BackInStock-' | append: block.id
  assign input_id = 'BackInStockEmail-' | append: block.id

  assign variant_tag = 'back-in-stock-' | append: product.handle
  unless product.has_only_default_variant
    assign variant_handle = variant.title | handleize
    assign variant_tag = variant_tag | append: '-' | append: variant_handle
  endunless
  assign tags = 'back-in-stock, ' | append: variant_tag

  if block.settings.button_color != blank
    assign button_brightness = block.settings.button_color | color_brightness
    if button_brightness > 128
      assign button_text = 'var(--palette-darkest)'
    else
      assign button_text = 'var(--palette-lightest)'
    endif
    capture button_hover
      render 'util-palette-hover-shift', color: block.settings.button_color
    endcapture
  endif
%}

<div
  class="back-in-stock-block"
  {{ block.shopify_attributes }}
>
  {%- form 'customer', id: form_id, class: 'back-in-stock' -%}
    {% if form.posted_successfully? %}
      <div
        class="back-in-stock__card back-in-stock__success"
        role="status"
        tabindex="-1"
        autofocus
      >
        <span
          class="svg-wrapper back-in-stock__icon"
          aria-hidden="true"
        >
          {{- 'icon-checkmark.svg' | inline_asset_content -}}
        </span>
        <p class="back-in-stock__text">{{ block.settings.success_text | escape }}</p>
      </div>
    {% elsif variant.available == false %}
      <input
        type="hidden"
        name="contact[tags]"
        value="{{ tags | escape }}"
      >
      <input
        type="hidden"
        name="contact[accepts_marketing]"
        value="true"
      >

      <div class="back-in-stock__card">
        <p class="back-in-stock__heading">
          <span
            class="svg-wrapper back-in-stock__icon"
            aria-hidden="true"
          >
            {{- 'icon-bell.svg' | inline_asset_content -}}
          </span>
          {{ block.settings.heading | escape }}
        </p>

        {% if block.settings.text != blank %}
          <p class="back-in-stock__text">{{ block.settings.text | escape }}</p>
        {% endif %}

        <div class="back-in-stock__fields">
          <label
            for="{{ input_id }}"
            class="visually-hidden"
          >
            {{- 'blocks.email_signup.label' | t -}}
          </label>
          <input
            id="{{ input_id }}"
            class="back-in-stock__input"
            type="email"
            name="contact[email]"
            autocorrect="off"
            autocapitalize="off"
            autocomplete="email"
            placeholder="{{ block.settings.placeholder | escape }}"
            required
            {% if form.errors %}
              autofocus
              aria-invalid="true"
              aria-describedby="{{ form_id }}-error"
            {% endif %}
          >
          <button
            type="submit"
            class="button back-in-stock__button"
            {% if block.settings.button_color != blank %}
              style="
                --color-primary-button-background: {{ block.settings.button_color }};
                --color-primary-button-border: {{ block.settings.button_color }};
                --color-primary-button-text: {{ button_text }};
                --color-primary-button-hover-background: {{ button_hover | strip }};
                --color-primary-button-hover-border: {{ button_hover | strip }};
                --color-primary-button-hover-text: {{ button_text }};
              "
            {% endif %}
          >
            {{- block.settings.button_label | escape -}}
          </button>
        </div>

        {% if form.errors %}
          <p
            id="{{ form_id }}-error"
            class="back-in-stock__error"
          >
            {{- form.errors.translated_fields.email | capitalize }}
            {{ form.errors.messages.email -}}
          </p>
        {% endif %}
      </div>
    {% endif %}
  {%- endform -%}
</div>

{% stylesheet %}
  /* Nothing to show while the variant is in stock */
  .back-in-stock-block:not(:has(.back-in-stock__card)) {
    display: none;
  }

  .back-in-stock {
    margin: 0;
  }

  .back-in-stock__card {
    display: flex;
    flex-direction: column;
    gap: var(--gap-sm);
    padding: var(--padding-md) var(--padding-lg);
    border: var(--style-border-width) solid var(--color-border);
    border-radius: var(--style-border-radius-xs);
  }

  .back-in-stock__heading {
    display: flex;
    align-items: center;
    gap: var(--gap-xs);
    margin: 0;
    font-size: var(--font-size--sm);
  }

  .back-in-stock__icon {
    flex-shrink: 0;
    width: var(--icon-size-sm);
    height: var(--icon-size-sm);
  }

  .back-in-stock__text {
    margin: 0;
    font-size: var(--font-size--xs);
    line-height: var(--line-height--body-normal);
    color: var(--color-foreground-muted);
  }

  .back-in-stock__success {
    flex-direction: row;
    align-items: center;

    .back-in-stock__text {
      color: var(--color-foreground);
    }
  }

  .back-in-stock__fields {
    display: flex;
    gap: var(--gap-xs);
  }

  .back-in-stock__input {
    flex: 1;
    min-width: 0;
    min-height: var(--minimum-touch-target);
    padding-inline: var(--padding-sm);
    font: inherit;
    font-size: var(--font-size--sm);
    color: var(--color-foreground);
    background-color: var(--color-background);
    border: var(--style-border-width) solid var(--color-border);
    border-radius: var(--style-border-radius-inputs);
  }

  .back-in-stock__button {
    flex-shrink: 0;
    min-height: var(--minimum-touch-target);
  }

  .back-in-stock__error {
    margin: 0;
    font-size: var(--font-size--xs);
    color: var(--color-error);
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:names.back_in_stock",
  "tag": null,
  "settings": [
    {
      "type": "paragraph",
      "content": "t:info.back_in_stock"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "t:settings.heading",
      "default": "Notify me when back in stock"
    },
    {
      "type": "text",
      "id": "text",
      "label": "t:settings.text",
      "default": "Leave your email and we'll let you know the moment this item is available again. No spam, unsubscribe any time."
    },
    {
      "type": "text",
      "id": "placeholder",
      "label": "t:settings.placeholder",
      "default": "your@email.com"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "t:settings.button_label",
      "default": "Notify me"
    },
    {
      "type": "text",
      "id": "success_text",
      "label": "t:settings.success_message",
      "default": "Thanks! We'll email you as soon as it's back in stock."
    },
    {
      "type": "color",
      "id": "button_color",
      "label": "t:settings.button_color",
      "default": "{{ settings.color_palette.color1 }}"
    }
  ],
  "presets": [
    {
      "name": "t:names.back_in_stock"
    }
  ]
}
{% endschema %}
