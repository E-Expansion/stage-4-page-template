{% doc %}
  Renders the same-day shipping card: a stock line ("In stock | Order in time and it ships
  today"), a heading with a short text, and a countdown to the next order cut-off. The
  cut-off time and shipping weekdays are block settings, in the shop's time zone. After the
  cut-off, or on a day without shipping, the countdown runs to the next shipping day and the
  line reads "ships tomorrow" or "ships Monday". Hidden when the selected variant is sold out.
  Behaviour lives in assets/shipping-countdown.js.

  @example
  {% content_for 'blocks' %}
{% enddoc %}

{% liquid
  assign variant = product.selected_or_first_available_variant

  # Weekdays as JavaScript numbers (0 = Sunday)
  assign ship_days = ''
  if block.settings.ship_sunday
    assign ship_days = ship_days | append: '0,'
  endif
  if block.settings.ship_monday
    assign ship_days = ship_days | append: '1,'
  endif
  if block.settings.ship_tuesday
    assign ship_days = ship_days | append: '2,'
  endif
  if block.settings.ship_wednesday
    assign ship_days = ship_days | append: '3,'
  endif
  if block.settings.ship_thursday
    assign ship_days = ship_days | append: '4,'
  endif
  if block.settings.ship_friday
    assign ship_days = ship_days | append: '5,'
  endif
  if block.settings.ship_saturday
    assign ship_days = ship_days | append: '6,'
  endif
%}

{% if variant.available and ship_days != blank %}
  <script
    src="{{ 'shipping-countdown.js' | asset_url }}"
    type="module"
    fetchpriority="low"
  ></script>

  <shipping-countdown-component
    class="shipping-countdown"
    data-cutoff-hour="{{ block.settings.cutoff_hour }}"
    data-cutoff-minute="{{ block.settings.cutoff_minute }}"
    data-ship-days="{{ ship_days }}"
    data-utc-offset="{{ 'now' | date: '%z' }}"
    data-today-text="{{ block.settings.status_text | escape }}"
    data-tomorrow-text="{{ 'content.ships_tomorrow' | t | escape }}"
    data-day-text="{{ 'content.ships_on_day' | t: day: '[day]' | escape }}"
    {% if block.settings.accent_color != blank %}
      style="--shipping-countdown-accent: {{ block.settings.accent_color }};"
    {% endif %}
    {{ block.shopify_attributes }}
  >
    <p class="shipping-countdown__status">
      <span class="shipping-countdown__stock">{{ 'content.inventory_in_stock' | t }}</span>
      <span
        class="shipping-countdown__when"
        ref="status"
      >
        {{- block.settings.status_text | escape -}}
      </span>
    </p>

    <div class="shipping-countdown__body">
      <div class="shipping-countdown__intro">
        {% if block.settings.heading != blank %}
          <p class="shipping-countdown__heading">{{ block.settings.heading | escape }}</p>
        {% endif %}
        {% if block.settings.text != blank %}
          <p class="shipping-countdown__text">{{ block.settings.text | escape }}</p>
        {% endif %}
      </div>

      <div
        class="shipping-countdown__timer"
        role="timer"
        aria-live="off"
      >
        <span class="shipping-countdown__unit">
          <span
            class="shipping-countdown__value"
            ref="hours"
            >--</span
          >
          <span class="shipping-countdown__label">{{ 'content.countdown_hours' | t }}</span>
        </span>
        <span
          class="shipping-countdown__separator"
          aria-hidden="true"
          >:</span
        >
        <span class="shipping-countdown__unit">
          <span
            class="shipping-countdown__value"
            ref="minutes"
            >--</span
          >
          <span class="shipping-countdown__label">{{ 'content.countdown_minutes' | t }}</span>
        </span>
        <span
          class="shipping-countdown__separator"
          aria-hidden="true"
          >:</span
        >
        <span class="shipping-countdown__unit">
          <span
            class="shipping-countdown__value"
            ref="seconds"
            >--</span
          >
          <span class="shipping-countdown__label">{{ 'content.countdown_seconds' | t }}</span>
        </span>
      </div>
    </div>
  </shipping-countdown-component>
{% endif %}

{% stylesheet %}
  .shipping-countdown {
    --shipping-countdown-color: var(--shipping-countdown-accent, var(--color-in-stock));

    display: block;
    overflow: hidden;
    background-color: color-mix(in srgb, var(--shipping-countdown-color) 6%, var(--color-background));
    border: var(--style-border-width) solid
      color-mix(in srgb, var(--shipping-countdown-color) 25%, var(--color-background));
    border-radius: var(--style-border-radius-xs);
  }

  .shipping-countdown__status {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--gap-2xs) var(--gap-sm);
    margin: 0;
    padding: var(--padding-sm) var(--padding-md);
    font-size: var(--font-size--xs);
    color: var(--shipping-countdown-color);
    border-block-end: var(--style-border-width) solid
      color-mix(in srgb, var(--shipping-countdown-color) 25%, var(--color-background));
  }

  .shipping-countdown__stock {
    display: inline-flex;
    align-items: center;
    gap: var(--gap-2xs);

    &::before {
      content: '';
      width: 0.5em;
      height: 0.5em;
      background-color: currentcolor;
      border-radius: 50%;
    }
  }

  .shipping-countdown__when {
    padding-inline-start: var(--gap-sm);
    border-inline-start: var(--style-border-width) solid
      color-mix(in srgb, var(--shipping-countdown-color) 35%, var(--color-background));
  }

  .shipping-countdown__body {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--gap-md);
    padding: var(--padding-md);
  }

  .shipping-countdown__intro {
    flex: 1 1 12rem;
    display: flex;
    flex-direction: column;
    gap: var(--gap-2xs);
  }

  .shipping-countdown__heading {
    margin: 0;
    font-size: var(--font-size--lg);
    color: var(--color-foreground);
  }

  .shipping-countdown__text {
    margin: 0;
    font-size: var(--font-size--xs);
    color: var(--shipping-countdown-color);
  }

  .shipping-countdown__timer {
    display: flex;
    align-items: flex-start;
    gap: var(--gap-2xs);
    color: var(--color-foreground);
  }

  .shipping-countdown__unit {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--gap-3xs);
  }

  .shipping-countdown__value,
  .shipping-countdown__separator {
    font-size: var(--font-size--2xl);
    line-height: 1;
    font-variant-numeric: tabular-nums;
  }

  .shipping-countdown__separator {
    color: var(--color-foreground-muted);
  }

  .shipping-countdown__label {
    font-size: var(--font-size--3xs);
    letter-spacing: var(--letter-spacing--body-loose);
    text-transform: uppercase;
    color: var(--color-foreground-muted);
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:names.same_day_shipping",
  "tag": null,
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "t:settings.heading",
      "default": "Same-day shipping"
    },
    {
      "type": "text",
      "id": "text",
      "label": "t:settings.text",
      "default": "Complete your order before the timer runs out."
    },
    {
      "type": "text",
      "id": "status_text",
      "label": "t:settings.ships_today_text",
      "default": "Order in time and it ships today"
    },
    {
      "type": "header",
      "content": "t:content.order_cutoff"
    },
    {
      "type": "paragraph",
      "content": "t:info.order_cutoff"
    },
    {
      "type": "range",
      "id": "cutoff_hour",
      "label": "t:settings.cutoff_hour",
      "min": 0,
      "max": 23,
      "step": 1,
      "default": 16
    },
    {
      "type": "range",
      "id": "cutoff_minute",
      "label": "t:settings.cutoff_minute",
      "min": 0,
      "max": 55,
      "step": 5,
      "default": 0
    },
    {
      "type": "checkbox",
      "id": "ship_monday",
      "label": "t:settings.monday",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "ship_tuesday",
      "label": "t:settings.tuesday",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "ship_wednesday",
      "label": "t:settings.wednesday",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "ship_thursday",
      "label": "t:settings.thursday",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "ship_friday",
      "label": "t:settings.friday",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "ship_saturday",
      "label": "t:settings.saturday",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "ship_sunday",
      "label": "t:settings.sunday",
      "default": false
    },
    {
      "type": "header",
      "content": "t:content.appearance"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "t:settings.accent_color",
      "info": "t:info.shipping_countdown_color"
    }
  ],
  "presets": [
    {
      "name": "t:names.same_day_shipping"
    }
  ]
}
{% endschema %}
