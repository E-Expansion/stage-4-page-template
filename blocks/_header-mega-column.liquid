{% doc %}
  Renders one manually built mega menu column: an optional heading followed by its link
  blocks. Markup lives in snippets/header-mega-column.liquid. Only used when the parent
  menu item has no collection with subcategories.

  @example
  {% content_for 'blocks' %}
{% enddoc %}

{% liquid
  capture links
    content_for 'blocks'
  endcapture
  assign heading = block.settings.heading | escape
  render 'header-mega-column', heading: heading, url: block.settings.link, links: links, attributes: block.shopify_attributes
%}

{% schema %}
{
  "name": "t:names.menu_column",
  "tag": null,
  "blocks": [
    {
      "type": "_header-mega-link"
    }
  ],
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "t:settings.heading",
      "default": "Column"
    },
    {
      "type": "url",
      "id": "link",
      "label": "t:settings.link"
    }
  ],
  "presets": [
    {
      "name": "t:names.menu_column"
    }
  ]
}
{% endschema %}
