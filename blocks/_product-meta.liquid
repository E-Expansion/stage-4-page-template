{% doc %}
  Renders the row under the product title: the review rating, then the "sold this week"
  and stock labels (snippets/product-meta-row.liquid). Each part can be switched off.

  @example
  {% content_for 'blocks' %}
{% enddoc %}

{% render 'product-meta-row',
  product: product,
  show_rating: block.settings.show_rating,
  show_sold_this_week: block.settings.show_sold_this_week,
  show_stock: block.settings.show_stock,
  in_stock_note: block.settings.in_stock_note,
  attributes: block.shopify_attributes
%}

{% schema %}
{
  "name": "t:names.product_rating_stock",
  "tag": null,
  "settings": [
    {
      "type": "checkbox",
      "id": "show_rating",
      "label": "t:settings.product_tile_show_rating",
      "info": "t:info.product_rating_placeholder",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_sold_this_week",
      "label": "t:settings.show_sold_this_week",
      "info": "t:info.sold_this_week",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_stock",
      "label": "t:settings.product_tile_show_stock",
      "default": true
    },
    {
      "type": "text",
      "id": "in_stock_note",
      "label": "t:settings.in_stock_note",
      "default": "ships today",
      "visible_if": "{{ block.settings.show_stock }}"
    }
  ],
  "presets": [
    {
      "name": "t:names.product_rating_stock"
    }
  ]
}
{% endschema %}
