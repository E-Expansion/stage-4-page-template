{% doc %}
  One manually filled quantity tier of the "Buy more, pay less" card. Only used when the
  product has no tiers in its custom.volume_tiers metafield (see
  blocks/_product-volume-pricing.liquid). Markup and styles live in
  snippets/volume-tier.liquid.

  @example
  {% content_for 'blocks' %}
{% enddoc %}

{% render 'volume-tier',
  product: product,
  id: block.id,
  section_id: section.id,
  label: block.settings.label,
  quantity: block.settings.quantity,
  discount: block.settings.discount,
  attributes: block.shopify_attributes
%}

{% schema %}
{
  "name": "t:names.volume_tier",
  "tag": null,
  "settings": [
    {
      "type": "text",
      "id": "label",
      "label": "t:settings.label",
      "default": "Two - mix any colour"
    },
    {
      "type": "range",
      "id": "quantity",
      "label": "t:settings.tier_quantity",
      "min": 1,
      "max": 20,
      "step": 1,
      "default": 2
    },
    {
      "type": "range",
      "id": "discount",
      "label": "t:settings.discount_percent",
      "min": 0,
      "max": 90,
      "step": 1,
      "unit": "%",
      "default": 7
    }
  ],
  "presets": [
    {
      "name": "t:names.volume_tier"
    }
  ]
}
{% endschema %}
