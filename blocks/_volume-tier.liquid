{% doc %}
  Renders one quantity tier inside the "Buy more, pay less" card: a radio that sets the
  buy form's quantity, the label, the selected variant's price minus the tier discount
  ("€175.00 each") and a "Save 7%" badge. The tier with quantity 1 starts selected.

  @example
  {% content_for 'blocks' %}
{% enddoc %}

{% liquid
  assign variant = product.selected_or_first_available_variant
  assign quantity = block.settings.quantity
  assign discount = block.settings.discount
  assign price_factor = 100 | minus: discount
  assign tier_price = variant.price | times: price_factor | divided_by: 100

  if settings.currency_code_enabled_product_pages
    assign tier_price = tier_price | money_with_currency
  else
    assign tier_price = tier_price | money
  endif

  # Links the radio to the buy block's form, so its value is sent as the quantity
  assign form_id = 'ProductBuyForm-' | append: section.id
  assign input_id = 'VolumeTier-' | append: block.id
%}

<label
  class="volume-tier"
  for="{{ input_id }}"
  {{ block.shopify_attributes }}
>
  <input
    type="radio"
    class="volume-tier__input"
    id="{{ input_id }}"
    name="quantity"
    value="{{ quantity }}"
    form="{{ form_id }}"
    data-keep-checked
    {% if quantity == 1 %}
      checked
    {% endif %}
  >
  <span class="volume-tier__label">{{ block.settings.label | escape }}</span>
  <span class="volume-tier__price">{{ 'content.price_each' | t: price: tier_price }}</span>
  <span class="volume-tier__badge-slot">
    {% if discount > 0 %}
      <span class="volume-tier__badge">{{ 'content.save_percent' | t: percent: discount }}</span>
    {% endif %}
  </span>
</label>

{% stylesheet %}
  /* Each tier spans the card's grid so prices and badges line up across rows. Scoped to the
     card so it outranks base.css's label:has(input) inline-flex rule */
  .volume-pricing .volume-tier {
    display: grid;
    grid-column: 1 / -1;
    grid-template-columns: subgrid;
    align-items: center;
    font-size: var(--font-size--sm);
    cursor: pointer;
  }

  /* Theme radio (base.css), in the card's accent color */
  .volume-tier__input {
    margin: 0;

    &:checked {
      border-color: var(--volume-accent, var(--color-foreground));
    }

    &:checked::after {
      background: var(--volume-accent, var(--color-foreground));
    }
  }

  .volume-tier__price {
    justify-self: end;
    text-align: end;
    color: var(--color-foreground-muted);
    white-space: nowrap;
  }

  .volume-tier__badge-slot {
    display: flex;
    justify-content: flex-end;
  }

  .volume-tier__badge {
    padding: var(--padding-3xs) var(--padding-xs);
    font-size: var(--font-size--2xs);
    line-height: 1;
    white-space: nowrap;
    color: var(--volume-badge-text, var(--color-background));
    background-color: var(--volume-badge-background, var(--color-foreground));
    border-radius: var(--style-border-radius-xs);
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:names.volume_tier",
  "tag": null,
  "settings": [
    {
      "type": "text",
      "id": "label",
      "label": "t:settings.label",
      "default": "Two - mix any colour"
    },
    {
      "type": "range",
      "id": "quantity",
      "label": "t:settings.tier_quantity",
      "min": 1,
      "max": 20,
      "step": 1,
      "default": 2
    },
    {
      "type": "range",
      "id": "discount",
      "label": "t:settings.discount_percent",
      "min": 0,
      "max": 90,
      "step": 1,
      "unit": "%",
      "default": 7
    }
  ],
  "presets": [
    {
      "name": "t:names.volume_tier"
    }
  ]
}
{% endschema %}
