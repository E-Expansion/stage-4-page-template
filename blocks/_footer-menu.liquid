{% doc %}
  Renders a footer menu column from a store navigation menu, with an optional button
  underneath. The button opens Shopify Inbox chat when it is installed and otherwise
  follows its link (e.g. the contact page).

  @example
  {% content_for 'blocks' %}
{% enddoc %}

{% liquid
  assign menu = block.settings.menu
  assign heading = block.settings.heading | default: menu.title | escape
  assign button_label = block.settings.button_label | escape
  # Without a link the button points to the contact page, the no-chat fallback.
  assign button_url = block.settings.button_link
  if button_url == blank
    assign button_url = routes.root_url | append: '/pages/contact' | replace: '//', '/'
  endif
%}

{% if menu.links.size > 0 or button_label != blank %}
  <div
    class="footer-menu"
    {{ block.shopify_attributes }}
  >
    {% if heading != blank %}
      <h2 class="footer-menu__heading">{{ heading }}</h2>
    {% endif %}

    {% if menu.links.size > 0 %}
      <ul class="footer-menu__list list-unstyled">
        {% for link in menu.links %}
          <li>
            <a
              href="{{ link.url }}"
              class="footer-menu__link"
              {% if link.current %}
                aria-current="page"
              {% endif %}
            >
              {{- link.title | escape -}}
            </a>
          </li>
        {% endfor %}
      </ul>
    {% endif %}

    {% if button_label != blank %}
      <a
        href="{{ button_url }}"
        class="footer-menu__button"
        {% if block.settings.button_opens_chat %}
          data-footer-chat
        {% endif %}
      >
        {{- button_label -}}
      </a>
    {% endif %}
  </div>

  {% if block.settings.button_opens_chat and button_label != blank %}
    <script type="module">
      // Opens Shopify Inbox when it has registered <shopify-chat>; otherwise the link is followed.
      if (!window.footerChatBound) {
        window.footerChatBound = true;
        document.addEventListener('click', (event) => {
          const trigger = event.target instanceof Element ? event.target.closest('[data-footer-chat]') : null;
          const chat = document.querySelector('shopify-chat');
          if (!trigger || !chat || !customElements.get('shopify-chat')) return;

          event.preventDefault();
          chat.setAttribute('open', '');
        });
      }
    </script>
  {% endif %}
{% endif %}

{% stylesheet %}
  .footer-menu {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--gap-xs);
    min-width: 0;
  }

  .footer-menu__heading {
    margin: 0;
    font-family: var(--font-body--family);
    font-weight: var(--font-body--weight);
    font-size: var(--font-size--2xs);
    letter-spacing: var(--letter-spacing-sm);
    text-transform: uppercase;
    color: var(--color-foreground-muted);
  }

  .footer-menu__list {
    display: flex;
    flex-direction: column;
    gap: var(--gap-xs);
    margin: 0;
    font-size: var(--font-size--sm);
    line-height: var(--line-height--body-loose);
  }

  .footer-menu__link {
    color: var(--color-foreground);
    text-decoration: none;
    transition: opacity var(--animation-speed) var(--animation-easing);

    &:hover {
      opacity: var(--opacity-subdued-text);
    }
  }

  .footer-menu__button {
    margin-block-start: var(--gap-md);
    padding: var(--padding-sm) var(--padding-lg);
    font-size: var(--font-size--2xs);
    letter-spacing: var(--letter-spacing-sm);
    text-transform: uppercase;
    color: var(--color-foreground);
    text-decoration: none;
    border: var(--style-border-width) solid var(--color-foreground);
    transition: background-color var(--animation-speed) var(--animation-easing),
      color var(--animation-speed) var(--animation-easing);

    &:hover {
      background-color: var(--color-foreground);
      color: var(--color-background);
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:names.footer_menu",
  "tag": null,
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "t:settings.heading",
      "info": "t:info.footer_menu_heading"
    },
    {
      "type": "link_list",
      "id": "menu",
      "label": "t:settings.menu"
    },
    {
      "type": "header",
      "content": "t:content.button"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "t:settings.button_label"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "t:settings.link",
      "info": "t:info.footer_menu_button_link"
    },
    {
      "type": "checkbox",
      "id": "button_opens_chat",
      "label": "t:settings.button_opens_chat",
      "info": "t:info.footer_menu_button_chat",
      "default": true
    }
  ],
  "presets": [
    {
      "name": "t:names.footer_menu"
    }
  ]
}
{% endschema %}
