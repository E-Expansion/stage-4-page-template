{% doc %}
  One manually filled tab of the product detail tabs. Only used when the product has no
  tabs in its custom.tabs metafield (see blocks/_product-tabs.liquid). Markup and styles
  live in snippets/product-tab.liquid.

  @example
  {% content_for 'blocks' %}
{% enddoc %}

{% liquid
  assign group_name = 'ProductTabs-' | append: section.id
  render 'product-tab', id: block.id, group: group_name, title: block.settings.title, heading: block.settings.heading, content: block.settings.content, extra_content: block.settings.page.content, attributes: block.shopify_attributes
%}

{% schema %}
{
  "name": "t:names.product_tab",
  "tag": null,
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "t:settings.title",
      "default": "Benefits"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "t:settings.heading",
      "default": "Built for every day, and made to look better with every mile."
    },
    {
      "type": "richtext",
      "id": "content",
      "label": "t:settings.text",
      "info": "t:info.product_tab_content"
    },
    {
      "type": "page",
      "id": "page",
      "label": "t:settings.page",
      "info": "t:info.product_tab_page"
    }
  ],
  "presets": [
    {
      "name": "t:names.product_tab"
    }
  ]
}
{% endschema %}
