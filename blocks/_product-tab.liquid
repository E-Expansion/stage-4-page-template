{% doc %}
  One tab of the product detail tabs. Connect its heading and text to product metafields
  in the theme editor (e.g. custom.tab_benefits_heading and custom.tab_benefits) so each
  product shows its own content; left out when empty. Markup and styles live in
  snippets/product-tab.liquid.

  @example
  {% content_for 'blocks' %}
{% enddoc %}

{% liquid
  assign group_name = 'ProductTabs-' | append: section.id
  render 'product-tab', id: block.id, group: group_name, title: block.settings.title, heading: block.settings.heading, content: block.settings.content, extra_content: block.settings.page.content, attributes: block.shopify_attributes
%}

{% schema %}
{
  "name": "t:names.product_tab",
  "tag": null,
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "t:settings.title",
      "default": "Benefits"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "t:settings.heading",
      "default": "Built for every day, and made to look better with every mile."
    },
    {
      "type": "richtext",
      "id": "content",
      "label": "t:settings.text",
      "info": "t:info.product_tab_content"
    },
    {
      "type": "page",
      "id": "page",
      "label": "t:settings.page",
      "info": "t:info.product_tab_page"
    }
  ],
  "presets": [
    {
      "name": "t:names.product_tab"
    }
  ]
}
{% endschema %}
