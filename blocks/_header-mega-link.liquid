{% doc %}
  Renders a single manually built link inside a mega menu column.
  Markup lives in snippets/header-mega-link.liquid.

  @example
  {% content_for 'blocks' %}
{% enddoc %}

{% liquid
  if block.settings.label != blank
    assign label = block.settings.label | escape
    assign url = block.settings.link | default: routes.all_products_collection_url
    render 'header-mega-link', label: label, url: url, attributes: block.shopify_attributes
  endif
%}

{% schema %}
{
  "name": "t:names.link",
  "tag": null,
  "settings": [
    {
      "type": "text",
      "id": "label",
      "label": "t:settings.label",
      "default": "Link"
    },
    {
      "type": "url",
      "id": "link",
      "label": "t:settings.link"
    }
  ],
  "presets": [
    {
      "name": "t:names.link"
    }
  ]
}
{% endschema %}
