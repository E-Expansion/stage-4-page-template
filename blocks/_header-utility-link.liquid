{% doc %}
  Renders a plain header link (e.g. Journal, Contact) aligned to the inline end of the
  navigation row on desktop. Listed after the menu items in the mobile sidebar.

  @example
  {% content_for 'blocks' %}
{% enddoc %}

{% if block.settings.label != blank %}
  <li
    class="site-nav__item site-nav__item--utility"
    {{ block.shopify_attributes }}
  >
    <a
      href="{{ block.settings.link | default: routes.root_url }}"
      class="site-nav__link"
      {% if block.settings.link == request.path %}
        aria-current="page"
      {% endif %}
    >
      {{- block.settings.label | escape -}}
    </a>
  </li>
{% endif %}

{% stylesheet %}
  @media screen and (min-width: 750px) {
    .site-nav__item--utility {
      order: 2;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:names.utility_link",
  "tag": null,
  "settings": [
    {
      "type": "text",
      "id": "label",
      "label": "t:settings.label",
      "default": "Link"
    },
    {
      "type": "url",
      "id": "link",
      "label": "t:settings.link"
    }
  ],
  "presets": [
    {
      "name": "t:names.utility_link"
    }
  ]
}
{% endschema %}
