{% doc %}
  Renders a promo tile inside the collection product grid: a full-bleed image with a
  large heading and a link line over a dark gradient. The section places it after the
  chosen number of products on the first page. Settings can be connected to collection
  metafields in the theme editor to give each collection its own promo.

  @example
  {% content_for 'blocks' %}
{% enddoc %}

{% liquid
  assign heading = block.settings.heading | escape
  assign link_label = block.settings.link_label | escape
  assign url = block.settings.link | default: '#'
%}

<li
  class="collection-promo{% unless block.settings.show_on_mobile %} mobile:hidden{% endunless %}"
  style="
    --collection-promo-text: {{ block.settings.text_color }};
    --collection-promo-overlay-rgb: {{ block.settings.overlay_color.rgb }};
  "
  {{ block.shopify_attributes }}
>
  <a
    href="{{ url }}"
    class="collection-promo__link"
  >
    {% if block.settings.image != blank %}
      {{
        block.settings.image
        | image_url: width: 1200
        | image_tag:
          widths: '360, 480, 640, 800, 1000, 1200',
          sizes: '(min-width: 750px) 33vw, 50vw',
          loading: 'lazy',
          alt: '',
          class: 'collection-promo__image'
      }}
    {% else %}
      {{ 'lifestyle-1' | placeholder_svg_tag: 'collection-promo__image collection-promo__placeholder' }}
    {% endif %}

    <span class="collection-promo__content">
      {% if heading != blank %}
        <span class="collection-promo__heading">{{ heading }}</span>
      {% endif %}
      {% if link_label != blank %}
        <span class="collection-promo__label">{{ link_label }}</span>
      {% endif %}
    </span>
  </a>
</li>

{% stylesheet %}
  .collection-promo {
    min-width: 0;
  }

  .collection-promo__link {
    position: relative;
    display: flex;
    align-items: flex-end;
    height: 100%;
    min-height: 18rem;
    overflow: hidden;
    color: var(--collection-promo-text);
    text-decoration: none;
    border-radius: var(--style-border-radius-xs);
  }

  .collection-promo__image {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform var(--animation-speed-slow) var(--animation-easing);
  }

  .collection-promo__placeholder {
    background-color: rgb(var(--color-foreground-rgb) / var(--opacity-10));
    fill: rgb(var(--color-foreground-rgb) / var(--opacity-30));
  }

  @media (hover: hover) {
    .collection-promo__link:hover .collection-promo__image {
      transform: scale(1.03);
    }
  }

  .collection-promo__content {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: var(--gap-sm);
    width: 100%;
    padding: var(--padding-3xl) var(--padding-lg) var(--padding-lg);
    background-image: linear-gradient(
      to top,
      rgb(var(--collection-promo-overlay-rgb) / var(--opacity-80)),
      rgb(var(--collection-promo-overlay-rgb) / 0)
    );
  }

  .collection-promo__heading {
    font-family: var(--font-heading--family);
    font-weight: var(--font-heading--weight);
    font-size: var(--font-size--2xl);
    line-height: var(--line-height--display-tight);
    text-transform: uppercase;
    overflow-wrap: anywhere;

    @media screen and (min-width: 990px) {
      font-size: var(--font-size--3xl);
    }
  }

  .collection-promo__label {
    font-size: var(--font-size--sm);
  }

  @media (prefers-reduced-motion: reduce) {
    .collection-promo__image {
      transition: none;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:names.collection_promo",
  "tag": null,
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "t:settings.image"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "t:settings.heading",
      "default": "Made for everyday adventures"
    },
    {
      "type": "text",
      "id": "link_label",
      "label": "t:settings.link_label",
      "default": "Discover the collection"
    },
    {
      "type": "url",
      "id": "link",
      "label": "t:settings.link"
    },
    {
      "type": "checkbox",
      "id": "show_on_mobile",
      "label": "t:settings.show_on_mobile",
      "default": false
    },
    {
      "type": "header",
      "content": "t:content.appearance"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "t:settings.text_color",
      "default": "{{ settings.color_palette.background }}"
    },
    {
      "type": "color",
      "id": "overlay_color",
      "label": "t:settings.overlay_color",
      "default": "{{ settings.color_palette.foreground }}"
    }
  ],
  "presets": [
    {
      "name": "t:names.collection_promo"
    }
  ]
}
{% endschema %}
