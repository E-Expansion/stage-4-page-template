{% doc %}
  Renders product detail tabs ("Benefits", "Compare", "Sustainability"): a row of tabs above
  the open tab's content. The tabs are radio buttons, so they work without JavaScript, move
  with the arrow keys and keep their choice when the information column re-renders on a
  variant change. The first tab opens by default.

  The tabs come from the product's custom.tabs metafield (a list of product_tab
  metaobjects: title, heading, content), so each product shows its own tabs from one
  template. Products without it fall back to the _product-tab blocks. Renders nothing when
  neither has tabs. Each tab is rendered by snippets/product-tab.liquid.

  @example
  {% content_for 'blocks' %}
{% enddoc %}

{% liquid
  assign tab_entries = product.metafields.custom.tabs.value
  assign group_name = 'ProductTabs-' | append: section.id

  capture tabs
    if tab_entries.size > 0
      for entry in tab_entries
        assign entry_content = blank
        if entry.content != blank
          assign entry_content = entry.content | metafield_tag
        endif
        render 'product-tab', id: entry.system.id, group: group_name, title: entry.title.value, heading: entry.heading.value, content: entry_content
      endfor
    else
      content_for 'blocks'
    endif
  endcapture
%}

{% if tabs != blank %}
  <div
    class="product-tabs"
    {% if block.settings.accent_color != blank %}
      style="--product-tabs-accent: {{ block.settings.accent_color }};"
    {% endif %}
    {{ block.shopify_attributes }}
  >
    {{ tabs }}
  </div>
{% endif %}

{% stylesheet %}
  /* Tabs share the first row; the open panel takes the full width below them */
  .product-tabs {
    display: flex;
    flex-wrap: wrap;
    overflow: hidden;
    border: var(--style-border-width) solid var(--color-border);
    border-radius: var(--style-border-radius-sm);
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:names.product_tabs",
  "tag": null,
  "blocks": [
    {
      "type": "_product-tab"
    }
  ],
  "settings": [
    {
      "type": "color",
      "id": "accent_color",
      "label": "t:settings.accent_color",
      "info": "t:info.product_tabs_accent",
      "default": "{{ settings.color_palette.color5 }}"
    }
  ],
  "presets": [
    {
      "name": "t:names.product_tabs",
      "blocks": {
        "benefits": {
          "type": "_product-tab",
          "settings": {
            "title": "Benefits",
            "heading": "Built for every day, and made to look better with every mile.",
            "content": "<ul><li>Full-grain leather that develops a rich, individual patina</li><li>Comfortably fits a 14-inch laptop and daily essentials</li><li>Hand-finished edges and solid brass hardware</li><li>Five-year repair guarantee</li></ul>"
          }
        },
        "compare": {
          "type": "_product-tab",
          "settings": {
            "title": "Compare",
            "heading": "Which size suits you?",
            "content": "<ul><li>Small: tablet, wallet and keys</li><li>Medium: a 14-inch laptop and daily essentials</li><li>Large: a 16-inch laptop, documents and a change of clothes</li></ul>"
          }
        },
        "sustainability": {
          "type": "_product-tab",
          "settings": {
            "title": "Sustainability",
            "heading": "Made to last, not to replace.",
            "content": "<p>Vegetable-tanned leather from an audited tannery, unlacquered brass and a recycled cotton lining. Every bag can be repaired in our workshop.</p>"
          }
        }
      },
      "block_order": ["benefits", "compare", "sustainability"]
    }
  ]
}
{% endschema %}
