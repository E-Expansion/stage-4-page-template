{% doc %}
  Renders a top-level header navigation item. With columns it becomes a mega menu
  trigger: a hover/click dropdown on desktop and an accordion in the mobile sidebar.
  Without columns it renders as a plain link.

  Columns come from the same data as the subcategories strip on collection pages, so the
  menu and the collection pages always match:
  - Columns: the chosen collection's custom.subcategories metafield (list of collections).
  - Links in a column: that subcollection's own custom.subcategories, or its first
    products when it has none (one link per colour group; see custom.variant_a).
  Without a collection, or when its metafield is empty, the manual column blocks are used.

  The desktop dropdown has at least four equal columns; the featured collection set on the
  header section (image and short text) always takes the last one, so one new or limited
  collection is promoted everywhere.

  @example
  {% content_for 'blocks' %}
{% enddoc %}

{% liquid
  assign source = block.settings.collection
  assign label = block.settings.label | default: source.title | escape
  assign item_url = block.settings.link | default: source.url
  assign submenu_id = 'MegaMenu-' | append: block.id
  assign column_count = 0

  # Data-driven columns: one per subcategory, skipping empty collections like the subcategories section does
  if source != blank
    capture columns
      for subcollection in source.metafields.custom.subcategories.value
        if subcollection.handle == 'frontpage' or subcollection.products_count == 0
          continue
        endif

        capture links
          assign children = subcollection.metafields.custom.subcategories.value
          if children.size > 0
            for child in children
              if child.products_count == 0
                continue
              endif
              assign child_title = child.title | escape
              render 'header-mega-link', label: child_title, url: child.url
            endfor
          else
            # Colours are separate linked products (custom.variant_a/b/c). Show one link per
            # colour group, keyed on the shared variant_a link, with the colour left off the title
            assign seen_groups = ','
            assign shown = 0
            for product in subcollection.products limit: 50
              if shown >= 5
                break
              endif
              assign group_link = product.metafields.custom.variant_a.value
              assign group_key = group_link.handle | default: group_link | default: product.handle
              assign group_key = group_key | split: '/products/' | last | split: '?' | first
              assign group_marker = ',' | append: group_key | append: ','
              if seen_groups contains group_marker
                continue
              endif
              assign seen_groups = seen_groups | append: group_key | append: ','

              assign product_title = product.title
              assign color_name = product.metafields.custom.color_name.value
              if color_name != blank
                assign product_title = product_title | remove_last: color_name | strip
              endif
              render 'header-mega-link', label: product_title, url: product.url
              assign shown = shown | plus: 1
            endfor
          endif
        endcapture

        assign subcollection_title = subcollection.title | escape
        render 'header-mega-column', heading: subcollection_title, url: subcollection.url, links: links
        assign column_count = column_count | plus: 1
      endfor
    endcapture
  endif

  # Fallback: manually built column blocks
  if columns == blank
    capture columns
      content_for 'blocks'
    endcapture
    assign column_count = block.blocks.size
  endif

  assign has_columns = false
  if columns != blank
    assign has_columns = true
  endif

  # Shared by every dropdown: set once in the header section's settings
  assign featured = section.settings.featured_collection
  if featured != blank
    assign featured_image = section.settings.featured_image | default: featured.featured_image
    assign featured_text = section.settings.featured_text | escape
    if featured_text == blank
      assign featured_text = featured.description | strip_html | truncatewords: 14 | escape
    endif
    if featured_text == blank
      assign featured_text = featured.title | escape
    endif
    assign column_count = column_count | plus: 1
  endif

  # Never fewer than four tracks, so short menus keep the designed proportions
  assign grid_columns = column_count | at_least: 4
%}

{% if label != blank %}
  <li
    class="site-nav__item{% if has_columns %} site-nav__item--has-menu{% endif %}"
    {{ block.shopify_attributes }}
  >
    {% if has_columns %}
      <button
        type="button"
        class="site-nav__link button-unstyled"
        aria-expanded="false"
        aria-controls="{{ submenu_id }}"
        on:click="/toggleSubmenu"
      >
        {{ label }}
        <span
          class="svg-wrapper site-nav__caret"
          aria-hidden="true"
        >
          {{- 'icon-caret.svg' | inline_asset_content -}}
        </span>
      </button>

      <div
        id="{{ submenu_id }}"
        class="site-mega"
      >
        <div class="site-mega__inner section section--page-width">
          <div class="site-mega__content">
            <ul
              class="site-mega__columns list-unstyled"
              style="--site-mega-columns: {{ grid_columns }};"
            >
              {{ columns }}

              {% if featured != blank %}
                <li class="site-mega__featured">
                  <a
                    href="{{ featured.url }}"
                    class="site-mega__featured-link"
                  >
                    <span class="site-mega__featured-media">
                      {% if featured_image != blank %}
                        {{
                          featured_image
                          | image_url: width: 800
                          | image_tag:
                            widths: '320, 480, 640, 800',
                            sizes: '(min-width: 750px) 22vw, 100vw',
                            loading: 'lazy',
                            alt: '',
                            class: 'site-mega__featured-image'
                        }}
                      {% else %}
                        {{ 'collection-1' | placeholder_svg_tag: 'site-mega__featured-image site-mega__featured-placeholder' }}
                      {% endif %}
                    </span>
                    <span class="site-mega__featured-text">
                      {{- featured_text -}}
                    </span>
                  </a>
                </li>
              {% endif %}
            </ul>

            {% if item_url != blank %}
              <a
                href="{{ item_url }}"
                class="site-mega__view-all"
              >
                {{- 'actions.view_all' | t }}
                {{ label -}}
              </a>
            {% endif %}
          </div>
        </div>
      </div>
    {% elsif item_url != blank %}
      <a
        href="{{ item_url }}"
        class="site-nav__link"
        {% if item_url == request.path %}
          aria-current="page"
        {% endif %}
      >
        {{- label -}}
      </a>
    {% else %}
      <span class="site-nav__link">{{ label }}</span>
    {% endif %}
  </li>
{% endif %}

{% stylesheet %}
  .site-nav__caret {
    width: var(--icon-size-xs);
    height: var(--icon-size-xs);
    color: var(--color-foreground-muted);
    transition: transform var(--animation-speed) var(--animation-easing);
  }

  .site-nav__link[aria-expanded='true'] .site-nav__caret {
    transform: rotate(180deg);
  }

  .site-mega__column-heading {
    display: block;
    margin-block-end: var(--padding-xs);
    font-family: var(--font-subheading--family);
    font-weight: var(--font-subheading--weight);
    color: var(--color-foreground);
    text-decoration: none;
  }

  .site-mega__links {
    display: flex;
    flex-direction: column;
    gap: var(--gap-xs);
    margin: 0;
  }

  .site-mega__link {
    color: var(--color-foreground-muted);
    text-decoration: none;
    transition: color var(--animation-speed) var(--animation-easing);

    &:hover {
      color: var(--color-foreground);
    }
  }

  .site-mega__view-all {
    color: inherit;
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }

  @media screen and (min-width: 750px) {
    /* Full-width panel anchored to the bottom edge of the header */
    .site-mega {
      position: absolute;
      inset-inline: 0;
      inset-block-start: 100%;
      z-index: var(--layer-header-menu);
      background-color: var(--color-background);
      border-block-end: var(--style-border-width) solid var(--color-border);
      box-shadow: var(--shadow-popover);
      opacity: 0;
      visibility: hidden;
      translate: 0 calc(var(--padding-xs) * -1);
      transition: opacity var(--animation-speed-slow) var(--animation-easing),
        translate var(--animation-speed-slow) var(--animation-easing),
        visibility var(--animation-speed-slow) var(--animation-easing);
    }

    .site-nav__item--has-menu:hover > .site-mega,
    .site-nav__item[data-open] > .site-mega {
      opacity: 1;
      visibility: visible;
      translate: 0 0;
    }

    /* A click-opened item wins over a hovered neighbour */
    .site-nav:has([data-open]) .site-nav__item--has-menu:not([data-open]) > .site-mega {
      opacity: 0;
      visibility: hidden;
    }

    .site-mega__content {
      display: flex;
      flex-direction: column;
      gap: var(--gap-xl);
      padding-block: var(--padding-4xl);
    }

    /* Equal columns (at least four); the featured collection is pinned to the last one */
    .site-mega__columns {
      display: grid;
      grid-template-columns: repeat(var(--site-mega-columns, 4), minmax(0, 1fr));
      gap: var(--gap-2xl);
      margin: 0;
    }

    .site-mega__featured {
      grid-column: -2 / -1;
      grid-row: 1;
      padding-inline-start: var(--gap-2xl);
      border-inline-start: var(--style-border-width) solid var(--color-border);
    }
  }

  .site-mega__featured {
    min-width: 0;
  }

  .site-mega__featured-link {
    display: flex;
    flex-direction: column;
    gap: var(--gap-sm);
    color: var(--color-foreground-muted);
    text-decoration: none;

    &:hover {
      color: var(--color-foreground);
    }
  }

  .site-mega__featured-media {
    display: block;
    aspect-ratio: 16 / 9;
    overflow: hidden;
    border: var(--style-border-width) solid var(--color-border);
    border-radius: var(--style-border-radius-md);
  }

  .site-mega__featured-image {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform var(--animation-speed-slow) var(--animation-easing);
  }

  .site-mega__featured-placeholder {
    background-color: rgb(var(--color-foreground-rgb) / var(--opacity-5));
    fill: rgb(var(--color-foreground-rgb) / var(--opacity-30));
  }

  @media (hover: hover) {
    .site-mega__featured-link:hover .site-mega__featured-image {
      transform: scale(1.03);
    }
  }

  .site-mega__featured-text {
    font-size: var(--font-size--sm);
    line-height: var(--line-height--body-loose);
    overflow-wrap: anywhere;
  }

  @media screen and (max-width: 749px) {
    .site-mega {
      display: none;
      padding-block-end: var(--padding-lg);
    }

    .site-nav__item[data-open] > .site-mega {
      display: block;
    }

    .site-mega__inner.section {
      display: block;
      padding: 0;
    }

    .site-mega__content,
    .site-mega__columns {
      display: flex;
      flex-direction: column;
      gap: var(--gap-lg);
      margin: 0;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .site-mega,
    .site-mega__featured-image,
    .site-nav__caret {
      transition: none;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:names.menu_item",
  "tag": null,
  "blocks": [
    {
      "type": "_header-mega-column"
    }
  ],
  "settings": [
    {
      "type": "collection",
      "id": "collection",
      "label": "t:settings.collection",
      "info": "t:info.menu_item_collection"
    },
    {
      "type": "text",
      "id": "label",
      "label": "t:settings.label"
    },
    {
      "type": "url",
      "id": "link",
      "label": "t:settings.link",
      "info": "t:info.menu_item_link"
    }
  ],
  "presets": [
    {
      "name": "t:names.menu_item"
    }
  ]
}
{% endschema %}
