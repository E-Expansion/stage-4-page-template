{% doc %}
  Renders a top-level header navigation item. With column blocks it becomes a mega menu
  trigger: a hover/click dropdown on desktop and an accordion in the mobile sidebar.
  Without columns it renders as a plain link. The desktop dropdown is a grid of four equal
  columns; an optional featured collection (image and short text) always takes the fourth.

  @example
  {% content_for 'blocks' %}
{% enddoc %}

{% liquid
  assign label = block.settings.label | escape
  assign submenu_id = 'MegaMenu-' | append: block.id

  capture columns
    content_for 'blocks'
  endcapture
  assign has_columns = false
  if columns != blank
    assign has_columns = true
  endif

  assign featured = block.settings.featured_collection
  if featured != blank
    assign featured_image = block.settings.featured_image | default: featured.featured_image
    assign featured_text = block.settings.featured_text | escape
    if featured_text == blank
      assign featured_text = featured.description | strip_html | truncatewords: 14 | escape
    endif
    if featured_text == blank
      assign featured_text = featured.title | escape
    endif
  endif
%}

{% if label != blank %}
  <li
    class="site-nav__item{% if has_columns %} site-nav__item--has-menu{% endif %}"
    {{ block.shopify_attributes }}
  >
    {% if has_columns %}
      <button
        type="button"
        class="site-nav__link button-unstyled"
        aria-expanded="false"
        aria-controls="{{ submenu_id }}"
        on:click="/toggleSubmenu"
      >
        {{ label }}
        <span
          class="svg-wrapper site-nav__caret"
          aria-hidden="true"
        >
          {{- 'icon-caret.svg' | inline_asset_content -}}
        </span>
      </button>

      <div
        id="{{ submenu_id }}"
        class="site-mega"
      >
        <div class="site-mega__inner section section--page-width">
          <div class="site-mega__content">
            <ul class="site-mega__columns list-unstyled">
              {{ columns }}

              {% if featured != blank %}
                <li class="site-mega__featured">
                  <a
                    href="{{ featured.url }}"
                    class="site-mega__featured-link"
                  >
                    <span class="site-mega__featured-media">
                      {% if featured_image != blank %}
                        {{
                          featured_image
                          | image_url: width: 800
                          | image_tag:
                            widths: '320, 480, 640, 800',
                            sizes: '(min-width: 750px) 22vw, 100vw',
                            loading: 'lazy',
                            alt: '',
                            class: 'site-mega__featured-image'
                        }}
                      {% else %}
                        {{ 'collection-1' | placeholder_svg_tag: 'site-mega__featured-image site-mega__featured-placeholder' }}
                      {% endif %}
                    </span>
                    <span class="site-mega__featured-text">
                      {{- featured_text -}}
                    </span>
                  </a>
                </li>
              {% endif %}
            </ul>

            {% if block.settings.link != blank %}
              <a
                href="{{ block.settings.link }}"
                class="site-mega__view-all"
              >
                {{- 'actions.view_all' | t }}
                {{ label -}}
              </a>
            {% endif %}
          </div>
        </div>
      </div>
    {% elsif block.settings.link != blank %}
      <a
        href="{{ block.settings.link }}"
        class="site-nav__link"
        {% if block.settings.link == request.path %}
          aria-current="page"
        {% endif %}
      >
        {{- label -}}
      </a>
    {% else %}
      <span class="site-nav__link">{{ label }}</span>
    {% endif %}
  </li>
{% endif %}

{% stylesheet %}
  .site-nav__caret {
    width: var(--icon-size-xs);
    height: var(--icon-size-xs);
    color: var(--color-foreground-muted);
    transition: transform var(--animation-speed) var(--animation-easing);
  }

  .site-nav__link[aria-expanded='true'] .site-nav__caret {
    transform: rotate(180deg);
  }

  .site-mega__column-heading {
    display: block;
    margin-block-end: var(--padding-xs);
    font-family: var(--font-subheading--family);
    font-weight: var(--font-subheading--weight);
    color: var(--color-foreground);
    text-decoration: none;
  }

  .site-mega__links {
    display: flex;
    flex-direction: column;
    gap: var(--gap-xs);
    margin: 0;
  }

  .site-mega__link {
    color: var(--color-foreground-muted);
    text-decoration: none;
    transition: color var(--animation-speed) var(--animation-easing);

    &:hover {
      color: var(--color-foreground);
    }
  }

  .site-mega__view-all {
    color: inherit;
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }

  @media screen and (min-width: 750px) {
    /* Full-width panel anchored to the bottom edge of the header */
    .site-mega {
      position: absolute;
      inset-inline: 0;
      inset-block-start: 100%;
      z-index: var(--layer-header-menu);
      background-color: var(--color-background);
      border-block-end: var(--style-border-width) solid var(--color-border);
      box-shadow: var(--shadow-popover);
      opacity: 0;
      visibility: hidden;
      translate: 0 calc(var(--padding-xs) * -1);
      transition: opacity var(--animation-speed-slow) var(--animation-easing),
        translate var(--animation-speed-slow) var(--animation-easing),
        visibility var(--animation-speed-slow) var(--animation-easing);
    }

    .site-nav__item--has-menu:hover > .site-mega,
    .site-nav__item[data-open] > .site-mega {
      opacity: 1;
      visibility: visible;
      translate: 0 0;
    }

    /* A click-opened item wins over a hovered neighbour */
    .site-nav:has([data-open]) .site-nav__item--has-menu:not([data-open]) > .site-mega {
      opacity: 0;
      visibility: hidden;
    }

    .site-mega__content {
      display: flex;
      flex-direction: column;
      gap: var(--gap-xl);
      padding-block: var(--padding-4xl);
    }

    /* Four equal columns; the featured collection is pinned to the last one */
    .site-mega__columns {
      display: grid;
      grid-template-columns: repeat(4, minmax(0, 1fr));
      gap: var(--gap-2xl);
      margin: 0;
    }

    .site-mega__featured {
      grid-column: 4;
      grid-row: 1;
      padding-inline-start: var(--gap-2xl);
      border-inline-start: var(--style-border-width) solid var(--color-border);
    }
  }

  .site-mega__featured {
    min-width: 0;
  }

  .site-mega__featured-link {
    display: flex;
    flex-direction: column;
    gap: var(--gap-sm);
    color: var(--color-foreground-muted);
    text-decoration: none;

    &:hover {
      color: var(--color-foreground);
    }
  }

  .site-mega__featured-media {
    display: block;
    aspect-ratio: 16 / 9;
    overflow: hidden;
    border: var(--style-border-width) solid var(--color-border);
    border-radius: var(--style-border-radius-md);
  }

  .site-mega__featured-image {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform var(--animation-speed-slow) var(--animation-easing);
  }

  .site-mega__featured-placeholder {
    background-color: rgb(var(--color-foreground-rgb) / var(--opacity-5));
    fill: rgb(var(--color-foreground-rgb) / var(--opacity-30));
  }

  @media (hover: hover) {
    .site-mega__featured-link:hover .site-mega__featured-image {
      transform: scale(1.03);
    }
  }

  .site-mega__featured-text {
    font-size: var(--font-size--sm);
    line-height: var(--line-height--body-loose);
    overflow-wrap: anywhere;
  }

  @media screen and (max-width: 749px) {
    .site-mega {
      display: none;
      padding-block-end: var(--padding-lg);
    }

    .site-nav__item[data-open] > .site-mega {
      display: block;
    }

    .site-mega__inner.section {
      display: block;
      padding: 0;
    }

    .site-mega__content,
    .site-mega__columns {
      display: flex;
      flex-direction: column;
      gap: var(--gap-lg);
      margin: 0;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .site-mega,
    .site-mega__featured-image,
    .site-nav__caret {
      transition: none;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:names.menu_item",
  "tag": null,
  "blocks": [
    {
      "type": "_header-mega-column"
    }
  ],
  "settings": [
    {
      "type": "text",
      "id": "label",
      "label": "t:settings.label",
      "default": "Menu item"
    },
    {
      "type": "url",
      "id": "link",
      "label": "t:settings.link",
      "info": "t:info.menu_item_link"
    },
    {
      "type": "header",
      "content": "t:names.featured_collection"
    },
    {
      "type": "collection",
      "id": "featured_collection",
      "label": "t:settings.collection"
    },
    {
      "type": "image_picker",
      "id": "featured_image",
      "label": "t:settings.image",
      "info": "t:info.category_card_image"
    },
    {
      "type": "text",
      "id": "featured_text",
      "label": "t:settings.text",
      "info": "t:info.menu_featured_text"
    }
  ],
  "presets": [
    {
      "name": "t:names.menu_item"
    }
  ]
}
{% endschema %}
