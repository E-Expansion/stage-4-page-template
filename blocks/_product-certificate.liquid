{% doc %}
  Renders the product certificate card: a round certificate badge on the left (uploaded
  image, or a placeholder until one is chosen) and a heading, short text and a "Read more"
  link to the certifying organisation's website (opens in a new tab) on the right. The
  card is tinted with the rating gold from Theme settings unless a background is chosen.
  Settings can be connected to product metafields so each product shows its own certificate.

  @example
  {% content_for 'blocks' %}
{% enddoc %}

{% liquid
  assign heading = block.settings.heading | escape
  assign link_label = block.settings.link_label | escape
%}

{% if heading != blank or block.settings.text != blank %}
  <div
    class="certificate"
    {% if block.settings.background_color != blank %}
      style="--certificate-background: {{ block.settings.background_color }};"
    {% endif %}
    {{ block.shopify_attributes }}
  >
    <div class="certificate__badge">
      {% if block.settings.image != blank %}
        {{
          block.settings.image
          | image_url: width: 320
          | image_tag: width: 160, height: 160, loading: 'lazy', class: 'certificate__image'
        }}
      {% else %}
        {{ 'image' | placeholder_svg_tag: 'certificate__image certificate__image--placeholder' }}
      {% endif %}
    </div>

    <div class="certificate__body">
      {% if heading != blank %}
        <h3 class="certificate__heading">{{ heading }}</h3>
      {% endif %}

      {% if block.settings.text != blank %}
        <div class="certificate__text rte">{{ block.settings.text }}</div>
      {% endif %}

      {% if block.settings.link != blank and link_label != blank %}
        <a
          href="{{ block.settings.link }}"
          class="certificate__link"
          target="_blank"
          rel="noopener"
        >
          {{- link_label -}}
          <span class="visually-hidden">({{ 'accessibility.new_window' | t }})</span>
          <span
            class="svg-wrapper certificate__link-icon"
            aria-hidden="true"
          >
            {{- 'icon-external.svg' | inline_asset_content -}}
          </span>
        </a>
      {% endif %}
    </div>
  </div>
{% endif %}

{% stylesheet %}
  .certificate {
    display: flex;
    align-items: center;
    gap: var(--gap-lg);
    padding: var(--padding-xl) var(--padding-lg);
    background-color: var(
      --certificate-background,
      color-mix(in srgb, var(--color-rating) 14%, var(--color-background))
    );
    border: var(--style-border-width) solid
      color-mix(in srgb, var(--color-rating) 30%, var(--color-background));
    border-radius: var(--style-border-radius-sm);

    @media screen and (min-width: 750px) {
      gap: var(--gap-2xl);
      padding: var(--padding-2xl);
    }
  }

  .certificate__badge {
    flex-shrink: 0;
    width: 6rem;
    aspect-ratio: 1;
    overflow: hidden;
    border-radius: 50%;

    @media screen and (min-width: 750px) {
      width: 7.5rem;
    }
  }

  .certificate__image {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .certificate__image--placeholder {
    background-color: rgb(var(--color-foreground-rgb) / var(--opacity-5));
    fill: rgb(var(--color-foreground-rgb) / var(--opacity-30));
  }

  .certificate__body {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--gap-sm);
    min-width: 0;
  }

  .certificate__heading {
    margin: 0;
    font-family: var(--font-heading--family);
    font-weight: var(--font-heading--weight);
    font-size: var(--font-size--lg);
    line-height: var(--line-height--display-normal);
    overflow-wrap: anywhere;

    @media screen and (min-width: 750px) {
      font-size: var(--font-size--xl);
    }
  }

  .certificate__text {
    font-size: var(--font-size--sm);
    line-height: var(--line-height--body-loose);
    color: var(--color-foreground-muted);

    & > * {
      margin: 0;
    }
  }

  .certificate__link {
    display: inline-flex;
    align-items: center;
    gap: var(--gap-3xs);
    font-size: var(--font-size--sm);
    color: var(--color-foreground);
    text-decoration: none;

    &:hover {
      text-decoration: underline;
      text-underline-offset: 0.25em;
    }
  }

  .certificate__link-icon {
    width: var(--icon-size-sm);
    height: var(--icon-size-sm);
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:names.product_certificate",
  "tag": null,
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "t:settings.image",
      "info": "t:info.certificate_image"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "t:settings.heading",
      "default": "Responsibly sourced leather"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "t:settings.text",
      "default": "<p>Made with leather from a tannery audited for environmental performance and responsible production practices.</p>"
    },
    {
      "type": "text",
      "id": "link_label",
      "label": "t:settings.link_label",
      "default": "Read more"
    },
    {
      "type": "url",
      "id": "link",
      "label": "t:settings.link",
      "info": "t:info.certificate_link"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "t:settings.background_color",
      "info": "t:info.certificate_background"
    }
  ],
  "presets": [
    {
      "name": "t:names.product_certificate"
    }
  ]
}
{% endschema %}
