{% comment %}
  Section contract.
  Main product area of the product template: breadcrumbs, the media gallery on the left
  and an information column of blocks on the right (stacked on mobile). Everything is
  read from the current product, so one template serves every product. The information
  column grows block by block (title, rating and stock, price, variant picker, purchase options, quantity tiers, buy button, gift wrap, free gift progress, USP badges, shipping countdown, back in stock, product tabs, certificate) and accepts app blocks.
  @example
  <!-- Product template > Product information; add blocks to the information column -->
{% endcomment %}

{% comment %} Product details for search engines: name, images, price, stock and reviews {% endcomment %}
<script type="application/ld+json">
  {{ product | structured_data }}
</script>

{% render 'contrast-override',
  background_color: section.settings.background_color,
  border_color: section.settings.border_color,
  section_id: section.id
%}

<div class="section-background color-custom-{{ section.id }}"></div>
<div
  class="product-main section section--page-width spacing-style color-custom-{{ section.id }}"
  style="
    {% render 'spacing-padding', settings: section.settings %}
    --product-gallery-ratio: {{ section.settings.media_ratio }};
  "
>
  {% if section.settings.show_breadcrumbs %}
    <div class="product-main__breadcrumbs">
      {% render 'breadcrumbs' %}
    </div>
  {% endif %}

  <div class="product-main__layout{% if section.settings.sticky_info %} product-main__layout--sticky{% endif %}">
    <div class="product-main__media">
      {% render 'product-gallery',
        product: product,
        section_id: section.id,
        show_badge: section.settings.show_badge
      %}
    </div>

    {% liquid
      # The selected colour's image, by ID and by file name; the gallery matches on either
      assign selected_variant = product.selected_or_first_available_variant
      capture selected_media_id
        render 'variant-media-id', product: product, variant: selected_variant
      endcapture
      assign selected_media_file = selected_variant.featured_media.preview_image.src | split: '?' | first | split: '/' | last
      for media in product.media
        assign media_id = media.id | append: ''
        if media_id == selected_media_id
          assign selected_media_file = media.preview_image.src | split: '?' | first | split: '/' | last
          break
        endif
      endfor
    %}
    {% comment %} Read by assets/product-info.js when an option or purchase type changes {% endcomment %}
    <div
      class="product-main__info"
      data-section-id="{{ section.id }}"
      data-product-url="{{ product.url }}"
      data-variant-id="{{ product.selected_or_first_available_variant.id }}"
      data-selling-plan-id="{{ product.selected_or_first_available_variant.selected_selling_plan_allocation.selling_plan.id }}"
      data-media-id="{{ selected_media_id }}"
      data-media-file="{{ selected_media_file }}"
    >
      {% content_for 'blocks' %}
    </div>
  </div>
</div>

{% if section.settings.show_sticky_buy %}
  {% comment %} Stays hidden when there is no buy block to scroll past; see assets/sticky-buy.js {% endcomment %}
  {% render 'product-sticky-buy',
    product: product,
    section_id: section.id,
    show_image: section.settings.sticky_show_image,
    show_rating: section.settings.sticky_show_rating,
    show_sold_this_week: section.settings.sticky_show_sold,
    show_stock: section.settings.sticky_show_stock,
    in_stock_note: section.settings.sticky_in_stock_note,
    button_color: section.settings.sticky_button_color
  %}
{% endif %}

{% stylesheet %}
  .product-main__breadcrumbs {
    margin-block-end: var(--padding-md);
  }

  .product-main__layout {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--gap-xl);
    align-items: start;

    @media screen and (min-width: 990px) {
      grid-template-columns: minmax(0, 11fr) minmax(0, 9fr);
      gap: var(--padding-4xl);
    }
  }

  .product-main__media {
    min-width: 0;
  }

  .product-main__info {
    display: flex;
    flex-direction: column;
    gap: var(--gap-md);
    min-width: 0;
  }

  /* Both columns stick; the shorter one (usually the gallery) stays in view while the
     taller one scrolls past, the taller one has no room to stick */
  @media screen and (min-width: 990px) {
    .product-main__layout--sticky > .product-main__media,
    .product-main__layout--sticky > .product-main__info {
      position: sticky;
      inset-block-start: calc(var(--header-height, 0px) + var(--padding-lg));
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:names.product_information",
  "blocks": [
    {
      "type": "_product-title"
    },
    {
      "type": "_product-meta"
    },
    {
      "type": "_product-price"
    },
    {
      "type": "_product-variant-picker"
    },
    {
      "type": "_product-purchase-options"
    },
    {
      "type": "_product-volume-pricing"
    },
    {
      "type": "_product-gift-wrap"
    },
    {
      "type": "_product-free-gift"
    },
    {
      "type": "_product-usps"
    },
    {
      "type": "_product-shipping-countdown"
    },
    {
      "type": "_product-back-in-stock"
    },
    {
      "type": "_product-tabs"
    },
    {
      "type": "_product-certificate"
    },
    {
      "type": "_product-buy"
    },
    {
      "type": "@app"
    }
  ],
  "settings": [
    {
      "type": "checkbox",
      "id": "show_breadcrumbs",
      "label": "t:settings.show_breadcrumbs",
      "default": true
    },
    {
      "type": "header",
      "content": "t:content.media"
    },
    {
      "type": "select",
      "id": "media_ratio",
      "label": "t:settings.aspect_ratio",
      "options": [
        { "value": "1", "label": "t:options.square" },
        { "value": "4 / 5", "label": "t:options.portrait" },
        { "value": "4 / 3", "label": "t:options.landscape" }
      ],
      "default": "1"
    },
    {
      "type": "checkbox",
      "id": "show_badge",
      "label": "t:settings.product_tile_show_badge",
      "default": true
    },
    {
      "type": "header",
      "content": "t:content.sticky_add_to_cart"
    },
    {
      "type": "checkbox",
      "id": "show_sticky_buy",
      "label": "t:settings.show_sticky_add_to_cart",
      "info": "t:info.show_sticky_add_to_cart",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "sticky_show_image",
      "label": "t:settings.show_image",
      "default": true,
      "visible_if": "{{ section.settings.show_sticky_buy }}"
    },
    {
      "type": "checkbox",
      "id": "sticky_show_rating",
      "label": "t:settings.product_tile_show_rating",
      "default": true,
      "visible_if": "{{ section.settings.show_sticky_buy }}"
    },
    {
      "type": "checkbox",
      "id": "sticky_show_sold",
      "label": "t:settings.show_sold_this_week",
      "default": true,
      "visible_if": "{{ section.settings.show_sticky_buy }}"
    },
    {
      "type": "checkbox",
      "id": "sticky_show_stock",
      "label": "t:settings.product_tile_show_stock",
      "default": true,
      "visible_if": "{{ section.settings.show_sticky_buy }}"
    },
    {
      "type": "text",
      "id": "sticky_in_stock_note",
      "label": "t:settings.in_stock_note",
      "default": "ships today",
      "visible_if": "{{ section.settings.show_sticky_buy and section.settings.sticky_show_stock }}"
    },
    {
      "type": "color",
      "id": "sticky_button_color",
      "label": "t:settings.button_color",
      "default": "{{ settings.color_palette.color3 }}",
      "visible_if": "{{ section.settings.show_sticky_buy }}"
    },
    {
      "type": "header",
      "content": "t:content.appearance"
    },
    {
      "type": "checkbox",
      "id": "sticky_info",
      "label": "t:settings.enable_sticky_content",
      "default": true
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "t:settings.background_color",
      "default": "{{ settings.color_palette.background }}"
    },
    {
      "type": "color",
      "id": "border_color",
      "label": "t:settings.border_color",
      "placeholder": "t:settings.default"
    },
    {
      "type": "header",
      "content": "t:content.padding"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "t:settings.top",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 24
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "t:settings.bottom",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 48
    }
  ],
  "presets": [
    {
      "name": "t:names.product_information",
      "blocks": {
        "title": { "type": "_product-title" },
        "meta": { "type": "_product-meta" },
        "price": { "type": "_product-price" },
        "variant_picker": { "type": "_product-variant-picker" },
        "purchase_options": { "type": "_product-purchase-options" },
        "volume_pricing": { "type": "_product-volume-pricing" },
        "gift_wrap": { "type": "_product-gift-wrap" },
        "free_gift": { "type": "_product-free-gift" },
        "usps": { "type": "_product-usps" },
        "shipping_countdown": { "type": "_product-shipping-countdown" },
        "back_in_stock": { "type": "_product-back-in-stock" },
        "buy": { "type": "_product-buy" }
      },
      "block_order": ["title", "meta", "price", "variant_picker", "buy", "back_in_stock", "purchase_options", "volume_pricing", "gift_wrap", "free_gift", "usps", "shipping_countdown"]
    }
  ]
}
{% endschema %}
