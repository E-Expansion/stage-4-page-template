{% comment %}
  Section contract.
  Site header: logo, search, localization, account and cart on the top row, with a
  navigation row of mega menu items and utility links underneath. On mobile the same
  navigation markup becomes an off-canvas sidebar opened from the menu button.
  Keeps `#header-component` and the `--header-height` / `--header-group-height`
  custom properties that layout scripts and sticky sections depend on.
  @example
  <!-- Header group > Header; add "Menu item" blocks with columns and links -->
{% endcomment %}

{% liquid
  assign show_language = section.settings.show_language
  if localization.available_languages.size <= 1
    assign show_language = false
  endif

  assign show_country = section.settings.show_country
  if localization.available_countries.size <= 1
    assign show_country = false
  endif

  assign show_localization = false
  if show_country or show_language
    assign show_localization = true
  endif

  assign show_account = false
  if section.settings.show_account and shop.customer_accounts_enabled
    assign show_account = true
  endif

  # Cart bubble text picks the palette extreme that contrasts with the chosen bubble color.
  if section.settings.cart_bubble_color != blank
    assign bubble_brightness = section.settings.cart_bubble_color | color_brightness
    if bubble_brightness > 128
      assign cart_bubble_text = 'var(--palette-darkest)'
    else
      assign cart_bubble_text = 'var(--palette-lightest)'
    endif
  endif

  assign nav_font_weight = section.settings.nav_font | replace: 'family', 'weight'
  assign panel_id = 'SiteHeaderPanel-' | append: section.id

  assign section_class = 'section section--' | append: section.settings.section_width
  if section.settings.section_width == 'full-width'
    assign section_class = section_class | append: ' section--full-width-margin'
  endif

  capture nav_blocks
    content_for 'blocks'
  endcapture
%}

<script type="application/ld+json">
  {
    "@context": "http://schema.org",
    "@type": "Organization",
    "name": {{ shop.name | json }},
    {% if settings.logo %}
      "logo": {{ settings.logo | image_url: width: 500 | prepend: "https:" | json }},
    {% endif %}
    "url": {{ request.origin | append: page.url | json }}
  }
</script>

<script
  src="{{ 'site-header.js' | asset_url }}"
  type="module"
></script>

{% render 'contrast-override',
  background_color: section.settings.background_color,
  text_color: section.settings.text_color,
  border_color: section.settings.divider_color,
  section_id: section.id
%}

<site-header-component
  id="header-component"
  class="site-header color-custom-{{ section.id }}"
  data-theme-color="rgb({{ section.settings.background_color.rgb | default: settings.page_background_color.rgb }})"
  {% if section.settings.enable_sticky_header %}
    data-sticky
  {% endif %}
  style="
    --site-header-nav-font-family: {{ section.settings.nav_font }};
    --site-header-nav-font-weight: {{ nav_font_weight }};
    --site-header-nav-font-size: {{ section.settings.nav_font_size }};
    --site-header-logo-size: {{ section.settings.logo_text_size }};
    --site-header-logo-size-mobile: {{ section.settings.logo_text_size_mobile }};
    --site-header-logo-height: {{ settings.logo_height }}px;
    --site-header-logo-height-mobile: {{ settings.logo_height_mobile }}px;
    --site-header-divider-width: {{ section.settings.divider_width }}px;
    {% if section.settings.cart_bubble_color != blank %}
      --cart-bubble-background: {{ section.settings.cart_bubble_color }};
      --cart-bubble-text: {{ cart_bubble_text }};
    {% endif %}
  "
>
  {%- if request.page_type == 'index' -%}
    <h1 class="visually-hidden">{{ shop.name }}</h1>
  {%- endif -%}

  <div class="{{ section_class }}">
    <div class="site-header__top">
      <button
        type="button"
        class="site-header__icon-button site-header__menu-button button-unstyled"
        ref="menuButton"
        aria-controls="{{ panel_id }}"
        aria-expanded="false"
        aria-label="{{ 'accessibility.menu' | t }}"
        on:click="/openDrawer"
      >
        <span
          class="svg-wrapper"
          aria-hidden="true"
        >
          {{- 'icon-menu.svg' | inline_asset_content -}}
        </span>
      </button>

      <a
        href="{{ routes.root_url }}"
        class="site-header__logo"
      >
        {%- if settings.logo -%}
          {%- liquid
            assign logo_width = settings.logo.aspect_ratio | times: settings.logo_height | round
            assign logo_alt = settings.logo.alt | default: shop.name
          -%}
          {{
            settings.logo
            | image_url: width: 600
            | image_tag:
              width: logo_width,
              height: settings.logo_height,
              alt: logo_alt,
              loading: 'eager',
              fetchpriority: 'high',
              class: 'site-header__logo-image'
          }}
        {%- else -%}
          <span class="site-header__logo-text">{{ shop.name | escape }}</span>
        {%- endif -%}
      </a>

      <div class="site-header__actions">
        {% if section.settings.show_search %}
          <form
            action="{{ routes.search_url }}"
            method="get"
            role="search"
            class="site-header__search mobile:hidden"
          >
            <label
              for="SiteHeaderSearch-{{ section.id }}"
              class="visually-hidden"
            >
              {{- 'content.search' | t -}}
            </label>
            <span
              class="svg-wrapper site-header__search-icon"
              aria-hidden="true"
            >
              {{- 'icon-search.svg' | inline_asset_content -}}
            </span>
            <input
              id="SiteHeaderSearch-{{ section.id }}"
              class="site-header__search-input"
              type="search"
              name="q"
              value="{{ search.terms | escape }}"
              placeholder="{{ section.settings.search_placeholder | escape }}"
              autocomplete="off"
            >
          </form>
        {% endif %}

        {% if show_localization %}
          <dropdown-localization-component class="site-header__localization dropdown-localization mobile:hidden">
            <button
              type="button"
              class="button site-header__localization-button"
              aria-expanded="false"
              aria-controls="dropdown-localization-results"
              ref="button"
              on:click="/toggleSelector"
            >
              {%- if show_country -%}
                <span
                  class="site-header__flag"
                  style="background-image: url({{- localization.country | image_url: width: 48 }});"
                ></span>
              {%- else -%}
                <span>{{ localization.language.iso_code | upcase }}</span>
              {%- endif -%}
              <span class="visually-hidden">
                {{- 'accessibility.localization_region_and_language' | t -}}
              </span>
              <span
                class="svg-wrapper icon-caret"
                aria-hidden="true"
              >
                {{- 'icon-caret.svg' | inline_asset_content -}}
              </span>
            </button>

            <div
              class="site-header__localization-panel color-custom-popover"
              hidden
              ref="panel"
            >
              {% render 'localization-form',
                show_country: show_country,
                show_language: show_language,
                localization_style: 'dropdown',
                form_id: section.id
              %}
            </div>
          </dropdown-localization-component>
        {% endif %}

        {% render 'header-actions',
          customer_account_menu: section.settings.customer_account_menu,
          display_style: 'icon',
          section: section
        %}
      </div>
    </div>
  </div>

  <div
    class="site-header__overlay"
    aria-hidden="true"
    on:click="/closeDrawer"
  ></div>

  <div
    id="{{ panel_id }}"
    class="site-header__panel"
    ref="panel"
    on:keydown="/handlePanelKeydown"
  >
    <div class="site-header__drawer-header">
      <button
        type="button"
        class="site-header__icon-button button-unstyled"
        aria-label="{{ 'actions.close' | t }}"
        on:click="/closeDrawer"
      >
        <span
          class="svg-wrapper"
          aria-hidden="true"
        >
          {{- 'icon-close.svg' | inline_asset_content -}}
        </span>
      </button>
    </div>

    {% if section.settings.show_search %}
      <form
        action="{{ routes.search_url }}"
        method="get"
        role="search"
        class="site-header__search site-header__drawer-only"
      >
        <label
          for="SiteHeaderDrawerSearch-{{ section.id }}"
          class="visually-hidden"
        >
          {{- 'content.search' | t -}}
        </label>
        <span
          class="svg-wrapper site-header__search-icon"
          aria-hidden="true"
        >
          {{- 'icon-search.svg' | inline_asset_content -}}
        </span>
        <input
          id="SiteHeaderDrawerSearch-{{ section.id }}"
          class="site-header__search-input"
          type="search"
          name="q"
          value="{{ search.terms | escape }}"
          placeholder="{{ section.settings.search_placeholder | escape }}"
          autocomplete="off"
        >
      </form>
    {% endif %}

    <nav
      class="site-header__nav {{ section_class }}"
      aria-label="{{ 'accessibility.header_navigation_label' | t }}"
    >
      <ul class="site-nav list-unstyled">
        {{ nav_blocks }}
      </ul>
    </nav>

    <div class="site-header__drawer-footer site-header__drawer-only">
      {% if show_account %}
        <a
          href="{{ routes.account_url }}"
          class="site-header__drawer-link"
        >
          {{- 'accessibility.account' | t -}}
        </a>
      {% endif %}

      {% if show_localization %}
        <details class="site-header__drawer-localization">
          <summary class="site-header__drawer-link">
            {%- if show_country -%}
              <span
                class="site-header__flag"
                style="background-image: url({{- localization.country | image_url: width: 48 }});"
              ></span>
              {{ localization.country.name }} ({{ localization.country.currency.iso_code }})
            {%- else -%}
              {{ localization.language.endonym_name }}
            {%- endif -%}
            <span
              class="svg-wrapper icon-caret"
              aria-hidden="true"
            >
              {{- 'icon-caret.svg' | inline_asset_content -}}
            </span>
          </summary>
          {% render 'localization-form',
            show_country: show_country,
            show_language: show_language,
            localization_style: 'drawer',
            form_id: section.id
          %}
        </details>
      {% endif %}
    </div>
  </div>
</site-header-component>

{% stylesheet %}
  .header-section {
    position: relative;
    z-index: var(--layer-menu-drawer);
  }

  #header-group:has(#header-component[data-sticky]) {
    display: contents;
  }

  .header-section:has(> #header-component[data-sticky]) {
    position: sticky;
    top: 0;
  }

  .site-header {
    --color-account-icon: currentColor;
    --account-offset-top: var(--header-height);
    --header-content-transition-timing: var(--animation-speed) var(--animation-easing);

    position: relative;
    display: block;
    background-color: var(--color-background);
    color: var(--color-foreground);
    border-block-end: var(--site-header-divider-width) solid var(--color-border);
  }

  .site-header__top {
    display: grid;
    grid-template-columns: auto 1fr auto;
    align-items: center;
    gap: var(--gap-md);
    min-height: var(--minimum-touch-target);
    padding-block: var(--padding-sm);

    @media screen and (min-width: 750px) {
      grid-template-columns: auto 1fr;
      padding-block: var(--padding-lg) var(--padding-2xs);
    }
  }

  .site-header__icon-button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: var(--button-size);
    height: var(--button-size);
    margin-inline-start: calc(var(--padding-sm) * -1);
    color: inherit;
    cursor: pointer;

    .svg-wrapper,
    svg {
      width: var(--icon-size-md);
      height: var(--icon-size-md);
    }
  }

  .site-header__menu-button {
    @media screen and (min-width: 750px) {
      display: none;
    }
  }

  .site-header__logo {
    display: inline-flex;
    align-items: center;
    min-width: 0;
    color: inherit;
    text-decoration: none;

    @media screen and (max-width: 749px) {
      justify-self: center;
    }
  }

  .site-header__logo-text {
    font-family: var(--font-heading--family);
    font-weight: var(--font-heading--weight);
    font-size: var(--site-header-logo-size-mobile);
    letter-spacing: var(--letter-spacing-sm);
    line-height: 1;
    text-transform: uppercase;
    white-space: nowrap;

    @media screen and (min-width: 750px) {
      font-size: var(--site-header-logo-size);
    }
  }

  .site-header__logo-image {
    width: auto;
    height: var(--site-header-logo-height-mobile);

    @media screen and (min-width: 750px) {
      height: var(--site-header-logo-height);
    }
  }

  .site-header__actions {
    display: flex;
    align-items: center;
    justify-content: flex-end;
    gap: var(--gap-lg);
    min-width: 0;

    @media screen and (max-width: 749px) {
      .account-button {
        display: none;
      }
    }
  }

  /* Header action buttons (account, cart) rendered by snippets/header-actions.liquid */
  .site-header .header-actions__action {
    --button-color: var(--color-foreground);

    display: flex;
    justify-content: center;
    color: var(--button-color);
    cursor: pointer;
    transition: opacity var(--animation-speed) var(--animation-easing);
  }

  .site-header .header-actions__action:not(.account-button) .svg-wrapper {
    width: var(--button-size);
    height: var(--button-size);
  }

  .site-header .header-actions__action:not(.account-button) svg {
    width: var(--icon-size-md);
    height: var(--icon-size-md);
  }

  @media (hover: hover) {
    .site-header .header-actions__action:hover {
      opacity: var(--opacity-subdued-text);
    }
  }

  .site-header__search {
    position: relative;
    display: flex;
    align-items: center;
    width: 100%;
    max-width: 10rem;
  }

  .site-header__search-icon {
    position: absolute;
    inset-inline-start: var(--padding-xs);
    width: var(--icon-size-sm);
    height: var(--icon-size-sm);
    color: var(--color-foreground-muted);
    pointer-events: none;
  }

  .site-header__search-input {
    width: 100%;
    min-width: 0;
    padding-block: var(--padding-xs);
    padding-inline: calc(var(--padding-xs) + var(--icon-size-sm) + var(--padding-2xs)) var(--padding-xs);
    font-family: var(--font-body--family);
    font-size: var(--font-size--xs);
    color: var(--color-input-text);
    background-color: var(--color-input-background);
    border: var(--style-border-width-inputs) solid var(--color-input-border);
    border-radius: var(--style-border-radius-inputs);

    &::placeholder {
      color: rgb(var(--color-input-text-rgb) / var(--opacity-50));
    }

    &::-webkit-search-cancel-button {
      display: none;
    }
  }

  /* Localization */
  .site-header__localization {
    position: relative;
  }

  .site-header__localization-button,
  .site-header__localization-button:hover {
    display: flex;
    align-items: center;
    gap: var(--gap-xs);
    padding-inline: var(--padding-2xs);
    color: inherit;
    background-color: transparent;
    border-color: transparent;
    box-shadow: none;
  }

  .site-header__localization-button .icon-caret {
    width: var(--icon-size-xs);
    height: var(--icon-size-xs);
    color: var(--color-foreground-muted);
    transition: transform var(--animation-speed) var(--animation-easing);
  }

  .site-header__localization-button[aria-expanded='true'] .icon-caret {
    transform: rotate(180deg);
  }

  .site-header__flag {
    display: inline-block;
    flex-shrink: 0;
    width: 1.75rem;
    height: 1.125rem;
    background-position: center;
    background-size: cover;
  }

  .site-header__localization-panel {
    position: absolute;
    inset-block-start: calc(100% + var(--gap-xs));
    inset-inline-end: 0;
    z-index: calc(var(--layer-header-menu) + 1);
    max-height: 27.5rem;
    background-color: var(--color-background);
    border: var(--style-border-popover);
    border-radius: var(--style-border-radius-popover);
    box-shadow: var(--shadow-popover);
    opacity: 0;
    translate: 0 var(--padding-lg);
    transition-property: display, opacity, translate;
    transition-duration: var(--animation-speed-slow);
    transition-timing-function: var(--ease-out-quad);
    transition-behavior: allow-discrete;

    &:not([hidden]) {
      opacity: 1;
      translate: 0 0;
    }

    .localization-form__list {
      max-height: 20.5rem;
    }

    .localization-form__list-item {
      margin-inline: var(--margin-xs);
    }
  }

  @starting-style {
    .site-header__localization-panel:not([hidden]) {
      opacity: 0;
      translate: 0 var(--padding-lg);
    }
  }

  /* Navigation row (desktop) / sidebar (mobile) */
  .site-header__overlay,
  .site-header__drawer-header,
  .site-header__drawer-only {
    display: none;
  }

  .site-nav {
    display: flex;
    margin: 0;
    font-family: var(--site-header-nav-font-family);
    font-weight: var(--site-header-nav-font-weight);
    font-size: var(--site-header-nav-font-size);
  }

  /* Shared by menu items and utility links */
  .site-nav__link {
    display: inline-flex;
    align-items: center;
    gap: var(--gap-xs);
    color: inherit;
    font: inherit;
    text-decoration: none;
    cursor: pointer;
    white-space: nowrap;

    @media screen and (min-width: 750px) {
      min-height: var(--minimum-touch-target);
    }

    @media screen and (max-width: 749px) {
      justify-content: space-between;
      width: 100%;
      min-height: var(--minimum-touch-target);
      padding-block: var(--padding-xs);
    }
  }

  @media (hover: hover) and (min-width: 750px) {
    .site-nav__item:hover > .site-nav__link {
      opacity: var(--opacity-subdued-text);
    }
  }

  @media screen and (max-width: 749px) {
    .site-nav__item {
      border-block-end: var(--style-border-width) solid var(--color-border);
    }
  }

  @media screen and (min-width: 750px) {
    .site-nav {
      align-items: center;
      column-gap: var(--gap-2xl);

      /* Pushes utility links to the inline end of the row */
      &::after {
        content: '';
        flex: 1;
        order: 1;
      }
    }
  }

  @media screen and (max-width: 749px) {
    .site-header__overlay {
      display: block;
      position: fixed;
      inset: 0;
      z-index: var(--layer-menu-drawer);
      background-color: rgb(var(--color-drawer-shadow-rgb) / var(--opacity-40));
      opacity: 0;
      visibility: hidden;
      transition: opacity var(--drawer-animation-speed) var(--animation-easing),
        visibility var(--drawer-animation-speed) var(--animation-easing);
    }

    .site-header__panel {
      position: fixed;
      inset-block: 0;
      inset-inline-start: 0;
      z-index: calc(var(--layer-menu-drawer) + 1);
      display: flex;
      flex-direction: column;
      gap: var(--gap-lg);
      width: min(85vw, 400px);
      padding: var(--drawer-padding);
      overflow-y: auto;
      overscroll-behavior: contain;
      background-color: var(--color-background);
      color: var(--color-foreground);
      box-shadow: var(--shadow-drawer);
      transform: translateX(-100%);
      visibility: hidden;
      transition: transform var(--drawer-animation-speed) var(--ease-out-cubic),
        visibility var(--drawer-animation-speed) var(--ease-out-cubic);

      &:dir(rtl) {
        transform: translateX(100%);
      }
    }

    .site-header[data-drawer-open] {
      .site-header__overlay {
        opacity: 1;
        visibility: visible;
      }

      .site-header__panel {
        transform: none;
        visibility: visible;
      }
    }

    .site-header__drawer-header {
      display: flex;
      justify-content: flex-start;
    }

    .site-header__drawer-only {
      display: flex;
    }

    .site-header__search.site-header__drawer-only {
      max-width: none;
    }

    .site-header__nav.section {
      display: block;
      padding: 0;
    }

    .site-nav {
      flex-direction: column;
    }

    .site-header__drawer-footer {
      flex-direction: column;
      margin-block-start: auto;
      padding-block-start: var(--padding-lg);
      border-block-start: var(--style-border-width) solid var(--color-border);
    }

    .site-header__drawer-link {
      display: flex;
      align-items: center;
      gap: var(--gap-xs);
      min-height: var(--minimum-touch-target);
      color: inherit;
      text-decoration: none;
      cursor: pointer;
      list-style: none;

      &::-webkit-details-marker {
        display: none;
      }

      .icon-caret {
        width: var(--icon-size-xs);
        height: var(--icon-size-xs);
        margin-inline-start: auto;
      }
    }

    .site-header__drawer-localization[open] .icon-caret {
      transform: rotate(180deg);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .site-header__panel,
    .site-header__overlay {
      transition: none;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:names.header",
  "tag": "header",
  "class": "header-section",
  "blocks": [
    {
      "type": "_header-nav-item"
    },
    {
      "type": "_header-utility-link"
    }
  ],
  "settings": [
    {
      "type": "header",
      "content": "t:content.logo"
    },
    {
      "type": "paragraph",
      "content": "t:info.header_logo_source"
    },
    {
      "type": "select",
      "id": "logo_text_size",
      "label": "t:settings.size",
      "options": [
        { "value": "1.25rem", "label": "20px" },
        { "value": "1.5rem", "label": "24px" },
        { "value": "1.75rem", "label": "28px" },
        { "value": "2rem", "label": "32px" }
      ],
      "default": "1.75rem",
      "visible_if": "{{ settings.logo == blank }}"
    },
    {
      "type": "select",
      "id": "logo_text_size_mobile",
      "label": "t:settings.size_mobile",
      "options": [
        { "value": "1.125rem", "label": "18px" },
        { "value": "1.25rem", "label": "20px" },
        { "value": "1.375rem", "label": "22px" },
        { "value": "1.5rem", "label": "24px" }
      ],
      "default": "1.375rem",
      "visible_if": "{{ settings.logo == blank }}"
    },
    {
      "type": "header",
      "content": "t:content.navigation"
    },
    {
      "type": "select",
      "id": "nav_font",
      "label": "t:settings.font",
      "options": [
        { "value": "var(--font-body--family)", "label": "t:options.body" },
        { "value": "var(--font-subheading--family)", "label": "t:options.subheading" },
        { "value": "var(--font-heading--family)", "label": "t:options.heading" },
        { "value": "var(--font-accent--family)", "label": "t:options.accent" }
      ],
      "default": "var(--font-body--family)"
    },
    {
      "type": "select",
      "id": "nav_font_size",
      "label": "t:settings.size",
      "options": [
        { "value": "0.75rem", "label": "12px" },
