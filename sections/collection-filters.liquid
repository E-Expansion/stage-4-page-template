{% comment %}
  Section contract.
  The collection's product grid with Shopify's storefront filters, sorting and pagination.
  Desktop: a filter card beside a toolbar (result count, sort select) and the grid, with
  numbered pagination. Mobile: a filter button that opens the same filters as a side panel,
  sort pills, and a "Load more" button that appends the next page.
  Filters are a plain GET form, so everything works without JavaScript; the script submits
  on change (desktop), runs the mobile panel, the price slider and "Load more".
  Values of a colour filter (label or parameter containing color/colour/kleur) show their
  swatch in place of the checkbox, with a ring when selected; active filter chips show it
  too. The colour is looked up by name in snippets/swatch-style.liquid, because Search &
  Discovery does not always pass the swatch on.
  Products render with the shared product-tile snippet. A promo block can sit at a chosen
  position on the first page.
  @example
  <!-- Collection template > Add section > Collection products -->
{% endcomment %}

{% liquid
  assign form_id = 'CollectionFiltersForm-' | append: section.id
  assign panel_id = 'CollectionFiltersPanel-' | append: section.id
  assign sort_by = collection.sort_by | default: collection.default_sort_by
  assign mobile_sort_values = section.settings.mobile_sort_options | split: ','

  # Active filter count and the query string that keeps filters when sorting via links
  assign active_count = 0
  assign filter_query = ''
  for filter in collection.filters
    if filter.type == 'price_range'
      if filter.min_value.value != null
        assign active_count = active_count | plus: 1
        assign min_whole = filter.min_value.value | divided_by: 100
        assign filter_query = filter_query | append: '&' | append: filter.min_value.param_name | append: '=' | append: min_whole
      endif
      if filter.max_value.value != null
        if filter.min_value.value == null
          assign active_count = active_count | plus: 1
        endif
        assign max_whole = filter.max_value.value | divided_by: 100
        assign filter_query = filter_query | append: '&' | append: filter.max_value.param_name | append: '=' | append: max_whole
      endif
    else
      assign active_count = active_count | plus: filter.active_values.size
      for value in filter.active_values
        assign escaped_value = value.value | url_param_escape
        assign filter_query = filter_query | append: '&' | append: value.param_name | append: '=' | append: escaped_value
      endfor
    endif
  endfor

  assign clear_url = collection.url | append: '?sort_by=' | append: sort_by

  assign accent = section.settings.accent_color
  if accent != blank
    assign accent_brightness = accent | color_brightness
    if accent_brightness > 128
      assign accent_text = 'var(--palette-darkest)'
    else
      assign accent_text = 'var(--palette-lightest)'
    endif
  endif
%}

<script
  src="{{ 'collection-filters.js' | asset_url }}"
  type="module"
  fetchpriority="low"
></script>

{% render 'contrast-override',
  background_color: section.settings.background_color,
  border_color: section.settings.border_color,
  section_id: section.id
%}

<div class="section-background color-custom-{{ section.id }}"></div>
<div
  class="collection-products section section--page-width spacing-style color-custom-{{ section.id }}"
  style="
    {% render 'spacing-padding', settings: section.settings %}
    --collection-columns: {{ section.settings.columns }};
    {% if accent != blank %}--collection-accent: {{ accent }}; --collection-accent-text: {{ accent_text }};{% endif %}
  "
>
  {% render 'listing-toolbar-styles' %}

  {% paginate collection.products by section.settings.products_per_page %}
    {% liquid
      assign page_size = collection.products.size
      assign first_item = paginate.current_offset | plus: 1
      assign last_item = paginate.current_offset | plus: page_size
      assign progress_percent = 0
      if paginate.items > 0
        assign progress_percent = last_item | times: 100 | divided_by: paginate.items
      endif
    %}

    <collection-filters-component
      class="collection-products__layout{% if section.settings.enable_filtering == false %} collection-products__layout--no-filters{% endif %}"
      data-section-id="{{ section.id }}"
    >
      {% if section.settings.enable_filtering %}
        <aside
          id="{{ panel_id }}"
          class="collection-filters"
          ref="panel"
          aria-label="{{ 'accessibility.filters' | t }}"
        >
          <form
            id="{{ form_id }}"
            class="collection-filters__form"
            action="{{ collection.url }}"
            method="get"
            ref="form"
            on:change="/handleChange"
            on:submit="/handleSubmit"
          >
            <div class="collection-filters__header">
              <h2 class="collection-filters__title">{{ 'actions.show_filters' | t }}</h2>
              {% if active_count > 0 %}
                <a
                  href="{{ clear_url }}"
                  class="collection-filters__clear"
                >
                  {{- 'actions.clear_all' | t -}}
                </a>
              {% endif %}
              <button
                type="button"
                class="collection-filters__close button-unstyled desktop:hidden"
                aria-label="{{ 'actions.close' | t }}"
                on:click="/closeFilters"
              >
                <span
                  class="svg-wrapper"
                  aria-hidden="true"
                >
                  {{- 'icon-close.svg' | inline_asset_content -}}
                </span>
              </button>
            </div>

            {% if active_count > 0 %}
              <ul
                class="collection-filters__active list-unstyled"
                aria-label="{{ 'accessibility.active_filters' | t }}"
              >
                {% for filter in collection.filters %}
                  {% if filter.type == 'price_range' %}
                    {% if filter.min_value.value != null or filter.max_value.value != null %}
                      {% liquid
                        assign chip_min = filter.min_value.value | default: 0 | money_without_trailing_zeros
                        assign chip_max = filter.max_value.value | default: filter.range_max | money_without_trailing_zeros
                        assign chip_label = chip_min | append: ' – ' | append: chip_max | strip_html
                      %}
                      <li>
                        <a
                          href="{{ filter.url_to_remove }}"
                          class="collection-filters__chip"
                          aria-label="{{ 'accessibility.remove_item' | t: title: chip_label }}"
                        >
                          {{- chip_label }}
                          <span aria-hidden="true">×</span>
                        </a>
                      </li>
                    {% endif %}
                  {% else %}
                    {% for value in filter.active_values %}
                      <li>
                        <a
                          href="{{ value.url_to_remove }}"
                          class="collection-filters__chip"
                          aria-label="{{ 'accessibility.remove_item' | t: title: value.label }}"
                        >
                          {%- liquid
                            assign chip_swatch_style = blank
                            assign chip_filter_name = filter.label | append: ' ' | append: filter.param_name | downcase
                            if chip_filter_name contains 'color' or chip_filter_name contains 'colour' or chip_filter_name contains 'kleur'
                              capture chip_swatch_style
                                render 'swatch-style', name: value.label, swatch: value.swatch
                              endcapture
                            endif
                          -%}
                          {%- if chip_swatch_style != blank -%}
                            <span
                              class="collection-filters__swatch collection-filters__swatch--small"
                              style="{{ chip_swatch_style }}"
                              aria-hidden="true"
                            ></span>
                          {%- endif -%}
                          {{- value.label | escape }}
                          <span aria-hidden="true">×</span>
                        </a>
                      </li>
                    {% endfor %}
                  {% endif %}
                {% endfor %}
              </ul>
            {% endif %}

            {% for filter in collection.filters %}
              {% liquid
                assign filter_label = filter.label | escape
                assign filter_name = filter.label | append: ' ' | append: filter.param_name | downcase
                assign is_color_filter = false
                if filter_name contains 'color' or filter_name contains 'colour' or filter_name contains 'kleur'
                  assign is_color_filter = true
                endif
              %}
              <fieldset class="collection-filters__group">
                <legend class="collection-filters__legend">{{ filter_label }}</legend>

                {% if filter.type == 'price_range' %}
                  {% liquid
                    assign range_max = filter.range_max | divided_by: 100.0 | ceil
                    assign current_min = filter.min_value.value | default: 0 | divided_by: 100
                    assign current_max = filter.max_value.value | default: filter.range_max | divided_by: 100.0 | ceil
                    if range_max > 0
                      assign start_fraction = current_min | times: 1.0 | divided_by: range_max
                      assign end_fraction = current_max | times: 1.0 | divided_by: range_max
                    else
                      assign start_fraction = 0
                      assign end_fraction = 1
                    endif
                    assign min_id = 'PriceMin-' | append: section.id
                    assign max_id = 'PriceMax-' | append: section.id
                  %}
                  <div
                    class="price-range"
                    style="--price-range-start: {{ start_fraction }}; --price-range-end: {{ end_fraction }};"
                  >
                    {% comment %}
                      The number fields carry the filter values, so typing works and the
                      filter works without JavaScript. The sliders only drive them.
                    {% endcomment %}
                    <div
                      class="price-range__track"
                      aria-hidden="true"
                    >
                      <span class="price-range__fill"></span>
                      <span class="price-range__thumb price-range__thumb--min"></span>
                      <span class="price-range__thumb price-range__thumb--max"></span>
                      <input
                        type="range"
                        class="price-range__slider"
                        min="0"
                        max="{{ range_max }}"
                        step="1"
                        value="{{ current_min }}"
                        tabindex="-1"
                        data-bound="min"
                        {% if start_fraction > 0.5 %}
                          data-raised
                        {% endif %}
                        on:input="/updatePriceRange"
                      >
                      <input
                        type="range"
                        class="price-range__slider"
                        min="0"
                        max="{{ range_max }}"
                        step="1"
                        value="{{ current_max }}"
                        tabindex="-1"
                        data-bound="max"
                        on:input="/updatePriceRange"
                      >
                    </div>

                    <div class="price-range__fields">
                      <label
                        class="price-range__field"
                        for="{{ min_id }}"
                      >
                        <span class="visually-hidden">{{ 'accessibility.price_filter_low' | t }}</span>
                        <span aria-hidden="true">{{ cart.currency.symbol }}</span>
                        <input
                          id="{{ min_id }}"
                          type="number"
                          class="price-range__number"
                          name="{{ filter.min_value.param_name }}"
                          min="0"
                          max="{{ range_max }}"
                          step="1"
                          inputmode="numeric"
                          value="{{ current_min }}"
                          data-bound="min"
                          on:input="/updatePriceRange"
                        >
                      </label>
                      <span
                        class="price-range__separator"
                        aria-hidden="true"
                      >–</span>
                      <label
                        class="price-range__field"
                        for="{{ max_id }}"
                      >
                        <span class="visually-hidden">{{ 'accessibility.price_filter_high' | t }}</span>
                        <span aria-hidden="true">{{ cart.currency.symbol }}</span>
                        <input
                          id="{{ max_id }}"
                          type="number"
                          class="price-range__number"
                          name="{{ filter.max_value.param_name }}"
                          min="0"
                          max="{{ range_max }}"
                          step="1"
                          inputmode="numeric"
                          value="{{ current_max }}"
                          data-bound="max"
                          on:input="/updatePriceRange"
                        >
                      </label>
                    </div>
                  </div>
                {% else %}
                  <ul class="collection-filters__options list-unstyled">
                    {% for value in filter.values %}
                      {% liquid
                        assign input_id = 'Filter-' | append: section.id | append: '-' | append: filter.param_name | append: '-' | append: forloop.index | handleize
                        assign is_disabled = false
                        if value.count == 0 and value.active == false
                          assign is_disabled = true
                        endif

                        # Colour values get the swatch of their colour, as on the product tiles
                        assign swatch_style = blank
                        if is_color_filter
                          capture swatch_style
                            render 'swatch-style', name: value.label, swatch: value.swatch
                          endcapture
                        endif
                        assign has_swatch = false
                        if swatch_style != blank
                          assign has_swatch = true
                        endif
                      %}
                      <li class="collection-filters__option{% if is_disabled %} collection-filters__option--disabled{% endif %}">
                        <input
                          type="checkbox"
                          id="{{ input_id }}"
                          class="collection-filters__checkbox{% if has_swatch %} visually-hidden-input{% endif %}"
                          name="{{ value.param_name }}"
                          value="{{ value.value }}"
                          {% if value.active %}
                            checked
                          {% endif %}
                          {% if is_disabled %}
                            disabled
                          {% endif %}
                        >
                        <label
                          for="{{ input_id }}"
                          class="collection-filters__label"
                        >
                          {%- if has_swatch -%}
                            <span
                              class="collection-filters__swatch"
                              style="{{ swatch_style }}"
                              aria-hidden="true"
                            ></span>
                          {%- endif -%}
                          {{- value.label | escape -}}
                        </label>
                        <span class="collection-filters__count">{{ value.count }}</span>
                      </li>
                    {% endfor %}
                  </ul>
                {% endif %}
              </fieldset>
            {% endfor %}

            <div class="collection-filters__footer">
              <button
                type="submit"
                class="button collection-filters__submit"
              >
                {{- 'actions.apply' | t -}}
              </button>
            </div>
          </form>
        </aside>
        <div
          class="collection-filters__backdrop"
          on:click="/closeFilters"
        ></div>
      {% endif %}

      <div class="collection-products__main">
        <div class="listing-toolbar">
          {% if section.settings.enable_filtering %}
            <button
              type="button"
              class="listing-toolbar__filter button-unstyled desktop:hidden"
              aria-controls="{{ panel_id }}"
              aria-expanded="false"
              ref="filterButton"
              on:click="/openFilters"
            >
              <span
                class="svg-wrapper"
                aria-hidden="true"
              >
                {{- 'icon-filter.svg' | inline_asset_content -}}
              </span>
              {{ 'actions.show_filters' | t }}
              {% if active_count > 0 %}
                <span class="listing-toolbar__badge">{{ active_count }}</span>
                <span class="visually-hidden">{{ 'accessibility.filter_count' | t: count: active_count }}</span>
              {% endif %}
            </button>
          {% endif %}

          {% if section.settings.show_sort and mobile_sort_values.size > 0 %}
            <ul class="listing-toolbar__pills list-unstyled desktop:hidden">
              {% for option in collection.sort_options %}
                {% assign option_value = option.value %}
                {% for wanted in mobile_sort_values %}
                  {% assign wanted_value = wanted | strip %}
                  {% if wanted_value == option_value %}
                    <li>
                      <a
                        href="{{ collection.url }}?sort_by={{ option.value }}{{ filter_query }}"
                        class="listing-toolbar__pill"
                        {% if option.value == sort_by %}
                          aria-current="true"
                        {% endif %}
                      >
                        {{- option.name | escape -}}
                      </a>
                    </li>
                  {% endif %}
                {% endfor %}
              {% endfor %}
            </ul>
          {% endif %}

          <p class="listing-toolbar__count">
            {% if paginate.items > 0 %}
              {{ 'content.showing_range_html' | t: start: first_item, end: last_item, total: paginate.items }}
            {% else %}
              {{ 'content.no_products_found' | t }}
            {% endif %}
          </p>

          {% if section.settings.show_sort %}
            <div class="listing-toolbar__sort mobile:hidden">
              <label
                for="SortBy-{{ section.id }}"
                class="listing-toolbar__sort-label"
              >
                {{- 'content.sort_by' | t -}}
              </label>
              <div class="listing-toolbar__select-wrapper">
                <select
                  id="SortBy-{{ section.id }}"
                  class="listing-toolbar__select"
                  name="sort_by"
                  {% if section.settings.enable_filtering %}
                    form="{{ form_id }}"
                  {% endif %}
                  on:change="/handleSortChange"
                >
                  {% for option in collection.sort_options %}
                    <option
                      value="{{ option.value }}"
                      {% if option.value == sort_by %}
                        selected
                      {% endif %}
                    >
                      {{- option.name | escape -}}
                    </option>
                  {% endfor %}
                </select>
                <span
                  class="svg-wrapper listing-toolbar__caret"
                  aria-hidden="true"
                >
                  {{- 'icon-caret.svg' | inline_asset_content -}}
                </span>
              </div>
            </div>
          {% endif %}
        </div>

        {% if collection.products.size > 0 %}
          <ul
            class="collection-products__grid list-unstyled"
            ref="grid"
            data-collection-grid
          >
            {% for product in collection.products %}
              {% liquid
                assign eager = false
                if forloop.index <= 3 and paginate.current_page == 1
                  assign eager = true
                endif
              %}
              {% render 'product-tile',
                product: product,
                section_id: section.id,
                sizes: '(min-width: 990px) 25vw, (min-width: 750px) 33vw, 50vw',
                eager: eager
              %}
              {% if paginate.current_page == 1 and forloop.index == section.settings.promo_position %}
                {% content_for 'blocks' %}
              {% endif %}
            {% endfor %}
          </ul>
        {% else %}
          <div class="collection-products__empty">
            <p>{{ 'content.no_products_found' | t }}</p>
            {% if active_count > 0 %}
              <a
                href="{{ clear_url }}"
                class="button"
              >
                {{- 'actions.clear_all' | t -}}
              </a>
            {% endif %}
          </div>
        {% endif %}

        {% comment %}
          Always shown when there are products, so shoppers see how many there are; the
          page buttons just stay disabled on a single page.
        {% endcomment %}
        {% if paginate.items > 0 %}
          <nav
            class="listing-pagination"
            aria-label="{{ 'content.pagination.nav_label' | t }}"
            data-listing-pagination
          >
            <p
              class="listing-pagination__progress-text"
              data-progress-text
            >
              {{ 'content.products_shown' | t: shown: last_item, total: paginate.items }}
            </p>
            <div
              class="listing-pagination__bar"
              aria-hidden="true"
            >
              <span
                class="listing-pagination__bar-fill"
                style="width: {{ progress_percent }}%;"
                data-progress-bar
              ></span>
            </div>

            <ul class="listing-pagination__pages list-unstyled mobile:hidden">
              <li>
                {% if paginate.previous %}
                  <a
                    href="{{ paginate.previous.url }}"
                    class="listing-pagination__step"
                  >
                    {{- 'content.pagination.previous' | t -}}
                  </a>
                {% else %}
                  <span class="listing-pagination__step listing-pagination__step--disabled">
                    {{- 'content.pagination.previous' | t -}}
                  </span>
                {% endif %}
              </li>
              {% if paginate.pages <= 1 %}
                <li>
                  <span
                    class="listing-pagination__page listing-pagination__page--current"
                    aria-current="page"
                  >
                    1
                  </span>
                </li>
              {% else %}
                {% for part in paginate.parts %}
                  <li>
                    {% if part.is_link %}
                      <a
                        href="{{ part.url }}"
                        class="listing-pagination__page"
                        aria-label="{{ 'content.pagination.page' | t: page: part.title }}"
                      >
                        {{- part.title -}}
                      </a>
                    {% elsif part.title != '&hellip;' %}
                      <span
                        class="listing-pagination__page listing-pagination__page--current"
                        aria-current="page"
                      >
                        {{- part.title -}}
                      </span>
                    {% else %}
                      <span class="listing-pagination__gap">{{ part.title }}</span>
                    {% endif %}
                  </li>
                {% endfor %}
              {% endif %}
              <li>
                {% if paginate.next %}
                  <a
                    href="{{ paginate.next.url }}"
                    class="listing-pagination__step"
                  >
                    {{- 'content.pagination.next' | t -}}
                  </a>
                {% else %}
                  <span class="listing-pagination__step listing-pagination__step--disabled">
                    {{- 'content.pagination.next' | t -}}
                  </span>
                {% endif %}
              </li>
            </ul>

            {% if paginate.next %}
              <a
                href="{{ paginate.next.url }}"
                class="listing-pagination__more desktop:hidden"
                ref="loadMore"
                on:click="/loadMore"
                data-load-more
              >
                {{- 'actions.load_more' | t -}}
              </a>
            {% endif %}
          </nav>
        {% endif %}
      </div>
    </collection-filters-component>
  {% endpaginate %}
</div>

{% stylesheet %}
  .collection-products__layout {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--gap-lg);
    align-items: start;

    @media screen and (min-width: 750px) {
      grid-template-columns: var(--collection-sidebar-width) minmax(0, 1fr);
    }
  }

  .collection-products__layout--no-filters {
    grid-template-columns: minmax(0, 1fr);
  }

  .collection-products__main {
    display: flex;
    flex-direction: column;
    gap: var(--gap-lg);
    min-width: 0;
  }

  /* Filter card on desktop, side panel on mobile */
  .collection-filters {
    background-color: var(--color-background);

    @media screen and (min-width: 750px) {
      border: var(--style-border-width) solid var(--color-border);
      border-radius: var(--style-border-radius-xs);
    }

    @media screen and (max-width: 749px) {
      position: fixed;
      inset-block: 0;
      inset-inline-start: 0;
      z-index: var(--layer-menu-drawer);
      width: min(22rem, 88vw);
      overflow-y: auto;
      overscroll-behavior: contain;
      transform: translateX(-100%);
      visibility: hidden;
      transition: transform var(--animation-speed) var(--animation-easing),
        visibility 0s linear var(--animation-speed);
    }
  }

  /* The backdrop only exists while the mobile panel is open, so it never takes a grid cell */
  .collection-filters__backdrop {
    display: none;
  }

  @media screen and (max-width: 749px) {
    [data-filters-open] .collection-filters {
      transform: none;
      visibility: visible;
      transition: transform var(--animation-speed) var(--animation-easing);
    }

    [data-filters-open] .collection-filters__backdrop {
      display: block;
      position: fixed;
      inset: 0;
      z-index: calc(var(--layer-menu-drawer) - 1);
      background-color: rgb(var(--color-foreground-rgb) / var(--opacity-30));
    }
  }

  .collection-filters__form {
    display: flex;
    flex-direction: column;
    gap: var(--gap-md);
    padding: var(--padding-lg) var(--padding-md);
  }

  .collection-filters__header {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--gap-sm);
  }

  .collection-filters__title {
    margin: 0;
    margin-inline-end: auto;
    font-family: var(--font-body--family);
    font-weight: var(--font-body--weight);
    font-size: var(--font-size--md);
  }

  .collection-filters__clear {
    font-size: var(--font-size--xs);
    color: var(--collection-accent, var(--color-foreground));
    text-decoration: none;

    &:hover {
      text-decoration: underline;
    }
  }

  .collection-filters__close {
    align-self: center;
    width: var(--icon-size-md);
    height: var(--icon-size-md);
    color: var(--color-foreground);
  }

  .collection-filters__active {
    display: flex;
    flex-wrap: wrap;
    gap: var(--gap-2xs);
    margin: 0;
  }

  .collection-filters__chip {
    display: inline-flex;
    align-items: center;
    gap: var(--gap-2xs);
    padding: var(--padding-3xs) var(--padding-xs);
    font-size: var(--font-size--3xs);
    color: var(--color-background);
    text-decoration: none;
    background-color: var(--color-foreground);
    border-radius: var(--style-border-radius-xs);
  }

  .collection-filters__group {
    min-width: 0;
    margin: 0;
    padding: var(--padding-md) 0 0;
    border: 0;
    border-block-start: var(--style-border-width) solid var(--color-border);
  }

  .collection-filters__legend {
    float: left;
    width: 100%;
    margin-block-end: var(--padding-sm);
    padding: 0;
    font-size: var(--font-size--2xs);
    letter-spacing: var(--letter-spacing-sm);
    text-transform: uppercase;
    color: var(--color-foreground);
  }

  .collection-filters__options {
    clear: both;
    display: flex;
    flex-direction: column;
    gap: var(--gap-2xs);
    margin: 0;
  }

  .collection-filters__option {
    display: flex;
    align-items: center;
    gap: var(--gap-xs);
    font-size: var(--font-size--xs);
  }

  .collection-filters__option--disabled {
    opacity: var(--disabled-opacity);
  }

  .collection-filters__checkbox {
    flex-shrink: 0;
    width: 0.875rem;
    height: 0.875rem;
    margin: 0;
    accent-color: var(--color-foreground);
  }

  .collection-filters__label {
    display: flex;
    align-items: center;
    gap: var(--gap-xs);
    flex-grow: 1;
    min-width: 0;
    cursor: pointer;
    overflow-wrap: anywhere;
  }

  /* Colour swatch in place of the checkbox; a ring shows it is selected (as on product tiles) */
  .collection-filters__swatch {
    --collection-filters-swatch-size: 1.125rem;

    flex-shrink: 0;
    width: var(--collection-filters-swatch-size);
    height: var(--collection-filters-swatch-size);
    background-color: var(--swatch-color, rgb(var(--color-foreground-rgb) / var(--opacity-20)));
    background-image: var(--swatch-image, none);
    background-position: center;
    background-size: cover;
    border: 1px solid rgb(var(--color-foreground-rgb) / var(--opacity-10));
    border-radius: 50%;
    transition: box-shadow var(--animation-speed) var(--animation-easing);
  }

  .collection-filters__swatch--small {
    --collection-filters-swatch-size: 0.625rem;

    border-color: rgb(var(--color-background-rgb) / var(--opacity-30));
  }

  .collection-filters__label:hover .collection-filters__swatch {
    box-shadow: 0 0 0 2px var(--color-background), 0 0 0 3px rgb(var(--color-foreground-rgb) / var(--opacity-30));
  }

  .collection-filters__checkbox:checked + .collection-filters__label {
    color: var(--color-foreground);
    font-weight: 600;
  }

  .collection-filters__checkbox:checked + .collection-filters__label .collection-filters__swatch {
    box-shadow: 0 0 0 2px var(--color-background), 0 0 0 3px var(--color-foreground);
  }

  .collection-filters__checkbox:focus-visible + .collection-filters__label .collection-filters__swatch {
    outline: var(--focus-outline-width) solid var(--color-foreground);
    outline-offset: 4px;
  }

  .collection-filters__count {
    font-size: var(--font-size--2xs);
    color: var(--color-foreground-muted);
  }

  /* Without JavaScript the apply button shows on every screen size */
  .collection-filters__footer {
    position: sticky;
    inset-block-end: 0;
    padding-block: var(--padding-sm) 0;
    background-color: var(--color-background);
  }

  .collection-filters__submit {
    width: 100%;
    justify-content: center;
  }

  @media screen and (min-width: 750px) {
    collection-filters-component[data-enhanced] .collection-filters__footer {
      display: none;
    }
  }

  /* Price slider: the line, fill and thumbs are drawn here; two transparent range
     inputs on top handle dragging. Positions come from --price-range-start/-end (0-1). */
  .price-range {
    --price-range-thumb: 0.875rem;

    clear: both;
    display: flex;
    flex-direction: column;
    gap: var(--gap-sm);
  }

  .price-range__track {
    position: relative;
    height: var(--price-range-thumb);
    margin-inline: 0;

    &::before {
      content: '';
      position: absolute;
      inset-inline: calc(var(--price-range-thumb) / 2);
      inset-block-start: 50%;
      height: 2px;
      background-color: var(--color-border);
      transform: translateY(-50%);
    }
  }

  .price-range__fill {
    position: absolute;
    inset-block-start: 50%;
    inset-inline-start: calc(
      var(--price-range-thumb) / 2 + (100% - var(--price-range-thumb)) * var(--price-range-start)
    );
    width: calc((100% - var(--price-range-thumb)) * (var(--price-range-end) - var(--price-range-start)));
    height: 2px;
    background-color: var(--collection-accent, var(--color-foreground));
    transform: translateY(-50%);
  }

  .price-range__thumb {
    position: absolute;
    inset-block-start: 0;
    width: var(--price-range-thumb);
    height: var(--price-range-thumb);
    background-color: var(--color-background);
    border: 1px solid var(--collection-accent, var(--color-foreground));
    border-radius: 50%;
    pointer-events: none;
  }

  .price-range__thumb--min {
    inset-inline-start: calc((100% - var(--price-range-thumb)) * var(--price-range-start));
  }

  .price-range__thumb--max {
    inset-inline-start: calc((100% - var(--price-range-thumb)) * var(--price-range-end));
  }

  /* Invisible sliders: only their thumbs catch the pointer */
  .price-range__slider {
    position: absolute;
    inset: 0;
    z-index: 1;
    width: 100%;
    height: 100%;
    margin: 0;
    opacity: 0;
    pointer-events: none;
    appearance: none;

    &::-webkit-slider-thumb {
      width: var(--price-range-thumb);
      height: var(--price-range-thumb);
      cursor: pointer;
      pointer-events: auto;
      appearance: none;
    }

    &::-moz-range-thumb {
      width: var(--price-range-thumb);
      height: var(--price-range-thumb);
      border: 0;
      cursor: pointer;
      pointer-events: auto;
    }
  }

  .price-range__slider[data-raised] {
    z-index: 2;
  }

  .price-range__fields {
    display: flex;
    align-items: center;
    gap: var(--gap-xs);
  }

  .price-range__field {
    display: flex;
    flex: 1 1 0;
    align-items: center;
    gap: var(--padding-3xs);
    min-width: 0;
    padding: var(--padding-3xs) var(--padding-xs);
    font-size: var(--font-size--2xs);
    color: var(--color-foreground-muted);
    background-color: var(--color-input-background);
    border: var(--style-border-width-inputs) solid var(--color-input-border);
    border-radius: var(--style-border-radius-inputs);
    cursor: text;

    &:focus-within {
      border-color: var(--collection-accent, var(--color-foreground));
    }
  }

  .price-range__number {
    width: 100%;
    min-width: 0;
    padding: 0;
    font-family: var(--font-body--family);
    font-size: var(--font-size--xs);
    color: var(--color-input-text);
    background: none;
    border: 0;
    outline: none;
    appearance: textfield;

    &::-webkit-inner-spin-button,
    &::-webkit-outer-spin-button {
      margin: 0;
      appearance: none;
    }
  }

  .price-range__separator {
    font-size: var(--font-size--xs);
    color: var(--color-foreground-muted);
  }

  /* Grid */
  .collection-products__grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--gap-sm);
    margin: 0;

    @media screen and (min-width: 750px) {
      grid-template-columns: repeat(var(--collection-columns), minmax(0, 1fr));
      gap: var(--gap-md);
    }
  }

  .collection-products__empty {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--gap-md);
    padding: var(--padding-2xl);
    background-color: var(--color-background);
    border: var(--style-border-width) solid var(--color-border);
    border-radius: var(--style-border-radius-xs);

    p {
      margin: 0;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .collection-filters {
      transition: none;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:names.collection_products",
  "blocks": [
    {
      "type": "_collection-promo"
    }
  ],
  "max_blocks": 1,
  "settings": [
    {
      "type": "range",
      "id": "products_per_page",
      "label": "t:settings.products_per_page",
      "min": 4,
      "max": 48,
      "step": 1,
      "default": 8
    },
    {
      "type": "range",
      "id": "columns",
      "label": "t:settings.columns",
      "min": 2,
      "max": 4,
      "step": 1,
      "default": 3
    },
    {
      "type": "range",
      "id": "promo_position",
      "label": "t:settings.promo_position",
      "info": "t:info.collection_promo_position",
      "min": 1,
      "max": 24,
      "step": 1,
      "default": 5
    },
    {
      "type": "header",
      "content": "t:names.filters"
    },
    {
      "type": "checkbox",
      "id": "enable_filtering",
      "label": "t:settings.enable_filtering",
      "info": "t:info.enable_filtering_info",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_sort",
      "label": "t:settings.enable_sorting",
      "default": true
    },
    {
      "type": "text",
      "id": "mobile_sort_options",
      "label": "t:settings.mobile_sort_options",
      "info": "t:info.collection_mobile_sort",
      "default": "manual, created-descending, price-ascending, price-descending"
    },
    {
      "type": "header",
      "content": "t:content.appearance"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "t:settings.background_color",
      "default": "{{ settings.color_palette.background }}"
    },
    {
      "type": "color",
      "id": "border_color",
      "label": "t:settings.border_color",
      "placeholder": "t:settings.default"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "t:settings.accent_color",
      "info": "t:info.collection_accent",
      "default": "{{ settings.color_palette.color3 }}"
    },
    {
      "type": "header",
      "content": "t:content.padding"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "t:settings.top",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 16
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "t:settings.bottom",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 48
    }
  ],
  "presets": [
    {
      "name": "t:names.collection_products"
    }
  ]
}
{% endschema %}
