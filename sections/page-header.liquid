{% comment %}
  Section contract.
  Page intro for listing pages, using the shared page-heading snippet: breadcrumbs, the
  page title and a short description.
  Title and description are read from the current collection, blog or page, so one
  template serves every collection or blog. The section's own title and text are used
  when set (title) or when the resource has no description (text). Blogs have no
  description field in Shopify, so they read the custom.subtitle metafield instead.
  Collections can also show their product count on mobile.
  @example
  <!-- Collection or blog template > Add section > Page header -->
{% endcomment %}

{% liquid
  case template.name
    when 'collection'
      assign resource_title = collection.title
      assign resource_description = collection.description
    when 'blog'
      assign resource_title = blog.title
      assign resource_description = blog.metafields.custom.subtitle.value | escape
    when 'page'
      assign resource_title = page.title
    else
      assign resource_title = page_title
  endcase

  assign title = section.settings.title | default: resource_title
  assign description = resource_description
  if description == blank
    assign description = section.settings.text
  endif

  if section.settings.show_product_count and template.name == 'collection'
    assign count_label = 'content.item_count' | t: count: collection.products_count
  endif
%}

{% render 'contrast-override',
  background_color: section.settings.background_color,
  section_id: section.id
%}

<div class="section-background color-custom-{{ section.id }}"></div>
<div
  class="page-header section section--page-width spacing-style color-custom-{{ section.id }}"
  style="{% render 'spacing-padding', settings: section.settings %}"
>
  {% render 'page-heading',
    title: title,
    text: description,
    show_breadcrumbs: section.settings.show_breadcrumbs,
    parent_label: section.settings.parent_label,
    parent_url: section.settings.parent_link,
    count: count_label
  %}
</div>

{% schema %}
{
  "name": "t:names.page_header",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "t:settings.heading",
      "info": "t:info.page_header_title"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "t:settings.text",
      "info": "t:info.page_header_text"
    },
    {
      "type": "checkbox",
      "id": "show_product_count",
      "label": "t:settings.show_product_count",
      "default": true
    },
    {
      "type": "header",
      "content": "t:content.breadcrumbs"
    },
    {
      "type": "checkbox",
      "id": "show_breadcrumbs",
      "label": "t:settings.show_breadcrumbs",
      "default": true
    },
    {
      "type": "text",
      "id": "parent_label",
      "label": "t:settings.parent_label",
      "info": "t:info.page_header_parent"
    },
    {
      "type": "url",
      "id": "parent_link",
      "label": "t:settings.link"
    },
    {
      "type": "header",
      "content": "t:content.appearance"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "t:settings.background_color",
      "default": "{{ settings.color_palette.background }}"
    },
    {
      "type": "header",
      "content": "t:content.padding"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "t:settings.top",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 24
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "t:settings.bottom",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 24
    }
  ],
  "presets": [
    {
      "name": "t:names.page_header"
    }
  ]
}
{% endschema %}
