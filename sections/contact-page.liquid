{% comment %}
  Section contract.
  Simple contact section for the contact page: a short intro with contact details beside
  a form card on desktop, stacked on mobile. Submits Shopify's contact form, so messages
  arrive at the store's sender email (Settings > Notifications). The intro falls back to
  the page's own content when the text setting is empty. Shows a confirmation after a
  successful send and Shopify's field errors otherwise.
  @example
  <!-- Contact page template > Contact form; fill in email, phone and opening hours -->
{% endcomment %}

{% liquid
  assign heading = section.settings.heading | escape
  assign intro = section.settings.text
  if intro == blank
    assign intro = page.content
  endif
  assign button_label = section.settings.button_label | escape
  if button_label == blank
    assign button_label = 'actions.submit' | t
  endif
  assign success_text = section.settings.success_text | escape
  if success_text == blank
    assign success_text = 'blocks.contact_form.post_success' | t
  endif
  assign form_id = 'ContactPage-' | append: section.id
  assign email = section.settings.email | default: shop.email
  assign phone = section.settings.phone
  assign phone_link = phone | remove: ' ' | remove: '-' | remove: '(' | remove: ')'
%}

{% render 'contrast-override',
  background_color: section.settings.background_color,
  border_color: section.settings.border_color,
  section_id: section.id
%}

<div class="section-background color-custom-{{ section.id }}"></div>
<div
  class="contact-page section section--page-width spacing-style color-custom-{{ section.id }}"
  style="{% render 'spacing-padding', settings: section.settings %}"
>
  <div class="contact-page__layout">
    <div class="contact-page__intro">
      {% if heading != blank %}
        <h2 class="contact-page__heading">{{ heading }}</h2>
      {% endif %}
      {% if intro != blank %}
        <div class="contact-page__text rte">{{ intro }}</div>
      {% endif %}

      {% if email != blank or phone != blank or section.settings.hours != blank %}
        <dl class="contact-page__details">
          {% if email != blank %}
            <div class="contact-page__detail">
              <dt>{{ 'blocks.contact_form.email' | t }}</dt>
              <dd>
                <a href="mailto:{{ email | escape }}">{{ email | escape }}</a>
              </dd>
            </div>
          {% endif %}
          {% if phone != blank %}
            <div class="contact-page__detail">
              <dt>{{ 'blocks.contact_form.phone' | t }}</dt>
              <dd>
                <a href="tel:{{ phone_link | escape }}">{{ phone | escape }}</a>
              </dd>
            </div>
          {% endif %}
          {% if section.settings.hours != blank %}
            <div class="contact-page__detail">
              <dt>{{ 'blocks.contact_form.hours' | t }}</dt>
              <dd class="rte">{{ section.settings.hours }}</dd>
            </div>
          {% endif %}
        </dl>
      {% endif %}
    </div>

    <div class="contact-page__card">
      {%- form 'contact', id: form_id, class: 'contact-page__form' -%}
        {% if form.posted_successfully? %}
          <div
            class="contact-page__success"
            role="status"
            tabindex="-1"
            autofocus
          >
            <span
              class="svg-wrapper contact-page__success-icon"
              aria-hidden="true"
            >
              {{- 'icon-checkmark.svg' | inline_asset_content -}}
            </span>
            <p class="contact-page__success-text">{{ success_text }}</p>
          </div>
        {% else %}
          {% if form.errors %}
            <div
              id="{{ form_id }}-errors"
              class="contact-page__errors"
              role="alert"
              tabindex="-1"
              autofocus
            >
              <p>{{ 'blocks.contact_form.error_heading' | t }}</p>
              <ul>
                {% for field in form.errors %}
                  <li>
                    {% if field == 'form' %}
                      {{ form.errors.messages[field] }}
                    {% else %}
                      {{ form.errors.translated_fields[field] | capitalize }}
                      {{ form.errors.messages[field] }}
                    {% endif %}
                  </li>
                {% endfor %}
              </ul>
            </div>
          {% endif %}

          <div class="contact-page__row">
            <div class="contact-page__field">
              <label for="{{ form_id }}-name">{{ 'blocks.contact_form.name' | t }}</label>
              <input
                id="{{ form_id }}-name"
                class="contact-page__input"
                type="text"
                name="contact[name]"
                autocomplete="name"
                value="{{ form.name | default: customer.name | escape }}"
              >
            </div>
            <div class="contact-page__field">
              <label for="{{ form_id }}-email">
                {{- 'blocks.contact_form.email' | t }} <span aria-hidden="true">*</span>
              </label>
              <input
                id="{{ form_id }}-email"
                class="contact-page__input"
                type="email"
                name="contact[email]"
                autocomplete="email"
                autocapitalize="off"
                spellcheck="false"
                value="{{ form.email | default: customer.email | escape }}"
                required
                {% if form.errors contains 'email' %}
                  aria-invalid="true"
                  aria-describedby="{{ form_id }}-errors"
                {% endif %}
              >
            </div>
          </div>

          {% if section.settings.show_order_number %}
            <div class="contact-page__field">
              <label for="{{ form_id }}-order">{{ 'blocks.contact_form.order_number' | t }}</label>
              <input
                id="{{ form_id }}-order"
                class="contact-page__input"
                type="text"
                name="contact[order_number]"
                autocomplete="off"
                value="{{ form['order_number'] | escape }}"
              >
            </div>
          {% endif %}

          <div class="contact-page__field">
            <label for="{{ form_id }}-message">
              {{- 'blocks.contact_form.message' | t }} <span aria-hidden="true">*</span>
            </label>
            <textarea
              id="{{ form_id }}-message"
              class="contact-page__input contact-page__textarea"
              name="contact[body]"
              rows="6"
              required
              {% if form.errors contains 'body' %}
                aria-invalid="true"
                aria-describedby="{{ form_id }}-errors"
              {% endif %}
            >{{ form.body | escape }}</textarea>
          </div>

          <button
            type="submit"
            class="button contact-page__button"
            style="{% render 'button-color-vars', color: section.settings.button_color %}"
          >
            {{- button_label -}}
          </button>
        {% endif %}
      {%- endform -%}
    </div>
  </div>
</div>

{% stylesheet %}
  .contact-page__layout {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--gap-2xl);

    @media screen and (min-width: 990px) {
      grid-template-columns: minmax(0, 2fr) minmax(0, 3fr);
      gap: var(--padding-4xl);
      align-items: start;
    }
  }

  .contact-page__intro {
    display: flex;
    flex-direction: column;
    gap: var(--gap-md);
    min-width: 0;
  }

  .contact-page__heading {
    margin: 0;
    font-family: var(--font-heading--family);
    font-weight: var(--font-heading--weight);
    font-size: var(--font-size--lg);
    line-height: var(--line-height--display-normal);
    overflow-wrap: anywhere;

    @media screen and (min-width: 750px) {
      font-size: var(--font-size--xl);
    }
  }

  .contact-page__text {
    font-size: var(--font-size--sm);
    line-height: var(--line-height--body-loose);
    color: var(--color-foreground-muted);

    & > :first-child {
      margin-block-start: 0;
    }

    & > :last-child {
      margin-block-end: 0;
    }
  }

  .contact-page__details {
    display: flex;
    flex-direction: column;
    gap: var(--gap-sm);
    margin: 0;
    padding-block-start: var(--padding-md);
    border-block-start: var(--style-border-width) solid var(--color-border);
  }

  .contact-page__detail {
    display: flex;
    flex-direction: column;
    gap: var(--gap-3xs, 0.125rem);

    dt {
      font-size: var(--font-size--xs);
      text-transform: uppercase;
      letter-spacing: 0.06em;
      color: var(--color-foreground-muted);
    }

    dd {
      margin: 0;
      font-size: var(--font-size--sm);

      & > * {
        margin: 0;
      }
    }

    a {
      color: var(--color-foreground);
      text-decoration: underline;
      text-underline-offset: 0.25em;
      overflow-wrap: anywhere;
    }
  }

  .contact-page__card {
    min-width: 0;
    padding: var(--padding-xl) var(--padding-lg);
    background-color: var(--color-background);
    border: var(--style-border-width) solid var(--color-border);
    border-radius: var(--style-border-radius-xs);

    @media screen and (min-width: 750px) {
      padding: var(--padding-3xl) var(--padding-2xl);
    }
  }

  .contact-page__form {
    display: flex;
    flex-direction: column;
    gap: var(--gap-md);
  }

  .contact-page__row {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--gap-md);

    @media screen and (min-width: 750px) {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  .contact-page__field {
    display: flex;
    flex-direction: column;
    gap: var(--gap-2xs, 0.25rem);
    min-width: 0;

    label {
      font-size: var(--font-size--sm);
    }
  }

  .contact-page__input {
    width: 100%;
    min-height: var(--minimum-touch-target);
    padding: var(--padding-sm) var(--padding-md);
    font-family: var(--font-body--family);
    font-size: var(--font-size--md);
    color: var(--color-input-text);
    background-color: var(--color-input-background);
    border: var(--style-border-width-inputs) solid var(--color-input-border);
    border-radius: var(--style-border-radius-inputs);

    &[aria-invalid='true'] {
      border-color: var(--color-error);
    }
  }

  .contact-page__textarea {
    min-height: 9rem;
    resize: vertical;
  }

  .contact-page__button {
    width: 100%;

    @media screen and (min-width: 750px) {
      align-self: flex-start;
      width: auto;
    }
  }

  .contact-page__errors {
    padding: var(--padding-sm) var(--padding-md);
    font-size: var(--font-size--sm);
    color: var(--color-error);
    border: var(--style-border-width) solid var(--color-error);
    border-radius: var(--style-border-radius-xs);
    outline: none;

    p,
    ul {
      margin: 0;
    }

    ul {
      padding-inline-start: var(--padding-lg);
    }
  }

  .contact-page__success {
    display: flex;
    align-items: center;
    gap: var(--gap-md);
    outline: none;
  }

  .contact-page__success-icon {
    flex-shrink: 0;
    width: var(--icon-size-sm);
    height: var(--icon-size-sm);
    color: var(--color-success);
  }

  .contact-page__success-text {
    margin: 0;
    font-size: var(--font-size--md);
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:names.contact_form",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "t:settings.heading",
      "default": "Get in touch"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "t:settings.text",
      "info": "t:info.contact_form_text"
    },
    {
      "type": "header",
      "content": "t:content.contact_details"
    },
    {
      "type": "text",
      "id": "email",
      "label": "t:settings.email_address",
      "info": "t:info.contact_form_email"
    },
    {
      "type": "text",
      "id": "phone",
      "label": "t:settings.phone_number"
    },
    {
      "type": "richtext",
      "id": "hours",
      "label": "t:settings.opening_hours",
      "default": "<p>Monday to Friday, 9:00 – 17:00</p>"
    },
    {
      "type": "header",
      "content": "t:content.form"
    },
    {
      "type": "checkbox",
      "id": "show_order_number",
      "label": "t:settings.show_order_number",
      "default": true
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "t:settings.button_label",
      "default": "Send message"
    },
    {
      "type": "text",
      "id": "success_text",
      "label": "t:settings.success_message",
      "default": "Thanks for your message. Someone from the workshop replies within one working day."
    },
    {
      "type": "header",
      "content": "t:content.appearance"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "t:settings.background_color",
      "default": "{{ settings.color_palette.background }}"
    },
    {
      "type": "color",
      "id": "border_color",
      "label": "t:settings.border_color",
      "placeholder": "t:settings.default"
    },
    {
      "type": "color",
      "id": "button_color",
      "label": "t:settings.button_color",
      "placeholder": "t:settings.default"
    },
    {
      "type": "header",
      "content": "t:content.padding"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "t:settings.top",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 32
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "t:settings.bottom",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 64
    }
  ],
  "presets": [
    {
      "name": "t:names.contact_form"
    }
  ]
}
{% endschema %}
