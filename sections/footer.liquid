{% comment %}
  Section contract.
  Site footer: brand column (logo, description, payment icons), menu columns picked
  from the store's navigation, and a bottom bar with copyright, legal links and the
  agency credit. Legal links fall back to the store policies when no menu is set.
  @example
  <!-- Footer group > Footer; add "Footer menu" blocks and pick a menu for each -->
{% endcomment %}

{% liquid
  assign legal_links = section.settings.legal_menu.links
  assign copyright_text = section.settings.copyright_text | escape

  capture columns
    content_for 'blocks'
  endcapture
%}

{% render 'contrast-override',
  background_color: section.settings.background_color,
  border_color: section.settings.divider_color,
  section_id: section.id
%}

<div class="section-background color-custom-{{ section.id }}"></div>
<div
  class="footer section section--{{ section.settings.section_width }} spacing-style color-custom-{{ section.id }}"
  style="{% render 'spacing-padding', settings: section.settings %}"
>
  <div class="footer__inner">
    <div class="footer__main">
      <div class="footer__brand">
        <a
          href="{{ routes.root_url }}"
          class="footer__logo"
        >
          {%- if settings.logo_inverse != blank or settings.logo != blank -%}
            {%- liquid
              assign footer_logo = settings.logo_inverse | default: settings.logo
              assign logo_class = 'footer__logo-image'

              # Without an inverse logo, the regular (dark) logo is shown in white on a dark footer
              if settings.logo_inverse == blank
                assign footer_brightness = section.settings.background_color | color_brightness
                if footer_brightness < 128
                  assign logo_class = 'footer__logo-image footer__logo-image--light'
                endif
              endif
            -%}
            {{
              footer_logo
              | image_url: width: 400
              | image_tag:
                height: settings.logo_height_mobile,
                alt: shop.name,
                loading: 'lazy',
                class: logo_class
            }}
          {%- else -%}
            {{ shop.name | escape }}
          {%- endif -%}
        </a>

        {% if section.settings.description != blank %}
          <div class="footer__description rte">{{ section.settings.description }}</div>
        {% endif %}

        {% liquid
          # A merchant-set list wins; otherwise show the methods enabled in the store
          assign payment_types = shop.enabled_payment_types
          if section.settings.payment_types != blank
            assign payment_types = section.settings.payment_types | remove: ' ' | split: ','
          endif
        %}
        {% if section.settings.show_payment_icons and payment_types.size > 0 %}
          <div class="footer__payments">
            <span class="visually-hidden">{{ 'blocks.payment_methods' | t }}</span>
            <ul
              class="footer__payment-list list-unstyled"
              role="list"
            >
              {%- for type in payment_types -%}
                <li class="footer__payment-item">
                  {{ type | payment_type_svg_tag: class: 'icon icon--full-color footer__payment-icon' }}
                </li>
              {%- endfor -%}
            </ul>
          </div>
        {% endif %}
      </div>

      {% if columns != blank %}
        <div class="footer__columns">{{ columns }}</div>
      {% endif %}
    </div>

    <div class="footer__bottom">
      <p class="footer__copyright">
        &copy; {{ 'now' | date: '%Y' }}
        {{ shop.name | escape -}}
        {%- if copyright_text != blank %} | {{ copyright_text }}{% endif %}
      </p>

      <ul class="footer__legal list-unstyled">
        {% if legal_links.size > 0 %}
          {% for link in legal_links %}
            <li>
              <a
                href="{{ link.url }}"
                class="footer__legal-link"
              >
                {{- link.title | escape -}}
              </a>
            </li>
          {% endfor %}
        {% else %}
          {% for policy in shop.policies %}
            <li>
              <a
                href="{{ policy.url }}"
                class="footer__legal-link"
              >
                {{- policy.title | escape -}}
              </a>
            </li>
          {% endfor %}
        {% endif %}
      </ul>

      {% if section.settings.show_credit %}
        <p class="footer__credit">
          <a
            href="https://e-expansion.nl"
            class="footer__credit-link"
            target="_blank"
            rel="noopener"
          >
            Powered by E-Expansion
          </a>
        </p>
      {% endif %}
    </div>
  </div>
</div>

{% stylesheet %}
  .footer {
    color: var(--color-foreground);
    font-family: var(--font-body--family);
  }

  .footer__inner {
    display: flex;
    flex-direction: column;
    gap: var(--gap-2xl);
    min-width: 0;
  }

  .footer__main {
    display: grid;
    gap: var(--padding-5xl);

    @media screen and (min-width: 990px) {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1.75fr);
      gap: var(--padding-6xl);
    }
  }

  .footer__brand {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--gap-xl);
    max-width: 22rem;
  }

  .footer__logo {
    font-family: var(--font-heading--family);
    font-weight: var(--font-heading--weight);
    font-size: var(--font-size--xl);
    letter-spacing: var(--letter-spacing-sm);
    line-height: 1;
    text-transform: uppercase;
    color: inherit;
    text-decoration: none;
  }

  .footer__logo-image {
    width: auto;
    height: var(--font-size--2xl);
  }

  .footer__logo-image--light {
    filter: brightness(0) invert(1);
  }

  .footer__description {
    font-size: var(--font-size--sm);
    line-height: var(--line-height--body-loose);

    & > * {
      margin: 0;
    }
  }

  .footer__payment-list {
    display: flex;
    flex-wrap: wrap;
    gap: var(--gap-xs);
    margin: 0;
  }

  .footer__payment-icon {
    display: block;
    width: 2.125rem;
    height: auto;
  }

  .footer__columns {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--padding-5xl) var(--gap-xl);

    @media screen and (min-width: 750px) {
      grid-template-columns: repeat(auto-fit, minmax(8rem, 1fr));
      gap: var(--gap-2xl);
    }
  }

  .footer__bottom {
    display: flex;
    flex-direction: column;
    gap: var(--gap-lg);
    padding-block-start: var(--padding-2xl);
    border-block-start: var(--style-border-width) solid var(--color-border);
    font-size: var(--font-size--2xs);
    letter-spacing: var(--letter-spacing-sm);
    color: var(--color-foreground-muted);

    @media screen and (min-width: 750px) {
      display: grid;
      grid-template-columns: 1fr auto 1fr;
      align-items: center;
    }
  }

  .footer__copyright,
  .footer__credit {
    margin: 0;
  }

  .footer__credit {
    @media screen and (min-width: 750px) {
      text-align: end;
    }
  }

  .footer__legal {
    display: flex;
    flex-wrap: wrap;
    gap: var(--gap-xs) var(--gap-xl);
    margin: 0;
    letter-spacing: normal;
  }

  .footer__legal-link,
  .footer__credit-link {
    color: inherit;
    text-decoration: none;
    transition: color var(--animation-speed) var(--animation-easing);

    &:hover {
      color: var(--color-foreground);
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:names.footer",
  "class": "section-wrapper",
  "blocks": [
    {
      "type": "_footer-menu"
    }
  ],
  "enabled_on": {
    "groups": ["footer"]
  },
  "settings": [
    {
      "type": "header",
      "content": "t:content.text"
    },
    {
      "type": "richtext",
      "id": "description",
      "label": "t:settings.text",
      "default": "<p>Cut, stitched and repaired in one workshop since 1994. Parts kept in stock for every piece we have ever sold.</p>"
    },
    {
      "type": "checkbox",
      "id": "show_payment_icons",
      "label": "t:settings.show_payment_icons",
      "default": true
    },
    {
      "type": "text",
      "id": "payment_types",
      "label": "t:settings.payment_types",
      "info": "t:info.footer_payment_types",
      "default": "paypal, ideal, maestro, visa, master, apple_pay, american_express, klarna",
      "visible_if": "{{ section.settings.show_payment_icons }}"
    },
    {
      "type": "header",
      "content": "t:content.footer_bottom_bar"
    },
    {
      "type": "text",
      "id": "copyright_text",
      "label": "t:settings.copyright_text",
      "default": "generic Shopify template"
    },
    {
      "type": "link_list",
      "id": "legal_menu",
      "label": "t:settings.legal_menu",
      "info": "t:info.footer_legal_menu"
    },
    {
      "type": "checkbox",
      "id": "show_credit",
      "label": "t:settings.show_agency_credit",
      "default": true
    },
    {
      "type": "header",
      "content": "t:content.appearance"
    },
    {
      "type": "select",
      "id": "section_width",
      "label": "t:settings.width",
      "options": [
        {
          "value": "page-width",
          "label": "t:options.page"
        },
        {
          "value": "full-width",
          "label": "t:options.full"
        }
      ],
      "default": "page-width"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "t:settings.background_color",
      "default": "{{ settings.color_palette.foreground }}"
    },
    {
      "type": "color",
      "id": "divider_color",
      "label": "t:settings.divider_color",
      "placeholder": "t:settings.default"
    },
    {
      "type": "header",
      "content": "t:content.padding"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "t:settings.top",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 40
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "t:settings.bottom",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 40
    }
  ],
  "presets": [
    {
      "name": "t:names.footer",
      "category": "t:categories.footer",
      "blocks": {
        "menu_shop": {
          "type": "_footer-menu",
          "settings": {
            "heading": "Shop"
          }
        },
        "menu_help": {
          "type": "_footer-menu",
          "settings": {
            "heading": "Help",
            "button_label": "Direct chat"
          }
        },
        "menu_about": {
          "type": "_footer-menu",
          "settings": {
            "heading": "About"
          }
        }
      },
      "block_order": ["menu_shop", "menu_help", "menu_about"]
    }
  ]
}
{% endschema %}
