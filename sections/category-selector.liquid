{% comment %}
  Section contract.
  Heading row with a "view all" link, followed by collection cards. Cards sit in a grid
  on desktop and become a horizontal scroll-snap carousel on mobile that bleeds to the
  viewport edge.
  @example
  <!-- Homepage > Add section > Category selector; add a card per collection -->
{% endcomment %}

{% liquid
  assign columns = section.blocks.size | at_least: 1 | at_most: 4
%}

{% render 'contrast-override',
  background_color: section.settings.background_color,
  border_color: section.settings.border_color,
  section_id: section.id
%}

<div class="section-background color-custom-{{ section.id }}"></div>
<div
  class="category-selector section section--{{ section.settings.section_width }} spacing-style color-custom-{{ section.id }}"
  style="
    {% render 'spacing-padding', settings: section.settings %}
    --snap-carousel-columns: {{ columns }};
    --category-tile-ratio: {{ section.settings.image_ratio }};
    {% if section.settings.link_color != blank %}--section-heading-link-color: {{ section.settings.link_color }};{% endif %}
  "
>
  <div class="category-selector__inner">
    {% render 'section-heading',
      heading: section.settings.heading,
      text: section.settings.text,
      link_url: section.settings.link,
      link_label: section.settings.link_label,
      link_label_mobile: section.settings.link_label_mobile
    %}

    <ul class="category-selector__list snap-carousel list-unstyled">
      {% content_for 'blocks' %}
    </ul>
  </div>
</div>

{% stylesheet %}
  .category-selector__inner {
    display: flex;
    flex-direction: column;
    gap: var(--gap-xl);
    min-width: 0;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:names.category_selector",
  "blocks": [
    {
      "type": "_category-card"
    }
  ],
  "max_blocks": 8,
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "t:settings.heading",
      "default": "Start with a category"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "t:settings.text",
      "default": "<p>Four curated groups, not the full catalogue.</p>"
    },
    {
      "type": "text",
      "id": "link_label",
      "label": "t:settings.link_label",
      "default": "View all products"
    },
    {
      "type": "text",
      "id": "link_label_mobile",
      "label": "t:settings.link_label_mobile",
      "default": "View all"
    },
    {
      "type": "url",
      "id": "link",
      "label": "t:settings.link",
      "default": "/collections/all"
    },
    {
      "type": "header",
      "content": "t:content.appearance"
    },
    {
      "type": "select",
      "id": "image_ratio",
      "label": "t:settings.aspect_ratio",
      "options": [
        { "value": "1 / 1", "label": "1:1" },
        { "value": "4 / 3", "label": "4:3" },
        { "value": "3 / 4", "label": "3:4" },
        { "value": "16 / 9", "label": "16:9" }
      ],
      "default": "4 / 3"
    },
    {
      "type": "select",
      "id": "section_width",
      "label": "t:settings.section_width",
      "options": [
        { "value": "page-width", "label": "t:options.page" },
        { "value": "full-width", "label": "t:options.full" }
      ],
      "default": "page-width"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "t:settings.background_color",
      "default": "{{ settings.color_palette.background }}"
    },
    {
      "type": "color",
      "id": "border_color",
      "label": "t:settings.border_color",
      "placeholder": "t:settings.default"
    },
    {
      "type": "color",
      "id": "link_color",
      "label": "t:settings.link_color",
      "placeholder": "t:settings.default"
    },
    {
      "type": "header",
      "content": "t:content.padding"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "t:settings.top",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 48
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "t:settings.bottom",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 48
    }
  ],
  "presets": [
    {
      "name": "t:names.category_selector",
      "blocks": {
        "card_1": { "type": "_category-card" },
        "card_2": { "type": "_category-card" },
        "card_3": { "type": "_category-card" },
        "card_4": { "type": "_category-card" }
      },
      "block_order": ["card_1", "card_2", "card_3", "card_4"]
    }
  ]
}
{% endschema %}
