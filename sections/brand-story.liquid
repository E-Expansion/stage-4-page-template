{% comment %}
  Section contract.
  Origin story: image beside text in a bordered card on desktop, with a row of key
  figures (stat blocks) and a link. On mobile the image runs edge to edge above the text.
  @example
  <!-- Homepage > Add section > Brand story; add a stat block per key figure -->
{% endcomment %}

{% liquid
  assign heading = section.settings.heading | escape
  assign link_label = section.settings.link_label | escape
  assign image = section.settings.image

  capture stats
    content_for 'blocks'
  endcapture
%}

{% render 'contrast-override',
  background_color: section.settings.background_color,
  border_color: section.settings.border_color,
  section_id: section.id
%}

<div class="section-background color-custom-{{ section.id }}"></div>
<div
  class="brand-story section section--page-width spacing-style color-custom-{{ section.id }}"
  style="
    {% render 'spacing-padding', settings: section.settings %}
    --brand-story-mobile-ratio: {{ section.settings.mobile_image_ratio }};
    {% if section.settings.link_color != blank %}--brand-story-link-color: {{ section.settings.link_color }};{% endif %}
  "
>
  <div class="brand-story__card brand-story__card--image-{{ section.settings.image_position }}">
    <div class="brand-story__media">
      {% if image != blank %}
        {{
          image
          | image_url: width: 1600
          | image_tag:
            widths: '375, 550, 750, 1000, 1200, 1600',
            sizes: '(min-width: 750px) 50vw, 100vw',
            loading: 'lazy',
            class: 'brand-story__image'
        }}
      {% else %}
        {{ 'lifestyle-2' | placeholder_svg_tag: 'brand-story__image brand-story__placeholder' }}
      {% endif %}
    </div>

    <div class="brand-story__content">
      {% if heading != blank %}
        <h2 class="brand-story__heading">{{ heading }}</h2>
      {% endif %}

      {% if section.settings.text != blank %}
        <div class="brand-story__text rte">{{ section.settings.text }}</div>
      {% endif %}

      {% if stats != blank %}
        <dl class="brand-story__stats">{{ stats }}</dl>
      {% endif %}

      {% if link_label != blank and section.settings.link != blank %}
        <a
          href="{{ section.settings.link }}"
          class="brand-story__link"
        >
          {{- link_label -}}
        </a>
      {% endif %}
    </div>
  </div>
</div>

{% stylesheet %}
  .brand-story__card {
    display: grid;
    min-width: 0;

    @media screen and (max-width: 749px) {
      /* Break out of the page margins so the image runs edge to edge */
      grid-column: 1 / -1;
    }

    @media screen and (min-width: 750px) {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      overflow: hidden;
      border: var(--style-border-width) solid var(--color-border);
      border-radius: var(--style-border-radius-xs);
    }
  }

  @media screen and (min-width: 750px) {
    .brand-story__card--image-right .brand-story__media {
      order: 1;
    }
  }

  .brand-story__media {
    position: relative;
    aspect-ratio: var(--brand-story-mobile-ratio);
    overflow: hidden;

    @media screen and (min-width: 750px) {
      aspect-ratio: auto;
      min-height: 100%;
    }
  }

  .brand-story__image {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;

    @media screen and (min-width: 750px) {
      position: absolute;
      inset: 0;
    }
  }

  .brand-story__placeholder {
    background-color: rgb(var(--color-foreground-rgb) / var(--opacity-5));
    fill: rgb(var(--color-foreground-rgb) / var(--opacity-30));
  }

  .brand-story__content {
    display: flex;
    flex-direction: column;
    gap: var(--gap-lg);
    min-width: 0;
    padding: var(--padding-4xl) var(--page-margin) 0;

    @media screen and (min-width: 750px) {
      justify-content: center;
      padding: var(--padding-5xl) var(--padding-5xl);
    }
  }

  .brand-story__heading {
    margin: 0;
    font-family: var(--font-heading--family);
    font-weight: var(--font-heading--weight);
    font-size: var(--font-size--2xl);
    line-height: var(--line-height--display-normal);
    letter-spacing: var(--letter-spacing--heading-tight);
    text-wrap: balance;
    overflow-wrap: anywhere;

    @media screen and (min-width: 990px) {
      font-size: var(--font-size--3xl);
    }
  }

  .brand-story__text {
    font-size: var(--font-size--md);
    line-height: var(--line-height--body-loose);
    color: var(--color-foreground-muted);

    & > * {
      margin: 0;
    }

    & > * + * {
      margin-block-start: var(--margin-xs);
    }
  }

  .brand-story__stats {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(6.5rem, 1fr));
    gap: var(--gap-lg);
    margin: 0;
    margin-block-start: var(--gap-xs);
    padding-block-start: var(--padding-xl);
    border-block-start: var(--style-border-width) solid var(--color-border);
  }

  .brand-story__link {
    align-self: flex-start;
    margin-block-start: var(--gap-xs);
    color: var(--brand-story-link-color, var(--color-foreground));
    text-decoration: underline;
    text-underline-offset: 0.25em;

    &:hover {
      text-decoration-thickness: 2px;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:names.brand_story",
  "blocks": [
    {
      "type": "_brand-story-stat"
    }
  ],
  "max_blocks": 4,
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "t:settings.image"
    },
    {
      "type": "select",
      "id": "image_position",
      "label": "t:settings.image_position",
      "options": [
        { "value": "left", "label": "t:options.left" },
        { "value": "right", "label": "t:options.right" }
      ],
      "default": "left"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "t:settings.heading",
      "default": "Two benches, eleven pairs of hands, one town"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "t:settings.text",
      "default": "<p>We buy full-grain hides from a single tannery forty kilometres from the workshop, cut them by hand, and stitch every seam on machines older than the company. Nothing leaves the bench until it has been checked twice.</p>"
    },
    {
      "type": "text",
      "id": "link_label",
      "label": "t:settings.link_label",
      "default": "Read how we make things"
    },
    {
      "type": "url",
      "id": "link",
      "label": "t:settings.link"
    },
    {
      "type": "header",
      "content": "t:content.appearance"
    },
    {
      "type": "select",
      "id": "mobile_image_ratio",
      "label": "t:settings.mobile_image_ratio",
      "options": [
        { "value": "1 / 1", "label": "1:1" },
        { "value": "4 / 3", "label": "4:3" },
        { "value": "3 / 2", "label": "3:2" },
        { "value": "16 / 9", "label": "16:9" }
      ],
      "default": "4 / 3"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "t:settings.background_color",
      "default": "{{ settings.color_palette.background }}"
    },
    {
      "type": "color",
      "id": "border_color",
      "label": "t:settings.border_color",
      "placeholder": "t:settings.default"
    },
    {
      "type": "color",
      "id": "link_color",
      "label": "t:settings.link_color",
      "placeholder": "t:settings.default"
    },
    {
      "type": "header",
      "content": "t:content.padding"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "t:settings.top",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 48
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "t:settings.bottom",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 48
    }
  ],
  "presets": [
    {
      "name": "t:names.brand_story",
      "blocks": {
        "stat_founded": {
          "type": "_brand-story-stat",
          "settings": { "value": "1994", "label": "Workshop founded" }
        },
        "stat_tannery": {
          "type": "_brand-story-stat",
          "settings": { "value": "1 tannery", "label": "Single, traceable source" }
        },
        "stat_guarantee": {
          "type": "_brand-story-stat",
          "settings": { "value": "5 years", "label": "Repair guarantee" }
        }
      },
      "block_order": ["stat_founded", "stat_tannery", "stat_guarantee"]
    }
  ]
}
{% endschema %}
