{% comment %}
  Section contract.
  Long-form text card (the shared seo-text-block snippet). On collection pages the text
  comes from the collection's custom.seo_heading and custom.seo_text metafields, on product
  pages from the product description, so one template serves every item. The section's
  own heading and text are the fallback.
  @example
  <!-- Collection or product template > Add section > SEO text -->
{% endcomment %}

{% liquid
  case template.name
    when 'collection'
      assign seo_heading = collection.metafields.custom.seo_heading.value
      assign seo_content = collection.metafields.custom.seo_text | metafield_tag
    when 'product'
      assign seo_heading = product.metafields.custom.seo_heading.value
      assign seo_content = product.description
  endcase

  if seo_heading == blank
    assign seo_heading = section.settings.heading
  endif
  if seo_content == blank
    assign seo_content = section.settings.text
  endif
%}

{% if seo_content != blank %}
  {% render 'contrast-override',
    background_color: section.settings.background_color,
    border_color: section.settings.border_color,
    section_id: section.id
  %}

  <div class="section-background color-custom-{{ section.id }}"></div>
  <div
    class="seo-text section section--page-width spacing-style color-custom-{{ section.id }}"
    style="{% render 'spacing-padding', settings: section.settings %}"
  >
    <div class="seo-text__inner{% if section.settings.align_with_grid %} align-with-collection-grid{% endif %}">
      {% render 'seo-text-block', heading: seo_heading, content: seo_content %}
    </div>
  </div>
{% endif %}

{% stylesheet %}
  .seo-text__inner {
    min-width: 0;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:names.seo_text",
  "settings": [
    {
      "type": "paragraph",
      "content": "t:info.seo_text_source"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "t:settings.heading"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "t:settings.text"
    },
    {
      "type": "header",
      "content": "t:content.appearance"
    },
    {
      "type": "checkbox",
      "id": "align_with_grid",
      "label": "t:settings.align_with_product_grid",
      "default": false
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "t:settings.background_color",
      "default": "{{ settings.color_palette.background }}"
    },
    {
      "type": "color",
      "id": "border_color",
      "label": "t:settings.border_color",
      "placeholder": "t:settings.default"
    },
    {
      "type": "header",
      "content": "t:content.padding"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "t:settings.top",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 16
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "t:settings.bottom",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 16
    }
  ],
  "presets": [
    {
      "name": "t:names.seo_text"
    }
  ]
}
{% endschema %}
