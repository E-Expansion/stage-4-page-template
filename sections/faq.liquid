{% comment %}
  Section contract.
  FAQ card: intro (heading, text, chat/contact link) beside an accordion of question
  blocks on desktop, stacked on mobile. Emits FAQPage structured data for the questions.
  @example
  <!-- Homepage > Add section > FAQ; add a question block per FAQ -->
{% endcomment %}

{% liquid
  assign heading = section.settings.heading | escape
  assign link_label = section.settings.link_label | escape

  assign link_url = section.settings.link
  if link_url == blank
    assign link_url = routes.root_url | append: '/pages/contact' | replace: '//', '/'
  endif
%}

{% render 'contrast-override',
  background_color: section.settings.background_color,
  border_color: section.settings.border_color,
  section_id: section.id
%}

<div class="section-background color-custom-{{ section.id }}"></div>
<div
  class="faq section section--page-width spacing-style color-custom-{{ section.id }}"
  style="
    {% render 'spacing-padding', settings: section.settings %}
    {% if section.settings.link_color != blank %}--faq-link-color: {{ section.settings.link_color }};{% endif %}
  "
>
  <div class="faq__card">
    <div class="faq__intro">
      {% if heading != blank %}
        <h2 class="faq__heading">{{ heading }}</h2>
      {% endif %}

      {% if section.settings.text != blank %}
        <div class="faq__text rte">{{ section.settings.text }}</div>
      {% endif %}

      {% if link_label != blank %}
        <a
          href="{{ link_url }}"
          class="faq__link"
          {% if section.settings.link_opens_chat %}
            data-chat-trigger
          {% endif %}
        >
          {{- link_label -}}
        </a>
        {% if section.settings.link_opens_chat %}
          {% render 'chat-trigger-script' %}
        {% endif %}
      {% endif %}
    </div>

    <div class="faq__list">
      {% content_for 'blocks' %}
    </div>
  </div>
</div>

{% liquid
  assign faq_entries = section.blocks | where: 'type', '_faq-item'
%}
{% if faq_entries.size > 0 %}
  <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "FAQPage",
      "mainEntity": [
        {%- for entry in faq_entries -%}
          {
            "@type": "Question",
            "name": {{ entry.settings.question | json }},
            "acceptedAnswer": {
              "@type": "Answer",
              "text": {{ entry.settings.answer | json }}
            }
          }{% unless forloop.last %},{% endunless %}
        {%- endfor -%}
      ]
    }
  </script>
{% endif %}

{% stylesheet %}
  .faq__card {
    display: grid;
    min-width: 0;
    overflow: hidden;
    background-color: var(--color-background);
    border: var(--style-border-width) solid var(--color-border);
    border-radius: var(--style-border-radius-sm);

    @media screen and (min-width: 750px) {
      grid-template-columns: minmax(0, 2fr) minmax(0, 3fr);
      gap: var(--padding-5xl);
      padding: var(--padding-6xl) var(--padding-5xl);
      border-radius: var(--style-border-radius-xs);
    }
  }

  .faq__intro {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--gap-md);
    padding: var(--padding-3xl) var(--padding-2xl) var(--padding-2xl);

    @media screen and (min-width: 750px) {
      gap: var(--gap-xl);
      padding: 0;
    }
  }

  .faq__heading {
    margin: 0;
    font-family: var(--font-heading--family);
    font-weight: var(--font-heading--weight);
    font-size: var(--font-size--2xl);
    line-height: var(--line-height--display-normal);
    letter-spacing: var(--letter-spacing--heading-tight);
    overflow-wrap: anywhere;

    @media screen and (min-width: 990px) {
      font-size: var(--font-size--3xl);
    }
  }

  .faq__text {
    font-size: var(--font-size--md);
    line-height: var(--line-height--body-loose);
    color: var(--color-foreground-muted);

    & > * {
      margin: 0;
    }
  }

  .faq__link {
    color: var(--faq-link-color, var(--color-foreground));
    text-decoration: underline;
    text-underline-offset: 0.25em;

    &:hover {
      text-decoration-thickness: 2px;
    }
  }

  /* Mobile: dividers run edge to edge of the card, text keeps the card padding */
  @media screen and (max-width: 749px) {
    .faq__list .faq-accordion__summary,
    .faq__list .faq-accordion__answer {
      padding-inline: var(--padding-2xl);
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:names.faq",
  "blocks": [
    {
      "type": "_faq-item"
    }
  ],
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "t:settings.heading",
      "default": "Questions we get a lot"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "t:settings.text",
      "default": "<p>Still unsure? Our workshop answers within one working day.</p>"
    },
    {
      "type": "text",
      "id": "link_label",
      "label": "t:settings.link_label",
      "default": "Chat with us"
    },
    {
      "type": "url",
      "id": "link",
      "label": "t:settings.link",
      "info": "t:info.footer_menu_button_link"
    },
    {
      "type": "checkbox",
      "id": "link_opens_chat",
      "label": "t:settings.button_opens_chat",
      "info": "t:info.footer_menu_button_chat",
      "default": true
    },
    {
      "type": "header",
      "content": "t:content.appearance"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "t:settings.background_color",
      "default": "{{ settings.color_palette.background }}"
    },
    {
      "type": "color",
      "id": "border_color",
      "label": "t:settings.border_color",
      "placeholder": "t:settings.default"
    },
    {
      "type": "color",
      "id": "link_color",
      "label": "t:settings.link_color",
      "placeholder": "t:settings.default"
    },
    {
      "type": "header",
      "content": "t:content.padding"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "t:settings.top",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 48
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "t:settings.bottom",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 48
    }
  ],
  "presets": [
    {
      "name": "t:names.faq",
      "blocks": {
        "faq_1": { "type": "_faq-item" }
      },
      "block_order": ["faq_1"]
    }
  ]
}
{% endschema %}
