{% comment %}
  Section contract.
  Hand-picked product cards with a heading row. Cards sit in a grid on desktop and become
  a horizontal scroll-snap carousel on mobile that bleeds to the viewport edge, matching
  the category selector. Tiles are the shared product-tile snippet; badges, rating and
  stock colours are set once in Theme settings.
  @example
  <!-- Homepage > Add section > Curated products; pick products in the product list -->
{% endcomment %}

{% liquid
  assign products = section.settings.products
  assign max_products = section.settings.max_products
%}

{% render 'contrast-override',
  background_color: section.settings.background_color,
  border_color: section.settings.border_color,
  section_id: section.id
%}

<div class="section-background color-custom-{{ section.id }}"></div>
<div
  class="curated-products section section--{{ section.settings.section_width }} spacing-style color-custom-{{ section.id }}"
  style="
    {% render 'spacing-padding', settings: section.settings %}
    --snap-carousel-columns: {{ section.settings.columns }};
  "
>
  <div class="curated-products__inner">
    {% render 'section-heading',
      heading: section.settings.heading,
      aside_text: section.settings.subheading
    %}

    <ul class="curated-products__list snap-carousel list-unstyled">
      {% if products.size > 0 %}
        {% for product in products limit: max_products %}
          {% render 'product-tile', product: product, section_id: section.id %}
        {% endfor %}
      {% else %}
        {% for i in (1..4) %}
          {% render 'product-tile', product: blank, section_id: section.id %}
        {% endfor %}
      {% endif %}
    </ul>
  </div>
</div>

{% stylesheet %}
  .curated-products__inner {
    display: flex;
    flex-direction: column;
    gap: var(--gap-xl);
    min-width: 0;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:names.curated_products",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "t:settings.heading",
      "default": "Curated products"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "t:settings.subheading",
      "default": "Hand picked by our team"
    },
    {
      "type": "product_list",
      "id": "products",
      "label": "t:settings.products",
      "limit": 12
    },
    {
      "type": "range",
      "id": "max_products",
      "label": "t:settings.max_products",
      "min": 2,
      "max": 12,
      "step": 1,
      "default": 4
    },
    {
      "type": "range",
      "id": "columns",
      "label": "t:settings.columns",
      "min": 2,
      "max": 5,
      "step": 1,
      "default": 4
    },
    {
      "type": "header",
      "content": "t:content.appearance"
    },
    {
      "type": "select",
      "id": "section_width",
      "label": "t:settings.section_width",
      "options": [
        { "value": "page-width", "label": "t:options.page" },
        { "value": "full-width", "label": "t:options.full" }
      ],
      "default": "page-width"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "t:settings.background_color",
      "default": "{{ settings.color_palette.background }}"
    },
    {
      "type": "color",
      "id": "border_color",
      "label": "t:settings.border_color",
      "placeholder": "t:settings.default"
    },
    {
      "type": "header",
      "content": "t:content.padding"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "t:settings.top",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 48
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "t:settings.bottom",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 48
    }
  ],
  "presets": [
    {
      "name": "t:names.curated_products"
    }
  ]
}
{% endschema %}
