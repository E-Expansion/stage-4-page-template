{% comment %}
  Section contract.
  Hand-picked product cards with a heading row. Cards sit in a grid on desktop and become
  a horizontal scroll-snap carousel on mobile that bleeds to the viewport edge, matching
  the category selector. Badges come from product tags, ratings from Shopify's standard
  review metafields and stock status from variant inventory.
  @example
  <!-- Homepage > Add section > Curated products; pick products in the product list -->
{% endcomment %}

{% liquid
  assign heading = section.settings.heading | escape
  assign subheading = section.settings.subheading | escape
  assign products = section.settings.products
  assign max_products = section.settings.max_products

  # Badge text picks the palette extreme that contrasts with each badge colour
  assign badge_style = ''
  for index in (1..2)
    assign color_key = 'badge_' | append: index | append: '_color'
    assign badge_color = section.settings[color_key]
    if badge_color != blank
      assign badge_brightness = badge_color | color_brightness
      if badge_brightness > 128
        assign badge_text = 'var(--palette-darkest)'
      else
        assign badge_text = 'var(--palette-lightest)'
      endif
      capture badge_style
        echo badge_style
        echo '--curated-badge-' | append: index | append: '-color: ' | append: badge_color | append: '; '
        echo '--curated-badge-' | append: index | append: '-text: ' | append: badge_text | append: '; '
      endcapture
    endif
  endfor
%}

{% render 'contrast-override',
  background_color: section.settings.background_color,
  border_color: section.settings.border_color,
  section_id: section.id
%}

<div class="section-background color-custom-{{ section.id }}"></div>
<div
  class="curated-products section section--{{ section.settings.section_width }} spacing-style color-custom-{{ section.id }}"
  style="
    {% render 'spacing-padding', settings: section.settings %}
    --curated-columns: {{ section.settings.columns }};
    {{ badge_style }}
    {% if section.settings.rating_color != blank %}--curated-rating-color: {{ section.settings.rating_color }};{% endif %}
    {% if section.settings.in_stock_color != blank %}--curated-in-stock-color: {{ section.settings.in_stock_color }};{% endif %}
    {% if section.settings.low_stock_color != blank %}--curated-low-stock-color: {{ section.settings.low_stock_color }};{% endif %}
  "
>
  <div class="curated-products__inner">
    {% if heading != blank or subheading != blank %}
      <div class="curated-products__header">
        {% if heading != blank %}
          <h2 class="curated-products__heading">{{ heading }}</h2>
        {% endif %}
        {% if subheading != blank %}
          <p class="curated-products__subheading">{{ subheading }}</p>
        {% endif %}
      </div>
    {% endif %}

    <ul class="curated-products__list list-unstyled">
      {% if products.size > 0 %}
        {% for product in products limit: max_products %}
          {% render 'curated-product-card',
            product: product,
            section_id: section.id,
            badge_1_tag: section.settings.badge_1_tag,
            badge_1_label: section.settings.badge_1_label,
            badge_2_tag: section.settings.badge_2_tag,
            badge_2_label: section.settings.badge_2_label,
            low_stock_threshold: section.settings.low_stock_threshold
          %}
        {% endfor %}
      {% else %}
        {% for i in (1..4) %}
          {% render 'curated-product-card', product: blank, section_id: section.id %}
        {% endfor %}
      {% endif %}
    </ul>
  </div>
</div>

{% stylesheet %}
  .curated-products__inner {
    display: flex;
    flex-direction: column;
    gap: var(--gap-xl);
    min-width: 0;
  }

  .curated-products__header {
    display: flex;
    flex-direction: column;
    gap: var(--gap-xs);

    @media screen and (min-width: 750px) {
      flex-direction: row;
      flex-wrap: wrap;
      align-items: baseline;
      justify-content: space-between;
      column-gap: var(--gap-xl);
    }
  }

  .curated-products__heading {
    margin: 0;
    font-family: var(--font-heading--family);
    font-weight: var(--font-heading--weight);
    font-size: var(--font-size--2xl);
    line-height: var(--line-height--display-normal);
    letter-spacing: var(--letter-spacing--heading-tight);
    overflow-wrap: anywhere;

    @media screen and (min-width: 750px) {
      font-size: var(--font-size--3xl);
    }
  }

  .curated-products__subheading {
    margin: 0;
    font-size: var(--font-size--sm);
    color: var(--color-foreground-muted);
  }

  /* Same carousel pattern as the category selector */
  .curated-products__list {
    display: grid;
    grid-auto-flow: column;
    grid-auto-columns: 45%;
    gap: var(--gap-sm);
    margin: 0;
    margin-inline-end: calc(var(--page-margin) * -1);
    padding-inline-end: var(--page-margin);
    overflow-x: auto;
    overscroll-behavior-x: contain;
    scroll-snap-type: x mandatory;
    scrollbar-width: none;

    &::-webkit-scrollbar {
      display: none;
    }

    @media screen and (min-width: 750px) {
      grid-auto-flow: row;
      grid-template-columns: repeat(var(--curated-columns), minmax(0, 1fr));
      gap: var(--gap-lg);
      margin-inline-end: 0;
      padding-inline-end: 0;
      overflow: visible;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:names.curated_products",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "t:settings.heading",
      "default": "Curated products"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "t:settings.subheading",
      "default": "Hand picked by our team"
    },
    {
      "type": "product_list",
      "id": "products",
      "label": "t:settings.products",
      "limit": 12
    },
    {
      "type": "range",
      "id": "max_products",
      "label": "t:settings.max_products",
      "min": 2,
      "max": 12,
      "step": 1,
      "default": 4
    },
    {
      "type": "range",
      "id": "columns",
      "label": "t:settings.columns",
      "min": 2,
      "max": 5,
      "step": 1,
      "default": 4
    },
    {
      "type": "header",
      "content": "t:content.badges"
    },
    {
      "type": "paragraph",
      "content": "t:info.curated_products_badges"
    },
    {
      "type": "text",
      "id": "badge_1_tag",
      "label": "t:settings.badge_1_tag",
      "default": "best-seller"
    },
    {
      "type": "text",
      "id": "badge_1_label",
      "label": "t:settings.badge_1_label",
      "default": "Best seller"
    },
    {
      "type": "color",
      "id": "badge_1_color",
      "label": "t:settings.badge_1_color",
      "placeholder": "t:settings.default"
    },
    {
      "type": "text",
      "id": "badge_2_tag",
      "label": "t:settings.badge_2_tag",
      "default": "new"
    },
    {
      "type": "text",
      "id": "badge_2_label",
      "label": "t:settings.badge_2_label",
      "default": "New"
    },
    {
      "type": "color",
      "id": "badge_2_color",
      "label": "t:settings.badge_2_color",
      "placeholder": "t:settings.default"
    },
    {
      "type": "header",
      "content": "t:content.inventory"
    },
    {
      "type": "range",
      "id": "low_stock_threshold",
      "label": "t:settings.low_stock_threshold",
      "min": 1,
      "max": 20,
      "step": 1,
      "default": 5
    },
    {
      "type": "color",
      "id": "in_stock_color",
      "label": "t:settings.in_stock_color",
      "placeholder": "t:settings.default"
    },
    {
      "type": "color",
      "id": "low_stock_color",
      "label": "t:settings.low_stock_color",
      "placeholder": "t:settings.default"
    },
    {
      "type": "color",
      "id": "rating_color",
      "label": "t:settings.rating_color",
      "placeholder": "t:settings.default"
    },
    {
      "type": "header",
      "content": "t:content.appearance"
    },
    {
      "type": "select",
      "id": "section_width",
      "label": "t:settings.section_width",
      "options": [
        { "value": "page-width", "label": "t:options.page" },
        { "value": "full-width", "label": "t:options.full" }
      ],
      "default": "page-width"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "t:settings.background_color",
      "default": "{{ settings.color_palette.background }}"
    },
    {
      "type": "color",
      "id": "border_color",
      "label": "t:settings.border_color",
      "placeholder": "t:settings.default"
    },
    {
      "type": "header",
      "content": "t:content.padding"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "t:settings.top",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 48
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "t:settings.bottom",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 48
    }
  ],
  "presets": [
    {
      "name": "t:names.curated_products"
    }
  ]
}
{% endschema %}
