{% comment %}
  Section contract.
  Blog listing: a bar with the article count, tag filters, sorting and article search,
  above a grid of the shared article card (a swipeable row on mobile). Tag filters use
  Shopify's /tagged/ pages and search uses the search page. Shopify cannot sort blogs, so
  every article is rendered here and assets/blog-filters.js sorts them and reveals them
  in batches. The article shown by the featured-article section is left out of the grid.
  @example
  <!-- Blog template > Blog posts -->
{% endcomment %}

<script
  src="{{ 'blog-filters.js' | asset_url }}"
  type="module"
  fetchpriority="low"
></script>

{% render 'listing-toolbar-styles' %}

{% render 'contrast-override',
  background_color: section.settings.background_color,
  border_color: section.settings.border_color,
  section_id: section.id
%}

<div class="section-background color-custom-{{ section.id }}"></div>
<div
  class="section section--page-width spacing-style color-custom-{{ section.id }}"
  style="{% render 'spacing-padding', settings: section.settings %}"
>
  {% paginate blog.articles by 250 %}
    {% liquid
      assign per_page = section.settings.articles_per_page
      assign total = paginate.items
      assign featured_id = 0

      # Same choice as the featured-article section, which hides itself on tag pages
      unless current_tags.size > 0
        assign featured_article = blog.metafields.custom.featured_article.value | default: blog.articles.first
        assign featured_id = featured_article.id
      endunless

      for article in blog.articles
        if article.id == featured_id
          assign total = total | minus: 1
          break
        endif
      endfor

      assign shown = per_page | at_most: total
      assign search_placeholder = section.settings.search_placeholder | escape
      if search_placeholder == blank
        assign search_placeholder = 'content.search_input_placeholder' | t
      endif
    %}

    <noscript>
      <style>
        .blog-filters__item[hidden] {
          display: block;
        }

        .blog-filters__sort,
        .blog-filters__pagination {
          display: none;
        }
      </style>
    </noscript>

    <blog-filters-component
      class="blog-filters"
      data-page-size="{{ per_page }}"
    >
      <div class="listing-toolbar">
        <p
          class="listing-toolbar__count"
          ref="count"
          aria-live="polite"
          data-template="{{ 'content.showing_range_html' | t: start: 1, end: '__END__', total: total | escape }}"
        >
          {% if total > 0 %}
            {{ 'content.showing_range_html' | t: start: 1, end: shown, total: total }}
          {% else %}
            {{ 'content.no_results_found' | t }}
          {% endif %}
        </p>

        {% if section.settings.show_tags and blog.all_tags.size > 0 %}
          <ul class="blog-filters__tags list-unstyled">
            {% for tag in blog.all_tags %}
              {% liquid
                assign tag_handle = tag | handleize
                assign tag_url = blog.url | append: '/tagged/' | append: tag_handle
                assign tag_active = false
                if current_tags contains tag
                  assign tag_active = true
                  assign tag_url = blog.url
                endif
              %}
              <li>
                <a
                  href="{{ tag_url }}"
                  class="listing-toolbar__pill blog-filters__tag"
                  {% if tag_active %}
                    aria-current="true"
                  {% endif %}
                >
                  {{- tag | replace: '-', ' ' | escape -}}
                </a>
              </li>
            {% endfor %}
          </ul>
        {% endif %}

        {% if section.settings.show_sort %}
          <div class="listing-toolbar__sort blog-filters__sort">
            <label
              for="BlogSort-{{ section.id }}"
              class="listing-toolbar__sort-label"
            >
              {{- 'content.sort_by' | t -}}
            </label>
            <div class="listing-toolbar__select-wrapper">
              <select
                id="BlogSort-{{ section.id }}"
                class="listing-toolbar__select"
                on:change="/handleSortChange"
              >
                <option value="recent">{{ 'content.sort_recent' | t }}</option>
                <option value="oldest">{{ 'content.sort_oldest' | t }}</option>
                <option value="title">{{ 'content.sort_title' | t }}</option>
              </select>
              <span
                class="svg-wrapper listing-toolbar__caret"
                aria-hidden="true"
              >
                {{- 'icon-caret.svg' | inline_asset_content -}}
              </span>
            </div>
          </div>
        {% endif %}

        {% if section.settings.show_search %}
          <form
            action="{{ routes.search_url }}"
            class="blog-filters__search"
            role="search"
          >
            <input
              type="hidden"
              name="type"
              value="article"
            >
            <label
              for="BlogSearch-{{ section.id }}"
              class="visually-hidden"
            >
              {{- 'content.search_input_label' | t -}}
            </label>
            <span
              class="svg-wrapper blog-filters__search-icon"
              aria-hidden="true"
            >
              {{- 'icon-search.svg' | inline_asset_content -}}
            </span>
            <input
              id="BlogSearch-{{ section.id }}"
              class="blog-filters__search-input"
              type="search"
              name="q"
              placeholder="{{ search_placeholder }}"
              autocomplete="off"
            >
          </form>
        {% endif %}
      </div>

      {% if total > 0 %}
        {% if section.settings.heading != blank %}
          <h2 class="blog-filters__heading desktop:hidden">{{ section.settings.heading | escape }}</h2>
        {% endif %}

        <ul
          class="blog-filters__grid snap-carousel list-unstyled"
          style="--snap-carousel-columns: {{ section.settings.columns }}; --snap-carousel-mobile-width: 72%;"
          ref="grid"
        >
          {% assign rendered = 0 %}
          {% for article in blog.articles %}
            {% unless article.id == featured_id %}
              {% assign rendered = rendered | plus: 1 %}
              <li
                class="blog-filters__item"
                data-published="{{ article.published_at | date: '%s' }}"
                data-title="{{ article.title | escape }}"
                {% if rendered > per_page %}
                  hidden
                {% endif %}
              >
                {% render 'article-card', article: article %}
              </li>
            {% endunless %}
          {% endfor %}
        </ul>

        {% if total > per_page %}
          <div
            class="listing-pagination blog-filters__pagination"
            ref="pagination"
          >
            <div
              class="listing-pagination__bar"
              aria-hidden="true"
            >
              <span
                class="listing-pagination__bar-fill"
                style="width: {{ shown | times: 100 | divided_by: total }}%;"
                ref="progressBar"
              ></span>
            </div>
            <button
              type="button"
              class="listing-pagination__more blog-filters__more"
              on:click="/showMore"
            >
              {{- 'actions.load_more' | t -}}
            </button>
          </div>
        {% endif %}
      {% endif %}
    </blog-filters-component>
  {% endpaginate %}
</div>

{% stylesheet %}
  .blog-filters {
    display: flex;
    flex-direction: column;
    gap: var(--padding-xl);

    @media screen and (min-width: 750px) {
      gap: var(--padding-2xl);
    }
  }

  /* A card at every width, unlike the collection bar which is only one on desktop */
  .blog-filters .listing-toolbar {
    grid-template-columns: minmax(0, 1fr);
    gap: var(--gap-md);
    padding: var(--padding-lg);
    background-color: var(--color-background);
    border: var(--style-border-width) solid var(--color-border);
    border-radius: var(--style-border-radius-xs);

    @media screen and (min-width: 750px) {
      grid-template-columns: auto minmax(0, 1fr) auto auto;
      gap: var(--gap-lg);
    }
  }

  .blog-filters__tags {
    display: flex;
    flex-wrap: wrap;
    gap: var(--gap-xs);
    margin: 0;

    @media screen and (min-width: 750px) {
      justify-content: center;
    }
  }

  .listing-toolbar__pill.blog-filters__tag {
    min-height: 1.75rem;
    padding: var(--padding-3xs) var(--padding-sm);
    font-size: var(--font-size--3xs);
    letter-spacing: var(--letter-spacing-sm);
    text-transform: uppercase;
    border-radius: 999px;
  }

  .blog-filters__search {
    position: relative;
    display: flex;
    align-items: center;
    min-width: 0;
  }

  .blog-filters__search-icon {
    position: absolute;
    inset-inline-start: var(--padding-xs);
    width: var(--icon-size-sm);
    height: var(--icon-size-sm);
    color: var(--color-foreground-muted);
    pointer-events: none;
  }

  .blog-filters__search-input {
    width: 100%;
    min-width: 0;
    padding-block: var(--padding-xs);
    padding-inline: calc(var(--padding-xs) + var(--icon-size-sm) + var(--padding-2xs)) var(--padding-xs);
    font-family: var(--font-body--family);
    font-size: var(--font-size--xs);
    color: var(--color-input-text);
    background-color: var(--color-input-background);
    border: var(--style-border-width-inputs) solid var(--color-input-border);
    border-radius: var(--style-border-radius-inputs);

    &::placeholder {
      color: rgb(var(--color-input-text-rgb) / var(--opacity-50));
    }

    &::-webkit-search-cancel-button {
      display: none;
    }

    @media screen and (min-width: 750px) {
      width: 9.5rem;
    }
  }

  .blog-filters__heading {
    margin: 0;
    font-family: var(--font-body--family);
    font-weight: var(--font-body--weight);
    font-size: var(--font-size--2xs);
    letter-spacing: var(--letter-spacing-sm);
    text-transform: uppercase;
    color: var(--color-foreground-muted);
  }

  .blog-filters__more {
    max-width: 16rem;
    font-family: var(--font-body--family);
    background: none;
    cursor: pointer;

    @media screen and (max-width: 749px) {
      max-width: none;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:names.blog_posts",
  "enabled_on": {
    "templates": ["blog"]
  },
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "t:settings.heading",
      "info": "t:info.blog_filters_heading"
    },
    {
      "type": "range",
      "id": "articles_per_page",
      "label": "t:settings.articles_per_page",
      "min": 3,
      "max": 24,
      "step": 1,
      "default": 6
    },
    {
      "type": "range",
      "id": "columns",
      "label": "t:settings.columns",
      "min": 2,
      "max": 4,
      "step": 1,
      "default": 3
    },
    {
      "type": "header",
      "content": "t:names.filters"
    },
    {
      "type": "checkbox",
      "id": "show_tags",
      "label": "t:settings.enable_filtering",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_sort",
      "label": "t:settings.enable_sorting",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_search",
      "label": "t:settings.show_search",
      "default": true
    },
    {
      "type": "text",
      "id": "search_placeholder",
      "label": "t:settings.placeholder",
      "visible_if": "{{ section.settings.show_search }}"
    },
    {
      "type": "header",
      "content": "t:content.appearance"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "t:settings.background_color",
      "default": "{{ settings.color_palette.background }}"
    },
    {
      "type": "color",
      "id": "border_color",
      "label": "t:settings.border_color",
      "default": "{{ settings.color_palette.color2 }}"
    },
    {
      "type": "header",
      "content": "t:content.padding"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "t:settings.top",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "t:settings.bottom",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 48
    }
  ]
}
{% endschema %}
