{% comment %}
  Section contract.
  Row of unique selling points (icon, title, short text) in a bordered grid:
  one row on desktop, two columns on mobile.
  @example
  <!-- Homepage > Add section > USP bar; add up to four USP items -->
{% endcomment %}

{% render 'contrast-override',
  background_color: section.settings.background_color,
  border_color: section.settings.border_color,
  section_id: section.id
%}

<div class="section-background color-custom-{{ section.id }}"></div>
<div
  class="usp-bar section section--{{ section.settings.section_width }} spacing-style color-custom-{{ section.id }}"
  style="{% render 'spacing-padding', settings: section.settings %}"
>
  <ul
    class="usp-bar__list list-unstyled"
    style="--usp-bar-columns: {{ section.blocks.size | at_least: 1 | at_most: 4 }};"
  >
    {% content_for 'blocks' %}
  </ul>
</div>

{% stylesheet %}
  .usp-bar__list {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--style-border-width);
    margin: 0;
    overflow: hidden;
    background-color: var(--color-border);
    border: var(--style-border-width) solid var(--color-border);
    border-radius: var(--style-border-radius-xs);

    @media screen and (min-width: 750px) {
      grid-template-columns: repeat(var(--usp-bar-columns), minmax(0, 1fr));
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:names.usp_bar",
  "blocks": [
    {
      "type": "_usp-item"
    }
  ],
  "max_blocks": 4,
  "settings": [
    {
      "type": "select",
      "id": "section_width",
      "label": "t:settings.section_width",
      "options": [
        {
          "value": "page-width",
          "label": "t:options.page"
        },
        {
          "value": "full-width",
          "label": "t:options.full"
        }
      ],
      "default": "page-width"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "t:settings.background_color",
      "default": "{{ settings.color_palette.background }}"
    },
    {
      "type": "color",
      "id": "border_color",
      "label": "t:settings.border_color",
      "placeholder": "t:settings.default"
    },
    {
      "type": "header",
      "content": "t:content.padding"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "t:settings.top",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 24
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "t:settings.bottom",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 24
    }
  ],
  "presets": [
    {
      "name": "t:names.usp_bar",
      "blocks": {
        "usp_shipping": {
          "type": "_usp-item",
          "settings": {
            "icon": "truck",
            "title": "Free shipping over €75",
            "text": "Dispatched within 24 hours"
          }
        },
        "usp_returns": {
          "type": "_usp-item",
          "settings": {
            "icon": "return",
            "title": "30-day free returns",
            "text": "Prepaid label in every order"
          }
        },
        "usp_repair": {
          "type": "_usp-item",
          "settings": {
            "icon": "tools",
            "title": "5-year repair guarantee",
            "text": "Parts kept in stock, always"
          }
        },
        "usp_payment": {
          "type": "_usp-item",
          "settings": {
            "icon": "shield",
            "title": "Secure payment",
            "text": "iDEAL · Visa · PayPal · Klarna"
          }
        }
      },
      "block_order": ["usp_shipping", "usp_returns", "usp_repair", "usp_payment"]
    }
  ]
}
{% endschema %}
